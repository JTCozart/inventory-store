@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 mb-0">Dashboard</h1>
    <div class="d-flex gap-2 align-items-center">
        <div class="input-group input-group-sm" style="width:220px">
            <input type="text" id="quick-sku" class="form-control" placeholder="Enter SKU / scan" />
            <button class="btn btn-outline-secondary" onclick="openScannerModal(document.getElementById('quick-sku').value)">
                <i class="bi bi-search"></i>
            </button>
        </div>
        <button class="btn btn-sm btn-primary" onclick="openScannerModal(null)" title="Scan barcode">
            <i class="bi bi-upc-scan me-1"></i> Scan
        </button>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3 col-xl-2">
        <div class="stat-card border-start border-primary border-4">
            <div class="stat-icon text-primary"><i class="bi bi-boxes"></i></div>
            <div><div class="stat-value">@Model.Summary.TotalItems</div><div class="stat-label">Items</div></div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="stat-card border-start border-success border-4">
            <div class="stat-icon text-success"><i class="bi bi-stack"></i></div>
            <div><div class="stat-value">@Model.Summary.TotalQuantity</div><div class="stat-label">In Stock</div></div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="stat-card border-start border-warning border-4">
            <div class="stat-icon text-warning"><i class="bi bi-exclamation-triangle"></i></div>
            <div><div class="stat-value">@Model.Summary.LowStockCount</div><div class="stat-label">Low Stock</div></div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="stat-card border-start border-info border-4">
            <div class="stat-icon text-info"><i class="bi bi-box-arrow-up-right"></i></div>
            <div><div class="stat-value">@Model.Summary.CheckedOutCount</div><div class="stat-label">Checked Out</div></div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex align-items-center flex-wrap gap-2">
        <i class="bi bi-box-arrow-up-right text-success me-1"></i>
        <strong>Available to Checkout</strong>
        <span id="avail-count-badge" class="badge bg-success ms-1 d-none"></span>
        <div class="ms-auto input-group input-group-sm" style="max-width:240px">
            <input type="text" id="avail-filter" class="form-control" placeholder="Filter by name or category…" oninput="filterAvailItems()" />
            <button class="btn btn-outline-secondary" onclick="filterAvailItems()"><i class="bi bi-search"></i></button>
        </div>
    </div>
    <div class="card-body p-0">
        <div id="avail-loading" class="text-muted p-3 small"><span class="spinner-border spinner-border-sm me-2"></span>Loading…</div>
        <div id="avail-error" class="d-none text-danger p-3 small"><i class="bi bi-exclamation-circle me-1"></i>Could not load items.</div>
        <div id="avail-empty" class="d-none p-3 small d-flex align-items-center gap-2 flex-wrap">
            <span class="text-muted"><i class="bi bi-inbox me-1"></i>No reusable items match the filter.</span>
            @if (Model.CanManage)
            {
                <button class="btn btn-sm btn-outline-primary" onclick="openScannerModal(document.getElementById('avail-filter').value.trim() || null)">
                    <i class="bi bi-plus-lg me-1"></i> Add Item
                </button>
            }
        </div>
        <div id="avail-results" class="d-none">
            <table class="table table-sm mb-0">
                <thead class="table-light"><tr><th>Item</th><th>Category</th><th class="text-end">Available</th><th></th></tr></thead>
                <tbody id="avail-tbody"></tbody>
            </table>
            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-top small text-muted">
                <span id="avail-range-label"></span>
                <div class="d-flex align-items-center gap-1">
                    <select id="avail-page-size" class="form-select form-select-sm py-0" style="width:auto" onchange="changeAvailPageSize(this.value)">
                        <option value="5" selected>5 / page</option>
                        <option value="10">10 / page</option>
                        <option value="50">50 / page</option>
                        <option value="100">100 / page</option>
                    </select>
                    <button id="avail-prev" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="changeAvailPage(-1)">&#8249;</button>
                    <span id="avail-page-label" class="px-1"></span>
                    <button id="avail-next" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="changeAvailPage(1)">&#8250;</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                <strong>Low Stock</strong>
                @if (Model.Summary.LowStockCount > 0)
                {
                    <span class="badge bg-warning text-dark ms-2">@Model.Summary.LowStockCount</span>
                }
                <a href="/Reports?tab=stock" class="ms-auto btn btn-sm btn-outline-secondary">View report</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.Summary.LowStockItems.Any())
                {
                    <p class="text-muted p-3 mb-0 small"><i class="bi bi-check-circle me-1"></i>All stock levels OK.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>Item</th><th class="text-end">Avail</th><th class="text-end">Min</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.Summary.LowStockItems)
                            {
                                <tr>
                                    <td>
                                        <button type="button" onclick="openItemModal(@item.Id)" class="btn btn-link p-0 fw-semibold text-start text-decoration-none">@item.Name</button>
                                        @if (!string.IsNullOrEmpty(item.Location))
                                        {
                                            <div class="text-muted" style="font-size:0.75rem">@item.Location</div>
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-danger">@item.AvailableQuantity</td>
                                    <td class="text-end text-muted">@item.MinimumQuantity</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center">
                <i class="bi bi-box-arrow-up-right text-info me-2"></i>
                <strong>Checked Out</strong>
                @if (Model.Summary.CheckedOutCount > 0)
                {
                    <span class="badge bg-info text-dark ms-2">@Model.Summary.CheckedOutCount</span>
                }
                <a href="/Reports?tab=checkout" class="ms-auto btn btn-sm btn-outline-secondary">View report</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.Summary.CheckedOutItems.Any())
                {
                    <p class="text-muted p-3 mb-0 small"><i class="bi bi-check-circle me-1"></i>No items currently checked out.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>Item</th><th>With</th><th class="text-end">Qty</th><th class="text-end">Days <span class="text-muted fw-normal" title="Rows highlighted yellow are overdue (>7 days)" style="font-size:.75rem">ⓘ</span></th></tr></thead>
                        <tbody>
                            @foreach (var row in Model.Summary.CheckedOutItems)
                            {
                                <tr class="@(row.DaysOut > 7 ? "table-warning" : string.Empty)">
                                    <td>
                                        <button type="button" onclick="openItemModal(@row.InventoryItemId)" class="btn btn-link p-0 fw-semibold text-start text-decoration-none">@row.ItemName</button>
                                        @if (!string.IsNullOrEmpty(row.ItemLocation))
                                        {
                                            <div class="text-muted" style="font-size:0.75rem">@row.ItemLocation</div>
                                        }
                                    </td>
                                    <td class="small">@row.CheckedOutBy</td>
                                    <td class="text-end">@row.Quantity</td>
                                    <td class="text-end @(row.DaysOut > 7 ? "text-warning fw-bold" : "text-muted")">@row.DaysOut</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center">
                <i class="bi bi-x-circle-fill text-danger me-2"></i>
                <strong>Lost Items</strong>
                @if (Model.Summary.LostItemCount > 0)
                {
                    <span class="badge bg-danger ms-2">@Model.Summary.LostItemCount</span>
                }
                <a href="/Reports?tab=lost" class="ms-auto btn btn-sm btn-outline-secondary">View report</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.Summary.LostItems.Any())
                {
                    <p class="text-muted p-3 mb-0 small"><i class="bi bi-check-circle me-1"></i>No lost items recorded.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>Item</th><th>Last With</th><th class="text-end">Qty</th><th>Date</th></tr></thead>
                        <tbody>
                            @foreach (var row in Model.Summary.LostItems)
                            {
                                <tr>
                                    <td>
                                        <button type="button" onclick="openItemModal(@row.InventoryItemId)" class="btn btn-link p-0 fw-semibold text-start text-decoration-none">@row.ItemName</button>
                                        @if (!string.IsNullOrEmpty(row.ItemLocation))
                                        {
                                            <div class="text-muted" style="font-size:0.75rem">@row.ItemLocation</div>
                                        }
                                    </td>
                                    <td class="small">@row.LastCheckedOutBy</td>
                                    <td class="text-end text-danger fw-bold">@row.Quantity</td>
                                    <td class="small text-muted text-nowrap">@row.LostAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center">
                <i class="bi bi-activity me-2"></i>
                <strong>Recent Activity</strong>
                <a href="/Reports?tab=activity" class="ms-auto btn btn-sm btn-outline-secondary">Full log</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.Summary.RecentActivity.Any())
                {
                    <p class="text-muted p-3 mb-0">No activity recorded yet.</p>
                }
                else
                {
                    <div class="activity-list">
                        @foreach (var log in Model.Summary.RecentActivity)
                        {
                            <div class="activity-item d-flex align-items-start px-3 py-2 border-bottom">
                                <i class="bi bi-dot fs-4 text-primary me-1 mt-n1"></i>
                                <div class="flex-grow-1 small">
                                    <span class="fw-semibold">@log.Username</span>
                                    <span class="text-muted">: @log.Details</span>
                                    <div class="text-muted" style="font-size:0.75rem">@log.Timestamp.ToLocalTime().ToString("MMM d, h:mm tt")</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// ── Available to Checkout (paginated) ────────────────────────────────────
var availAllItems = [];
var availFilterStr = '';
var availPage = 1;
var availPageSize = 5;

function loadAvailableItems() {
    showAvailState('loading');
    fetch('/api/inventory/available', { credentials: 'include' })
        .then(function (r) { return r.json(); })
        .then(function (items) {
            availAllItems = items || [];
            var badge = document.getElementById('avail-count-badge');
            if (badge) {
                badge.textContent = availAllItems.length;
                badge.classList.toggle('d-none', availAllItems.length === 0);
            }
            renderAvailItems();
        })
        .catch(function () { showAvailState('error'); });
}

window.filterAvailItems = function () {
    availFilterStr = (document.getElementById('avail-filter').value || '').trim().toLowerCase();
    availPage = 1;
    renderAvailItems();
};

window.changeAvailPageSize = function (val) {
    availPageSize = parseInt(val) || 5;
    availPage = 1;
    renderAvailItems();
};

window.changeAvailPage = function (delta) {
    availPage += delta;
    renderAvailItems();
};

function renderAvailItems() {
    var filtered = availAllItems.filter(function (item) {
        if (!availFilterStr) return true;
        return (item.name && item.name.toLowerCase().indexOf(availFilterStr) >= 0) ||
               (item.categoryName && item.categoryName.toLowerCase().indexOf(availFilterStr) >= 0) ||
               (item.location && item.location.toLowerCase().indexOf(availFilterStr) >= 0);
    });
    var total = filtered.length;
    var totalPages = Math.max(1, Math.ceil(total / availPageSize));
    availPage = Math.min(Math.max(1, availPage), totalPages);
    if (total === 0) { showAvailState('empty'); return; }
    var start = (availPage - 1) * availPageSize;
    var end = Math.min(start + availPageSize, total);
    var pageItems = filtered.slice(start, end);
    var tbody = document.getElementById('avail-tbody');
    tbody.innerHTML = pageItems.map(function (item) {
        var cat = item.categoryName
            ? '<span class="badge" style="background:' + escHtml(item.categoryColor || '#6c757d') + '">' + escHtml(item.categoryName) + '</span>'
            : '<span class="text-muted">—</span>';
        var avClass = item.availableQuantity > 0 ? 'text-success' : 'text-muted';
        var disabled = item.availableQuantity <= 0 ? ' disabled' : '';
        return '<tr>' +
            '<td class="py-1"><span class="fw-semibold">' + escHtml(item.name) + '</span>' +
            (item.location ? '<div class="text-muted" style="font-size:.75rem">' + escHtml(item.location) + '</div>' : '') +
            '</td><td class="py-1 small">' + cat + '</td>' +
            '<td class="py-1 text-end fw-bold ' + avClass + '">' + item.availableQuantity + '</td>' +
            '<td class="py-1 text-end"><button class="btn btn-sm btn-outline-success py-0 px-2"' + disabled + ' onclick="lookupById(' + item.id + ')">Checkout</button></td>' +
            '</tr>';
    }).join('');
    document.getElementById('avail-range-label').textContent = 'Showing ' + (start + 1) + '–' + end + ' of ' + total;
    document.getElementById('avail-page-label').textContent = availPage + ' / ' + totalPages;
    document.getElementById('avail-prev').disabled = availPage <= 1;
    document.getElementById('avail-next').disabled = availPage >= totalPages;
    showAvailState('results');
}

function showAvailState(state) {
    ['loading', 'error', 'empty', 'results'].forEach(function (s) {
        var el = document.getElementById('avail-' + s);
        if (el) el.classList.toggle('d-none', s !== state);
    });
}

document.addEventListener('DOMContentLoaded', function () { loadAvailableItems(); });

function escHtml(s) {
    return s == null ? '' : String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

if (new URLSearchParams(location.search).get('scan') === '1') {
    window.addEventListener('load', function () { openScannerModal(null); });
}
</script>
}


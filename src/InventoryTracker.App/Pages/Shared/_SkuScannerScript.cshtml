<script>
function initSkuScanner(skuInputId, scanBtnId, cancelBtnId, areaId,
                        viewportId, videoId, captureId, hintId) {
    var skuInput     = document.getElementById(skuInputId);
    var scanBtn      = document.getElementById(scanBtnId);
    var cancelBtn    = document.getElementById(cancelBtnId);
    var area         = document.getElementById(areaId);
    var viewport     = document.getElementById(viewportId);
    var videoEl      = document.getElementById(videoId);
    var captureInput = document.getElementById(captureId);
    var hintEl       = document.getElementById(hintId);
    var zxingReader  = null;
    var DISPLAY_H    = 180;

    scanBtn.addEventListener('click', function () {
        if (zxingReader) { stopLive(); return; }
        if (window.isSecureContext) { startLive(); }
        else { captureInput.value = ''; captureInput.click(); }
    });

    cancelBtn && cancelBtn.addEventListener('click', stopLive);

    // ── Photo capture (HTTP) ─────────────────────────────────────────────
    captureInput.addEventListener('change', function () {
        var file = captureInput.files[0];
        captureInput.value = '';
        if (!file) return;
        area.classList.remove('d-none');
        if (hintEl) hintEl.textContent = 'Reading barcode…';
        scanBtn.disabled = true;
        var url = URL.createObjectURL(file);
        new ZXing.BrowserMultiFormatReader(new Map([[ZXing.DecodeHintType.TRY_HARDER, true]]))
            .decodeFromImageUrl(url)
            .then(function (result) {
                skuInput.value = result.getText();
                skuInput.dispatchEvent(new Event('input'));
                skuInput.focus();
                area.classList.add('d-none');
                if (hintEl) hintEl.textContent = '';
            })
            .catch(function () {
                area.classList.add('d-none');
                if (hintEl) hintEl.textContent = 'Could not read barcode — try again in better light.';
            })
            .finally(function () {
                URL.revokeObjectURL(url);
                scanBtn.disabled = false;
            });
    });

    // ── Live viewfinder (HTTPS) ──────────────────────────────────────────
    // CSS centres via top:50%;left:50%;translate(-50%,-50%) rotate(-90deg).
    // JS only sets width (=DISPLAY_H) and height (=container width).
    // After rotate(-90deg): visually fills container width × DISPLAY_H.

    function positionVideo() {
        var W = viewport.offsetWidth || 300;
        videoEl.style.width  = DISPLAY_H + 'px';
        videoEl.style.height = W + 'px';
        viewport.style.height = DISPLAY_H + 'px';
    }

    function startLive() {
        area.classList.remove('d-none');
        positionVideo();
        scanBtn.innerHTML = '<i class="bi bi-stop-circle"></i>';

        var hints = new Map();
        hints.set(ZXing.DecodeHintType.TRY_HARDER, true);
        zxingReader = new ZXing.BrowserMultiFormatReader(hints);

        navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: 'environment' } } })
            .then(function (tmpStream) {
                var track = tmpStream.getVideoTracks()[0];
                var deviceId = track ? track.getSettings().deviceId : null;
                tmpStream.getTracks().forEach(function (t) { t.stop(); });
                return zxingReader.decodeFromVideoDevice(
                    deviceId,
                    videoEl,
                    function (result, err) {
                        if (result) {
                            stopLive();
                            skuInput.value = result.getText();
                            skuInput.dispatchEvent(new Event('input'));
                            skuInput.focus();
                        }
                    }
                );
            })
            .catch(function (err) {
                stopLive();
                if (hintEl) hintEl.textContent = 'Camera unavailable: ' + (err.message || err);
            });
    }

    function stopLive() {
        scanBtn.innerHTML = '<i class="bi bi-upc-scan"></i>';
        if (zxingReader) {
            try { zxingReader.stopContinuousDecode(); } catch (e) {}
            try { zxingReader.reset(); } catch (e) {}
            zxingReader = null;
        }
        if (videoEl.srcObject) {
            videoEl.srcObject.getTracks().forEach(function (t) { t.stop(); });
            videoEl.srcObject = null;
        }
        area.classList.add('d-none');
    }
}
</script>

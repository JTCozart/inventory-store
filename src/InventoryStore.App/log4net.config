<log4net>
  <!-- The Cozart logging standard (GitHub folder, .claude/logging.md): rolled by size at 500 MB, UTC timestamps,
       one record per timestamped line. The PulseWatch agent parses this exact layout.
       COZART_LOG_DIR and COZART_LOG_SOURCE are set in code before logging starts (CentralLogging). -->
  <appender name="RollingFile" type="log4net.Appender.RollingFileAppender">
    <file value="${COZART_LOG_DIR}/${COZART_LOG_SOURCE}/${COZART_LOG_SOURCE}.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maximumFileSize value="500MB" />
    <maxSizeRollBackups value="2" />
    <staticLogFileName value="true" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%utcdate{yyyy-MM-dd'T'HH:mm:ss.fff'Z'} %-5level [%thread] %logger - %message%newline%exception" />
    </layout>
  </appender>

  <!-- Errors also go to the Windows Event Log (Application, source "InventoryStore") so
       failures like a broken Mailjet send show up somewhere an admin already monitors.
       Custom appender (App/Logging/WindowsEventLogAppender.cs) because log4net's own
       EventLogAppender isn't available on the netstandard build it ships for .NET 8.
       Not compiled into the Linux build; log4net logs that internally and the RollingFile
       appender keeps working regardless. -->
  <appender name="EventLog" type="InventoryStore.App.Logging.WindowsEventLogAppender, InventoryStore.App">
    <applicationName value="InventoryStore" />
    <logName value="Application" />
    <threshold value="ERROR" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss} %logger - %message%newline%exception" />
    </layout>
  </appender>

  <logger name="Microsoft"><level value="WARN" /></logger>
  <logger name="System"><level value="WARN" /></logger>
  <logger name="Microsoft.EntityFrameworkCore.Database.Command"><level value="WARN" /></logger>
  <root>
    <level value="INFO" />
    <appender-ref ref="RollingFile" />
    <appender-ref ref="EventLog" />
  </root>
</log4net>

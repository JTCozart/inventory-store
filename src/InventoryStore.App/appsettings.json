{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Reverse-proxy / SSL-offload deployment. Leave Port null for the standard
  // self-hosted setup (5050 HTTP, plus 80/443 when HTTPS is enabled in Settings).
  // Setting Port makes the app bind ONLY that port, as plain HTTP, and skip 80,
  // 443 and all certificate handling -- the proxy in front terminates TLS.
  // RedirectToTls sends plain-HTTP requests on to https:// using the proxy's
  // X-Forwarded-Proto. On Linux, set these as Environment=Proxy__Port=... lines
  // in the systemd unit instead.
  "Proxy": {
    "Enabled": false,
    "Port": null,
    "RedirectToTls": false,
    "TrustedProxies": ""
  },
  "AppVersion": "dev",
  "GitHub": {
    "Repository": "JTCozart/inventory-store"
  }
}

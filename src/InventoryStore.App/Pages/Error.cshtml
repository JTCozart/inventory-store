@page
@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
    var requestId = HttpContext.TraceIdentifier;
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle-fill display-1 text-danger"></i>
    <h1 class="mt-3">Something went wrong</h1>
    <p class="text-muted">An unexpected error occurred. Please try again or contact your administrator.</p>
    @if (!string.IsNullOrEmpty(requestId))
    {
        <p class="small text-muted">Request ID: <code>@requestId</code></p>
    }
    <a href="/" class="btn btn-primary mt-2">Go to Dashboard</a>
</div>

@page
@model LoginModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = Localizer["Login"];
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-body">
    <div class="card shadow-sm" style="width: 400px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <i class="bi bi-box-seam display-4 text-primary"></i>
                <h2 class="mt-2">Inventory Store</h2>
            </div>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success">@Model.SuccessMessage</div>
            }
            <div id="login-error" class="alert alert-danger d-none"></div>

            <form id="login-form" autocomplete="on">
                <input type="hidden" id="af-token" name="__RequestVerificationToken" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
                <input type="hidden" id="returnUrl" value="@Model.ReturnUrl" />
                <div class="mb-3">
                    <label for="username" class="form-label">@Localizer["Username"]</label>
                    <input id="username" name="username" class="form-control"
                           autocomplete="username" autofocus />
                </div>
                <div class="mb-4">
                    <label for="password" class="form-label">@Localizer["Password"]</label>
                    <input id="password" name="password" class="form-control"
                           type="password" autocomplete="current-password" />
                </div>
                <button id="login-btn" type="submit" class="btn btn-primary w-100">
                    @Localizer["Login"]
                </button>
            </form>
            @if (Model.ShowForgotPasswordLink)
            {
                <p class="text-center text-muted small mt-3 mb-0">
                    <a href="/Auth/ForgotPassword">@Localizer["ForgotPassword"]</a>
                </p>
            }
            else
            {
                <p class="text-center text-muted small mt-3 mb-0">
                    @Html.Raw(Localizer["ForgotPasswordTrayHelp"].Value)
                </p>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('login-form').addEventListener('submit', async function (e) {
    e.preventDefault();
    var btn = document.getElementById('login-btn');
    var errorEl = document.getElementById('login-error');
    var isPt = (window.APP_CULTURE || '').startsWith('pt');

    btn.disabled = true;
    btn.textContent = isPt ? 'Entrando…' : 'Signing in…';
    errorEl.classList.add('d-none');

    var body = new URLSearchParams({
        username: document.getElementById('username').value,
        password: document.getElementById('password').value,
        returnUrl: document.getElementById('returnUrl').value,
        __RequestVerificationToken: document.getElementById('af-token').value
    });

    try {
        var response = await fetch('/Auth/Login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString(),
            credentials: 'include'
        });

        if (response.ok) {
            var data = await response.json().catch(function () { return {}; });
            window.location.href = data.redirect || '/';
        } else {
            var msg = await response.text();
            if (msg.indexOf('Username and password are required') !== -1) {
                msg = isPt ? 'Usuário e senha são obrigatórios.' : msg;
            } else if (msg.indexOf('Invalid username or password') !== -1) {
                msg = isPt ? 'Usuário ou senha inválidos.' : msg;
            }
            errorEl.textContent = msg || (isPt ? 'Falha no login. Verifique suas credenciais.' : 'Login failed. Please try again.');
            errorEl.classList.remove('d-none');
            btn.disabled = false;
            btn.textContent = isPt ? 'Entrar' : 'Sign In';
        }
    } catch (err) {
        errorEl.textContent = isPt ? 'Erro de rede. Tente novamente.' : 'Network error. Please try again.';
        errorEl.classList.remove('d-none');
        btn.disabled = false;
        btn.textContent = isPt ? 'Entrar' : 'Sign In';
    }
});
</script>
}

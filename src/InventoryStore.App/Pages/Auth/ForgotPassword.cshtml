@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-body">
    <div class="card shadow-sm" style="width: 400px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <i class="bi bi-box-seam display-4 text-primary"></i>
                <h2 class="mt-2">Inventory Store</h2>
            </div>

            @if (Model.Submitted)
            {
                <div class="alert alert-success">
                    If that account exists and has an email on file, we've sent a password reset link to it.
                </div>
                <p class="text-center mb-0"><a href="/Auth/Login">Back to sign in</a></p>
            }
            else
            {
                <p class="text-muted small mb-3">Enter your username or email and we'll email you a link to reset your password.</p>
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Input.UsernameOrEmail" class="form-label">Username or email</label>
                        <input asp-for="Input.UsernameOrEmail" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Input.UsernameOrEmail" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Send reset link</button>
                </form>
                <p class="text-center text-muted small mt-3 mb-0"><a href="/Auth/Login">Back to sign in</a></p>
            }
        </div>
    </div>
</div>

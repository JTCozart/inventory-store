@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = Localizer["ForgotPassword"];
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-body">
    <div class="card shadow-sm" style="width: 400px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <i class="bi bi-box-seam display-4 text-primary"></i>
                <h2 class="mt-2">Inventory Store</h2>
            </div>

            @if (Model.Submitted)
            {
                <div class="alert alert-success">
                    @Localizer["ResetLinkSent"]
                </div>
                <p class="text-center mb-0"><a href="/Auth/Login">@Localizer["BackToSignIn"]</a></p>
            }
            else
            {
                <p class="text-muted small mb-3">@Localizer["EnterUsernameOrEmailHelp"]</p>
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Input.UsernameOrEmail" class="form-label">@Localizer["UsernameOrEmail"]</label>
                        <input asp-for="Input.UsernameOrEmail" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Input.UsernameOrEmail" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">@Localizer["SendResetLink"]</button>
                </form>
                <p class="text-center text-muted small mt-3 mb-0"><a href="/Auth/Login">@Localizer["BackToSignIn"]</a></p>
            }
        </div>
    </div>
</div>

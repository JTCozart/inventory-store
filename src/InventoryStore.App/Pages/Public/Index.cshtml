@page
@model InventoryStore.App.Pages.Public.IndexModel
@using InventoryStore.Domain.Enums
@{
    Layout = null;
    var byCategory = Model.Items
        .GroupBy(i => i.CategoryName ?? "")
        .OrderBy(g => g.Key == "" ? 1 : 0).ThenBy(g => g.Key)
        .ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Inventory – Public View</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <style>
    body { font-size: 14px; background: #f8fafc; }
    .pub-header {
      background: #1e2530; color: #fff;
      padding: .65rem 1.25rem;
      display: flex; align-items: center; justify-content: space-between;
      gap: .75rem;
    }
    .pub-brand { font-weight: 700; font-size: .95rem; display: flex; align-items: center; gap: .5rem; }
    .pub-badge-box {
      width: 26px; height: 26px; border-radius: 6px; background: #2563eb;
      display: inline-flex; align-items: center; justify-content: center;
      font-size: .7rem; font-weight: 800; color: #fff; flex-shrink: 0;
    }
    .pub-updated { font-size: .75rem; color: #94a3b8; }
    .category-label {
      font-size: .7rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: .06em; color: #64748b; padding: .4rem .75rem .2rem;
    }
    .item-row { padding: .55rem .75rem; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: .6rem; }
    .item-row:last-child { border-bottom: none; }
    .item-name { font-weight: 600; flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .item-location { font-size: .75rem; color: #94a3b8; }
    .qty-pill {
      font-size: .75rem; font-weight: 700; padding: .2rem .55rem;
      border-radius: 99px; white-space: nowrap; flex-shrink: 0;
    }
    .qty-ok   { background: #dcfce7; color: #166534; }
    .qty-low  { background: #fef9c3; color: #854d0e; }
    .qty-zero { background: #fee2e2; color: #991b1b; }
    .type-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .type-reusable   { background: #2563eb; }
    .type-consumable { background: #16a34a; }
    .cat-swatch { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .pub-footer { font-size: .7rem; color: #94a3b8; text-align: center; padding: .6rem; }
    .pub-footer a { color: #94a3b8; }
    .disabled-msg {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      min-height: 200px; text-align: center; color: #64748b; padding: 2rem;
    }
    .section-card { background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; margin: .75rem; overflow: hidden; }
  </style>
</head>
<body>

<div class="pub-header">
  <div class="pub-brand">
    <span class="pub-badge-box">IS</span>
    Inventory Store
  </div>
  <span class="pub-updated">Updated @DateTime.Now.ToString("MMM d, h:mm tt")</span>
</div>

@if (!Model.IsEnabled)
{
  <div class="disabled-msg">
    <i class="bi bi-eye-slash fs-1 mb-2 opacity-25"></i>
    <div class="fw-semibold">Public view is not enabled.</div>
    <div class="small mt-1">An administrator can enable it in Settings.</div>
  </div>
}
else if (!Model.Items.Any())
{
  <div class="disabled-msg">
    <i class="bi bi-boxes fs-1 mb-2 opacity-25"></i>
    <div class="fw-semibold">No items are marked as public yet.</div>
    <div class="small mt-1">An administrator can select items in Settings &rarr; Public View.</div>
  </div>
}
else
{
  @foreach (var group in byCategory)
  {
    <div class="section-card">
      <div class="category-label d-flex align-items-center gap-1">
        @if (!string.IsNullOrEmpty(group.Key))
        {
          @if (!string.IsNullOrEmpty(group.First().CategoryColor))
          {
            <span class="cat-swatch" style="background:@group.First().CategoryColor"></span>
          }
          @group.Key
        }
        else
        {
          <span style="color:#cbd5e1">Uncategorized</span>
        }
      </div>
      @foreach (var item in group)
      {
        var qtyClass = item.AvailableQuantity == 0 ? "qty-zero"
                     : item.IsLowStock        ? "qty-low"
                                              : "qty-ok";
        var qtyLabel = item.ItemType == ItemType.Reusable
            ? $"{item.AvailableQuantity} available"
            : $"{item.AvailableQuantity} in stock";
        <div class="item-row">
          <span class="type-dot @(item.ItemType == ItemType.Reusable ? "type-reusable" : "type-consumable")"
                title="@item.ItemType"></span>
          <div class="flex-grow-1 min-width-0">
            <div class="item-name" title="@item.Name">@item.Name</div>
            @if (!string.IsNullOrEmpty(item.Location))
            {
              <div class="item-location"><i class="bi bi-geo-alt"></i> @item.Location</div>
            }
          </div>
          <span class="qty-pill @qtyClass">@qtyLabel</span>
        </div>
      }
    </div>
  }

  <div id="pub-pager-bar" style="display:flex;align-items:center;justify-content:space-between;padding:.5rem .75rem;font-size:.75rem;color:#64748b;border-top:1px solid #e2e8f0;margin:.75rem;background:#fff;border-radius:6px;">
    <span id="pub-range"></span>
    <div style="display:flex;align-items:center;gap:.35rem;">
      <select id="pub-size" style="font-size:.75rem;padding:.15rem .3rem;border:1px solid #cbd5e1;border-radius:4px;background:#fff;" onchange="pubPgSz(this.value)">
        <option value="5">5 / page</option>
        <option value="10">10 / page</option>
        <option value="50" selected>50 / page</option>
        <option value="100">100 / page</option>
      </select>
      <button id="pub-prev" onclick="pubPgGo(-1)" style="border:1px solid #cbd5e1;background:#fff;border-radius:4px;padding:.1rem .45rem;cursor:pointer;font-size:.9rem;">&#8249;</button>
      <span id="pub-lbl" style="min-width:40px;text-align:center;"></span>
      <button id="pub-next" onclick="pubPgGo(1)"  style="border:1px solid #cbd5e1;background:#fff;border-radius:4px;padding:.1rem .45rem;cursor:pointer;font-size:.9rem;">&#8250;</button>
    </div>
  </div>

  <div class="pub-footer">
    <span class="me-1">@Model.Items.Count() item@(Model.Items.Count() == 1 ? "" : "s")</span>
    &middot;
    <span class="mx-1">
      <span class="type-dot type-reusable d-inline-block" style="width:7px;height:7px;border-radius:50%;vertical-align:middle"></span> Reusable
    </span>
    <span class="mx-1">
      <span class="type-dot type-consumable d-inline-block" style="width:7px;height:7px;border-radius:50%;vertical-align:middle"></span> Consumable
    </span>
  </div>
}

<script>
(function(){
  var _rows = Array.from(document.querySelectorAll('.item-row'));
  var _page = 1, _size = 50;
  if (!_rows.length) {
    var bar = document.getElementById('pub-pager-bar');
    if (bar) bar.style.display = 'none';
    return;
  }
  function draw() {
    var total = _rows.length;
    var pages = Math.max(1, Math.ceil(total / _size));
    _page = Math.min(Math.max(1, _page), pages);
    var s = (_page - 1) * _size, e = Math.min(s + _size, total);
    _rows.forEach(function(r,i){ r.style.display = (i >= s && i < e) ? '' : 'none'; });
    // Hide category cards that have no visible items
    document.querySelectorAll('.section-card').forEach(function(card){
      var any = Array.from(card.querySelectorAll('.item-row')).some(function(r){ return r.style.display !== 'none'; });
      card.style.display = any ? '' : 'none';
    });
    document.getElementById('pub-range').textContent = 'Showing ' + (s+1) + '–' + e + ' of ' + total;
    document.getElementById('pub-lbl').textContent = pages > 1 ? (_page + ' / ' + pages) : '';
    document.getElementById('pub-prev').disabled = _page <= 1;
    document.getElementById('pub-next').disabled = _page >= pages;
  }
  window.pubPgSz = function(v){ _size = parseInt(v)||10; _page = 1; draw(); };
  window.pubPgGo = function(d){ _page += d; draw(); };
  draw();
}());
</script>

</body>
</html>

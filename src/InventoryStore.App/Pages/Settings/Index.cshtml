                    <tbody id="locs-tbody">
                        @foreach (var loc in Model.Locations)
                        {
                            <tr>
                                <td class="fw-semibold">@loc.Name</td>
                                <td class="text-end text-muted">@loc.Count</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-1"
                                            onclick="openManageLocationModal('@loc.Name.Replace("'","\\'")')"
                                            title="Manage items">
                                        <i class="bi bi-list-ul"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary me-1"
                                            onclick="openRenameLocationModal('@loc.Name.Replace("'","\\'")')"
                                            title="Rename">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form method="post" asp-page-handler="ClearLocation" class="d-inline"
                                          onsubmit="return confirm('Remove location \'@loc.Name\' from all @loc.Count item(s)? They will have no location set.')">
                                        <input type="hidden" name="location" value="@loc.Name" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Clear from all items">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-top small text-muted" id="locs-pg-bar">
                <span id="locs-pg-range"></span>
                <div class="d-flex align-items-center gap-1">
                    <select class="form-select form-select-sm py-0" style="width:auto" onchange="pgSz('locs-pg',this.value)">
                        <option value="5">5 / page</option>
                        <option value="10" selected>10 / page</option>
                        <option value="50">50 / page</option>
                        <option value="100">100 / page</option>
                    </select>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" id="locs-pg-prev" onclick="pgGo('locs-pg',-1)">&#8249;</button>
                    <span class="px-1" id="locs-pg-lbl"></span>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" id="locs-pg-next" onclick="pgGo('locs-pg',1)">&#8250;</button>
                </div>
            </div>
        </div>
    }

    <div class="modal fade" id="addLocationModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Location</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Location Name <span class="text-danger">*</span></label>
                        <input type="text" id="add-loc-name" class="form-control" maxlength="200" placeholder="e.g. Shelf A3, Bin 12" />
                    </div>
                    <p class="text-muted small mb-0">After naming it, you will be taken to assign items to this location.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="confirmAddLocation()">Next</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="renameLocationModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Rename Location</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-page-handler="RenameLocation">
                    <div class="modal-body">
                        <input type="hidden" name="from" id="renameLocFrom" />
                        <div class="mb-3">
                            <label class="form-label">Current name</label>
                            <input id="renameLocFromDisplay" class="form-control" readonly />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">New name <span class="text-danger">*</span></label>
                            <input name="to" id="renameLocTo" class="form-control" required maxlength="200" />
                        </div>
                        <p class="text-muted small mb-0">All items currently at this location will be updated.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Rename</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="manageLocationModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Items at <span id="mgr-loc-name"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="mgr-loading" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                    <div id="mgr-content" class="d-none">
                        <h6 class="fw-semibold mb-2">Currently here</h6>
                        <div id="mgr-at-list" class="mb-4"></div>
                        <h6 class="fw-semibold mb-2">Add an item to this location</h6>
                        <div class="d-flex gap-2">
                            <select id="mgr-add-select" class="form-select form-select-sm"></select>
                            <button type="button" class="btn btn-sm btn-primary flex-shrink-0" onclick="mgrAddItem()">
                                <i class="bi bi-plus-lg me-1"></i>Add
                            </button>
                        </div>
                        <div id="mgr-error" class="text-danger small mt-2 d-none"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    var _mgrLocation = '';
    var _mgrModal = null;

    function confirmAddLocation() {
        var name = document.getElementById('add-loc-name').value.trim();
        if (!name) { document.getElementById('add-loc-name').focus(); return; }
        bootstrap.Modal.getInstance(document.getElementById('addLocationModal')).hide();
        document.getElementById('add-loc-name').value = '';
        openManageLocationModal(name);
    }

    function openRenameLocationModal(name) {
        document.getElementById('renameLocFrom').value = name;
        document.getElementById('renameLocFromDisplay').value = name;
        document.getElementById('renameLocTo').value = name;
        new bootstrap.Modal(document.getElementById('renameLocationModal')).show();
        setTimeout(() => document.getElementById('renameLocTo').select(), 300);
    }

    async function openManageLocationModal(name) {
        _mgrLocation = name;
        document.getElementById('mgr-loc-name').textContent = name;
        document.getElementById('mgr-loading').classList.remove('d-none');
        document.getElementById('mgr-content').classList.add('d-none');
        document.getElementById('mgr-error').classList.add('d-none');

        _mgrModal = _mgrModal || new bootstrap.Modal(document.getElementById('manageLocationModal'));
        _mgrModal.show();
        await mgrLoad();
    }

    async function mgrLoad() {
        try {
            var res = await fetch('/Settings?handler=LocationItemsJson&location=' + encodeURIComponent(_mgrLocation));
            var data = await res.json();
            renderMgrAtList(data.atLocation);
            renderMgrOthers(data.others);
            document.getElementById('mgr-loading').classList.add('d-none');
            document.getElementById('mgr-content').classList.remove('d-none');
        } catch {
            document.getElementById('mgr-loading').classList.add('d-none');
            document.getElementById('mgr-error').textContent = 'Failed to load items.';
            document.getElementById('mgr-error').classList.remove('d-none');
        }
    }

    function renderMgrAtList(items) {
        var el = document.getElementById('mgr-at-list');
        if (!items.length) {
            el.innerHTML = '<p class="text-muted small">No items at this location.</p>';
            return;
        }
        el.innerHTML = items.map(function (i) {
            return '<div class="d-flex justify-content-between align-items-center border rounded px-3 py-2 mb-1">' +
                '<div><span class="fw-semibold">' + esc(i.name) + '</span>' +
                (i.sku ? '<span class="text-muted small ms-2">' + esc(i.sku) + '</span>' : '') + '</div>' +
                '<button class="btn btn-sm btn-outline-danger" onclick="mgrRemoveItem(' + i.id + ')">Remove</button>' +
                '</div>';
        }).join('');
    }

    function renderMgrOthers(items) {
        var sel = document.getElementById('mgr-add-select');
        sel.innerHTML = items.length
            ? items.map(function (i) {
                var label = esc(i.name) + (i.sku ? ' (' + esc(i.sku) + ')' : '') + (i.location ? ' - ' + esc(i.location) : '');
                return '<option value="' + i.id + '">' + label + '</option>';
              }).join('')
            : '<option value="">All items are already at this location</option>';
        sel.disabled = !items.length;
    }

    async function mgrRemoveItem(itemId) {
        await mgrPost(itemId, '');
    }

    async function mgrAddItem() {
        var sel = document.getElementById('mgr-add-select');
        if (!sel.value) return;
        await mgrPost(parseInt(sel.value), _mgrLocation);
    }

    async function mgrPost(itemId, newLocation) {
        document.getElementById('mgr-error').classList.add('d-none');
        var token = document.getElementById('af-token').value;
        try {
            var res = await fetch('/Settings?handler=SetItemLocation', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: new URLSearchParams({ itemId: itemId, newLocation: newLocation, __RequestVerificationToken: token }).toString()
            });
            var data = await res.json();
            if (data.success) {
                await mgrLoad();
            } else {
                document.getElementById('mgr-error').textContent = data.error || 'Action failed.';
                document.getElementById('mgr-error').classList.remove('d-none');
            }
        } catch {
            document.getElementById('mgr-error').textContent = 'Network error.';
            document.getElementById('mgr-error').classList.remove('d-none');
        }
    }

    function esc(str) {
        return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    </script>
}

@if (Model.Tab == "publicview" && User.IsInRole("Admin"))

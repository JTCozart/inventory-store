document.querySelectorAll('.js-edit-user').forEach(function (btn) {
    btn.addEventListener('click', function () { openEditModal(btn); });
});

var _mgrCatId = null;
var _mgrCatModal = null;

async function openManageCategoryModal(id, name) {
    _mgrCatId = id;
    document.getElementById('mgr-cat-name').textContent = name;
    document.getElementById('mgr-cat-loading').classList.remove('d-none');
    document.getElementById('mgr-cat-content').classList.add('d-none');
    document.getElementById('mgr-cat-error').classList.add('d-none');

    _mgrCatModal = _mgrCatModal || new bootstrap.Modal(document.getElementById('manageCategoryModal'));
    _mgrCatModal.show();
    await mgrCatLoad();
}

async function mgrCatLoad() {
    try {
        var res = await fetch('/Settings?handler=CategoryItemsJson&categoryId=' + _mgrCatId);
        var data = await res.json();
        renderMgrCatInList(data.inCategory);
        renderMgrCatOthers(data.others);
        document.getElementById('mgr-cat-loading').classList.add('d-none');
        document.getElementById('mgr-cat-content').classList.remove('d-none');
    } catch {
        document.getElementById('mgr-cat-loading').classList.add('d-none');
        document.getElementById('mgr-cat-error').textContent = 'Failed to load items.';
        document.getElementById('mgr-cat-error').classList.remove('d-none');
    }
}

function renderMgrCatInList(items) {
    var el = document.getElementById('mgr-cat-in-list');
    if (!items.length) {
        el.innerHTML = '<p class="text-muted small">No items in this category.</p>';
        return;
    }
    el.innerHTML = items.map(function (i) {
        return '<div class="d-flex justify-content-between align-items-center border rounded px-3 py-2 mb-1">' +
            '<div><span class="fw-semibold">' + escHtml(i.name) + '</span>' +
            (i.sku ? '<span class="text-muted small ms-2">' + escHtml(i.sku) + '</span>' : '') + '</div>' +
            '<button class="btn btn-sm btn-outline-danger" onclick="mgrCatRemoveItem(' + i.id + ')">Remove</button>' +
            '</div>';
    }).join('');
}

function renderMgrCatOthers(items) {
    var sel = document.getElementById('mgr-cat-add-select');
    sel.innerHTML = items.length
        ? items.map(function (i) {
            var label = escHtml(i.name) + (i.sku ? ' (' + escHtml(i.sku) + ')' : '') + (i.category ? ' - ' + escHtml(i.category) : '');
            return '<option value="' + i.id + '">' + label + '</option>';
          }).join('')
        : '<option value="">All items are already in this category</option>';
    sel.disabled = !items.length;
}

async function mgrCatRemoveItem(itemId) {
    await mgrCatPost(itemId, 0);
}

async function mgrCatAddItem() {
    var sel = document.getElementById('mgr-cat-add-select');
    if (!sel.value) return;
    await mgrCatPost(parseInt(sel.value), _mgrCatId);
}

async function mgrCatPost(itemId, newCategoryId) {
    document.getElementById('mgr-cat-error').classList.add('d-none');
    var token = document.getElementById('af-token').value;
    try {
        var res = await fetch('/Settings?handler=SetItemCategory', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: new URLSearchParams({ itemId: itemId, newCategoryId: newCategoryId, __RequestVerificationToken: token }).toString()
        });
        var data = await res.json();
        if (data.success) {
            await mgrCatLoad();
        } else {
            document.getElementById('mgr-cat-error').textContent = data.error || 'Action failed.';
            document.getElementById('mgr-cat-error').classList.remove('d-none');
        }
    } catch {
        document.getElementById('mgr-cat-error').textContent = 'Network error.';
        document.getElementById('mgr-cat-error').classList.remove('d-none');
    }
}

function escHtml(str) {
    return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function openEditCategoryModal(id, name, color) {
    document.getElementById('editCatId').value = id;
    document.getElementById('editCatName').value = name;
    selectSwatch('editCatSwatches', 'editCatColor', color || '');
    new bootstrap.Modal(document.getElementById('editCategoryModal')).show();
}

function selectSwatch(containerId, inputId, color) {
    var container = document.getElementById(containerId);
    var input     = document.getElementById(inputId);
    if (!container || !input) return;
    input.value = color;
    container.querySelectorAll('.swatch-btn').forEach(function (btn) {
        var match = (btn.dataset.color || '') === (color || '');
        btn.style.border = match ? '2px solid #000' : '2px solid transparent';
        if (btn.dataset.color === '') btn.style.border = match ? '2px solid #000' : '2px solid #dee2e6';
    });
}

(function () {
    function initSwatches(containerId, inputId) {
        var container = document.getElementById(containerId);
        if (!container) return;
        container.querySelectorAll('.swatch-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                selectSwatch(containerId, inputId, btn.dataset.color || '');
            });
        });
    }
    initSwatches('addCatSwatches', 'addCatColor');
    initSwatches('editCatSwatches', 'editCatColor');
})();

// ── Tag manager ───────────────────────────────────────────────────────────────

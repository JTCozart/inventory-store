<script>
function copyEmbedCode(btn) {
    var input = document.getElementById('embed-code');
    if (!input) return;
    navigator.clipboard.writeText(input.value).then(function () {
        btn.innerHTML = '<i class="bi bi-check"></i> Copied';
        setTimeout(function () { btn.innerHTML = '<i class="bi bi-clipboard"></i>'; }, 2000);
    });
}

(function () {
    var afToken = document.getElementById('af-token');
    document.querySelectorAll('.public-item-toggle').forEach(function (chk) {
        chk.addEventListener('change', function () {
            var itemId   = chk.dataset.itemId;
            var isPublic = chk.checked;
            var fd = new FormData();
            fd.append('itemId',   itemId);
            fd.append('isPublic', isPublic);
            if (afToken) fd.append('__RequestVerificationToken', afToken.value);
            fetch('?handler=TogglePublicItem', { method: 'POST', body: fd, credentials: 'include' })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (!d.success) { chk.checked = !isPublic; }
                    var countEl = document.querySelector('.card-header .text-muted.small');
                    if (countEl) {
                        var checks = document.querySelectorAll('.public-item-toggle:checked').length;
                        var total  = document.querySelectorAll('.public-item-toggle').length;
                        countEl.textContent = checks + ' of ' + total + ' shown';
                    }
                })
                .catch(function () { chk.checked = !isPublic; });
        });
    });
})();
</script>

<script>
function checkForUpdates() {
    var btn    = document.getElementById('btn-check-updates');
    var result = document.getElementById('update-check-result');
    if (!btn) return;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Checking…';
    result.textContent = '';
    result.className = 'ms-2 small';
    fetch('/api/updates/check', { method: 'POST', credentials: 'include' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Check for Updates';
            if (d.hasUpdate) {
                result.innerHTML = '<a href="' + d.releaseUrl + '" target="_blank" class="badge bg-info text-decoration-none">v' + d.latestVersion + ' available</a>';
            } else {
                result.textContent = 'v' + d.currentVersion + ' is up to date.';
                result.className = 'ms-2 small text-muted';
            }
        })
        .catch(function () {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Check for Updates';
            result.textContent = 'Check failed — ensure internet access is available.';
            result.className = 'ms-2 small text-danger';
        });
}
</script>
}


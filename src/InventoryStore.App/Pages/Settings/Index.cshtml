async function mgrTagAddItem() {
    var sel = document.getElementById('mgr-tag-add-select');
    if (!sel.value) return;
    await mgrTagSetItem(parseInt(sel.value), true);
}

async function mgrTagSetItem(itemId, assigned) {
    document.getElementById('mgr-tag-error').classList.add('d-none');
    var token = document.getElementById('af-token').value;
    try {
        var res = await fetch('/Settings?handler=SetItemTag', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: new URLSearchParams({ itemId: itemId, tagId: _mgrTagId, assigned: assigned, __RequestVerificationToken: token }).toString()
        });
        var data = await res.json();
        if (data.success) {
            await mgrTagLoad();
        } else {
            document.getElementById('mgr-tag-error').textContent = data.error || 'Action failed.';
            document.getElementById('mgr-tag-error').classList.remove('d-none');
        }
    } catch {
        document.getElementById('mgr-tag-error').textContent = 'Network error.';
        document.getElementById('mgr-tag-error').classList.remove('d-none');

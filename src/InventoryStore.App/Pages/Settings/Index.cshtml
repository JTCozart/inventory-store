                                {
                                    <tr>
                                        <td>
                                            <div class="form-check form-switch mb-0">
                                                <input class="form-check-input public-item-toggle" type="checkbox"
                                                       role="switch"
                                                       data-item-id="@item.Id"
                                                       @(item.IsPublic ? "checked" : "")
                                                       title="Toggle public visibility" />
                                            </div>
                                        </td>
                                        <td class="fw-semibold">@item.Name</td>
                                        <td>
                                            <span class="badge @(item.ItemType == InventoryStore.Domain.Enums.ItemType.Reusable ? "bg-primary" : "bg-success") bg-opacity-75">
                                                @item.ItemType
                                            </span>
                                        </td>
                                        <td>

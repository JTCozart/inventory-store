}

function renderMgrTagOthers(items) {
    var sel = document.getElementById('mgr-tag-add-select');
    sel.innerHTML = items.length
        ? items.map(function (i) {
            return '<option value="' + i.id + '">' + escHtml(i.name) + (i.sku ? ' (' + escHtml(i.sku) + ')' : '') + '</option>';
          }).join('')

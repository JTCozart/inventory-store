@page
@model InventoryStore.App.Pages.Settings.IndexModel
@using InventoryStore.Domain.Enums
@using InventoryStore.App.Services
@inject InventoryStore.App.Services.UpdateInfo UpdateInfo
@{
    ViewData["Title"] = "Settings";
    ViewData["ActivePage"] = "Settings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Settings</h1>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<select class="form-select page-sidenav-select" onchange="location.href=this.value">
    <option value="/Settings?tab=account"  selected="@(Model.Tab=="account")">My Account</option>
    @if (User.IsInRole("Admin"))
    {
        <option value="/Settings?tab=users"      selected="@(Model.Tab=="users")">Users</option>
        <option value="/Settings?tab=network"     selected="@(Model.Tab=="network")">Network</option>
        <option value="/Settings?tab=publicview" selected="@(Model.Tab=="publicview")">Public View</option>
        <option value="/Settings?tab=database"       selected="@(Model.Tab=="database")">Database</option>
        <option value="/Settings?tab=notifications"  selected="@(Model.Tab=="notifications")">Notifications</option>
        <option value="/Settings?tab=modules"        selected="@(Model.Tab=="modules")">Modules</option>
    }
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <option value="/Settings?tab=categories" selected="@(Model.Tab=="categories")">Categories</option>
        <option value="/Settings?tab=tags"       selected="@(Model.Tab=="tags")">Tags</option>
        <option value="/Settings?tab=locations"  selected="@(Model.Tab=="locations")">Locations</option>
    }
    <option value="/Settings?tab=info" selected="@(Model.Tab=="info")">App Info</option>
</select>

<div class="page-layout">
<nav class="page-sidenav">
    <a href="/Settings?tab=account" class="nav-link @(Model.Tab == "account" ? "active" : "")">
        <i class="bi bi-person"></i> My Account
    </a>
    @if (User.IsInRole("Admin"))
    {
        <div class="page-sidenav-section">Admin</div>
        <a href="/Settings?tab=users" class="nav-link @(Model.Tab == "users" ? "active" : "")">
            <i class="bi bi-people"></i> Users
        </a>
        <a href="/Settings?tab=network" class="nav-link @(Model.Tab == "network" ? "active" : "")">
            <i class="bi bi-diagram-3"></i> Network
        </a>
        <a href="/Settings?tab=publicview" class="nav-link @(Model.Tab == "publicview" ? "active" : "")">
            <i class="bi bi-eye"></i> Public View
        </a>
        <a href="/Settings?tab=database" class="nav-link @(Model.Tab == "database" ? "active" : "")">
            <i class="bi bi-database"></i> Database
        </a>
        <a href="/Settings?tab=notifications" class="nav-link @(Model.Tab == "notifications" ? "active" : "")">
            <i class="bi bi-bell"></i> Notifications
        </a>
        <a href="/Settings?tab=modules" class="nav-link @(Model.Tab == "modules" ? "active" : "")">
            <i class="bi bi-puzzle"></i> Modules
        </a>
    }
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <div class="page-sidenav-section">Inventory</div>
        <a href="/Settings?tab=categories" class="nav-link @(Model.Tab == "categories" ? "active" : "")">
            <i class="bi bi-tags"></i> Categories
        </a>
        <a href="/Settings?tab=tags" class="nav-link @(Model.Tab == "tags" ? "active" : "")">
            <i class="bi bi-tag"></i> Tags
        </a>
        <a href="/Settings?tab=locations" class="nav-link @(Model.Tab == "locations" ? "active" : "")">
            <i class="bi bi-geo-alt"></i> Locations
        </a>
    }
    <div class="page-sidenav-section">About</div>
    <a href="/Settings?tab=info" class="nav-link @(Model.Tab == "info" ? "active" : "")">
        <i class="bi bi-info-circle"></i> App Info
    </a>
</nav>
<div class="page-content">

@if (Model.Tab == "account")
{
    <div class="row g-4" style="max-width: 520px;">
        <div class="col-12">
            <div class="card">
                <div class="card-header fw-semibold">Change Password</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="ChangePassword">
                        <div class="mb-3">
                            <label class="form-label">Current Password</label>
                            <input name="CurrentPassword" class="form-control" type="password" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <input name="NewPassword" class="form-control" type="password" minlength="8" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Confirm Password</label>
                            <input name="ConfirmPassword" class="form-control" type="password" required />
                        </div>
                        <button type="submit" class="btn btn-primary">Update Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.Tab == "users" && User.IsInRole("Admin"))
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">User Accounts</h5>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
            <i class="bi bi-person-plus me-1"></i> Add User
        </button>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Last Login</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr class="@(!user.IsActive ? "table-secondary text-muted" : "")">
                            <td>
                                <div class="fw-semibold">@user.DisplayName</div>
                                @if (user.DisplayName != user.Username)
                                {
                                    <div class="text-muted small">@user.Username</div>
                                }
                            </td>
                            <td class="small">@(user.Email ?? "—")</td>
                            <td>
                                <span class="badge @(user.Role == UserRole.Admin ? "bg-danger" : user.Role == UserRole.Manager ? "bg-warning text-dark" : user.Role == UserRole.Staff ? "bg-info text-dark" : "bg-secondary")">
                                    @user.Role
                                </span>
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Suspended</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @(user.LastLoginAt.HasValue ? user.LastLoginAt.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt") : "Never")
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary me-1 js-edit-user"
                                        data-id="@user.Id"
                                        data-username="@user.Username"
                                        data-firstname="@(user.FirstName ?? "")"
                                        data-lastname="@(user.LastName ?? "")"
                                        data-email="@(user.Email ?? "")"
                                        data-role="@((int)user.Role)"
                                        data-active="@user.IsActive.ToString().ToLower()"
                                        title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                @if (user.Id != Model.CurrentUserId)
                                {
                                    <form method="post" asp-page-handler="ToggleSuspend" class="d-inline me-1"
                                          onsubmit="return confirm('@(user.IsActive ? $"Suspend {user.Username}? They will be unable to log in." : $"Reactivate {user.Username}?")')">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <input type="hidden" name="suspend" value="@user.IsActive.ToString().ToLower()" />
                                        <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                title="@(user.IsActive ? "Suspend" : "Reactivate")">
                                            <i class="bi @(user.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="DeleteUser" class="d-inline"
                                          onsubmit="return confirm('Permanently delete @user.Username? This cannot be undone.')">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="addUserModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-page-handler="AddUser">
                    <div class="modal-body">
                        <div class="row g-2 mb-3">
                            <div class="col">
                                <label class="form-label">First Name</label>
                                <input name="Add.FirstName" class="form-control" autocomplete="off" />
                            </div>
                            <div class="col">
                                <label class="form-label">Last Name</label>
                                <input name="Add.LastName" class="form-control" autocomplete="off" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Username <span class="text-danger">*</span></label>
                            <input name="Add.Username" class="form-control" required minlength="3" maxlength="100" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email <span class="text-muted small">(optional)</span></label>
                            <input name="Add.Email" class="form-control" type="email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password <span class="text-danger">*</span></label>
                            <input name="Add.Password" class="form-control" type="password" required minlength="8" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Role</label>
                            <select name="Add.Role" class="form-select">
                                <option value="2">Viewer</option>
                                <option value="3">Staff (Terminal)</option>
                                <option value="1">Manager</option>
                                <option value="0">Admin</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Create User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editUserModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit User — <span id="editModalUsername"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-page-handler="EditUser">
                    <input type="hidden" name="Edit.UserId" id="editUserId" />
                    <div class="modal-body">
                        <div class="row g-2 mb-3">
                            <div class="col">
                                <label class="form-label">First Name</label>
                                <input name="Edit.FirstName" id="editFirstName" class="form-control" />
                            </div>
                            <div class="col">
                                <label class="form-label">Last Name</label>
                                <input name="Edit.LastName" id="editLastName" class="form-control" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email <span class="text-muted small">(optional)</span></label>
                            <input name="Edit.Email" id="editEmail" class="form-control" type="email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Role</label>
                            <select name="Edit.Role" id="editRole" class="form-select">
                                <option value="2">Viewer</option>
                                <option value="3">Staff (Terminal)</option>
                                <option value="1">Manager</option>
                                <option value="0">Admin</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">
                                New Password
                                <span class="text-muted small">(leave blank to keep current)</span>
                            </label>
                            <input name="Edit.NewPassword" class="form-control" type="password" minlength="8"
                                   placeholder="Leave blank to keep unchanged" />
                        </div>
                        <div class="form-check">
                            <input name="Edit.IsActive" id="editIsActive" class="form-check-input" type="checkbox" value="true" />
                            <label class="form-check-label" for="editIsActive">Active (uncheck to suspend)</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.Tab == "network" && User.IsInRole("Admin"))
{
    var isStopped = Model.TunnelState is TunnelService.TunnelState.Stopped or TunnelService.TunnelState.Error;
    var isRunning = Model.TunnelState == TunnelService.TunnelState.Running;
    var badgeCss  = isRunning ? "bg-success" : Model.TunnelState == TunnelService.TunnelState.Error ? "bg-danger" : "bg-secondary";
    var as0 = string.IsNullOrEmpty(Model.SavedAutostart);
    var asQ = Model.SavedAutostart == "quick";
    var asL = Model.SavedAutostart == "localtunnel";
    var asN = Model.SavedAutostart == "named";

    <div class="row g-4">

        <div class="col-lg-5">
            <div class="card">
                <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-cloud me-2"></i>Remote Access</span>
                    <span id="tunnel-badge" class="badge @badgeCss">@Model.TunnelState</span>
                </div>
                <div class="card-body">

                    <div id="tunnel-url-section" class="@(!isRunning ? "d-none" : "") mb-3">
                        <div class="fw-semibold small mb-1">Public URL</div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <a id="tunnel-url-link" href="@Model.TunnelPublicUrl" target="_blank"
                               class="text-break small">@Model.TunnelPublicUrl</a>
                            <button class="btn btn-sm btn-outline-secondary flex-shrink-0"
                                    onclick="navigator.clipboard.writeText(document.getElementById('tunnel-url-link').textContent)"
                                    title="Copy URL">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                        <div id="qr-container" class="text-center"></div>
                    </div>

                    <div id="tunnel-error" class="@(Model.TunnelState != TunnelService.TunnelState.Error ? "d-none" : "") alert alert-danger small py-2 mb-3">@Model.TunnelError</div>

                    <div id="tunnel-controls"
                         data-lt-subdomain="@Model.SavedLtSubdomain"
                         data-named-token="@(string.IsNullOrWhiteSpace(Model.SavedTunnelToken) ? "" : "1")"
                         data-named-url="@Model.SavedTunnelUrl"
                         data-saved-token="@Model.SavedTunnelToken"
                         data-serveo-subdomain="@Model.SavedServeoSubdomain">
                        @if (isStopped)
                        {
                            <div class="d-grid gap-2">
                                <button class="btn btn-sm btn-primary" onclick="startTunnel('quick')">
                                    <i class="bi bi-lightning me-1"></i> Quick Tunnel
                                    <span class="text-white-50 ms-1 small">random URL</span>
                                </button>
                                @if (!string.IsNullOrWhiteSpace(Model.SavedServeoSubdomain))
                                {
                                    <button class="btn btn-sm btn-success" onclick="startTunnel('serveo')">
                                        <i class="bi bi-shield-lock me-1"></i> @(Model.SavedServeoSubdomain + ".serveousercontent.com")
                                    </button>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.SavedLtSubdomain))
                                {
                                    <button class="btn btn-sm btn-outline-success" onclick="startTunnel('localtunnel')">
                                        <i class="bi bi-link-45deg me-1"></i> @(Model.SavedLtSubdomain + ".loca.lt")
                                    </button>
                                }
                            </div>
                        }
                        else if (isRunning)
                        {
                            <button class="btn btn-sm btn-danger w-100" onclick="stopTunnel()">
                                <i class="bi bi-stop-fill me-1"></i> Stop Tunnel
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary w-100" disabled>
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                @Model.TunnelState…
                            </button>
                        }
                    </div>

                    <div class="form-text mt-2">
                        Tunnels provide HTTPS remote access and enable the camera barcode scanner from any device.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="accordion" id="tunnelAccordion">

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button @(string.IsNullOrWhiteSpace(Model.SavedServeoSubdomain) && Model.ServeoPublicKey == null ? "collapsed" : "")"
                                type="button" data-bs-toggle="collapse" data-bs-target="#serveo-section">
                            <i class="bi bi-shield-lock me-2 text-success"></i>
                            Serveo <span class="text-muted ms-2 small">free persistent subdomain</span>
                            @if (!string.IsNullOrWhiteSpace(Model.SavedServeoSubdomain))
                            {
                                <span class="badge bg-success ms-2">Configured</span>
                            }
                        </button>
                    </h2>
                    <div id="serveo-section" class="accordion-collapse collapse @((!string.IsNullOrWhiteSpace(Model.SavedServeoSubdomain) || Model.ServeoPublicKey != null) ? "show" : "")">
                        <div class="accordion-body">

                            <div class="mb-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-primary rounded-pill">1</span>
                                    <strong>Generate your SSH key</strong>
                                </div>
                                @if (Model.ServeoPublicKey is null)
                                {
                                    <p class="text-muted small mb-2">
                                        The app generates a unique SSH key pair. The private key is stored securely in the app database. You only do this once.
                                    </p>
                                    <button class="btn btn-sm btn-primary" onclick="generateServeoKey(this)">
                                        <i class="bi bi-key me-1"></i> Generate SSH Key
                                    </button>
                                    <div id="key-gen-status" class="form-text mt-1"></div>
                                }
                                else
                                {
                                    <p class="text-muted small mb-2">SSH key generated. Copy the public key below:</p>
                                    <div class="input-group input-group-sm mb-1">
                                        <input type="text" class="form-control font-monospace small"
                                               id="serveo-pubkey" value="@Model.ServeoPublicKey" readonly />
                                        <button class="btn btn-outline-secondary" type="button"
                                                onclick="copyServeoKey(this)" title="Copy public key">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                        <button class="btn btn-outline-warning" type="button"
                                                onclick="regenerateServeoKey(this)" title="Generate a new key (you will need to re-add it to Serveo)">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </button>
                                    </div>
                                    <div class="form-text"><i class="bi bi-check-circle-fill text-success me-1"></i>Key ready (RSA 4096)</div>
                                }
                            </div>

                            <div class="mb-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-primary rounded-pill">2</span>
                                    <strong>Create a Serveo account &amp; add your SSH key</strong>
                                </div>
                                <ol class="small ps-3 mb-2">
                                    <li>Go to <a href="https://serveo.net" target="_blank">serveo.net</a> and sign up for a free account.</li>
                                    <li>In the Serveo Console, go to <strong>SSH Keys</strong> and add your public key from Step 1.</li>
                                    <li>With a free account your subdomain is persistent. Upgrade to Pro ($6/mo) to remove the interstitial warning page for visitors.</li>
                                </ol>
                                <a href="https://console.serveo.net" target="_blank" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> Open Serveo Console
                                </a>
                            </div>

                            <div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-primary rounded-pill">3</span>
                                    <strong>Choose your subdomain</strong>
                                </div>
                                <p class="small text-muted mb-2">
                                    Pick a name — once your SSH key is registered it's permanently yours:
                                    <code>https://yourname.serveousercontent.com</code>
                                </p>
                                <form method="post" asp-page-handler="SaveTunnelConfig">
                                    <div class="input-group input-group-sm mb-2">
                                        <span class="input-group-text">https://</span>
                                        <input name="serveoSubdomain" class="form-control"
                                               value="@Model.SavedServeoSubdomain"
                                               placeholder="myinventory" />
                                        <span class="input-group-text">.serveousercontent.com</span>
                                    </div>
                                    <input type="hidden" name="tunnelToken"  value="@Model.SavedTunnelToken" />
                                    <input type="hidden" name="tunnelUrl"    value="@Model.SavedTunnelUrl" />
                                    <input type="hidden" name="ltSubdomain"  value="@Model.SavedLtSubdomain" />
                                    <input type="hidden" name="autostart"    value="@Model.SavedAutostart" />
                                    <button type="submit" class="btn btn-sm btn-primary">Save Subdomain</button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button @(string.IsNullOrWhiteSpace(Model.SavedLtSubdomain) ? "collapsed" : "")"
                                type="button" data-bs-toggle="collapse" data-bs-target="#lt-section">
                            <i class="bi bi-link-45deg me-2 text-success"></i>
                            localtunnel <span class="text-muted ms-2 small">free persistent subdomain</span>
                        </button>
                    </h2>
                    <div id="lt-section" class="accordion-collapse collapse @(!string.IsNullOrWhiteSpace(Model.SavedLtSubdomain) ? "show" : "")">
                        <div class="accordion-body">
                            <form method="post" asp-page-handler="SaveTunnelConfig">
                                <div class="input-group input-group-sm mb-2">
                                    <span class="input-group-text">https://</span>
                                    <input name="ltSubdomain" class="form-control"
                                           value="@Model.SavedLtSubdomain"
                                           placeholder="InventoryStore" />
                                    <span class="input-group-text">.loca.lt</span>
                                </div>
                                <div class="form-text mb-2">
                                    No account needed. Subdomain is first-come-first-served.<br/>
                                    First-time visitors need to bypass the loca.lt landing page once.
                                </div>
                                <input type="hidden" name="tunnelToken"     value="@Model.SavedTunnelToken" />
                                <input type="hidden" name="tunnelUrl"      value="@Model.SavedTunnelUrl" />
                                <input type="hidden" name="autostart"      value="@Model.SavedAutostart" />
                                <input type="hidden" name="serveoSubdomain" value="@Model.SavedServeoSubdomain" />
                                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button @(Model.HttpsEnabled || Model.HttpsCertUploaded ? "" : "collapsed")"
                                type="button" data-bs-toggle="collapse" data-bs-target="#https-section">
                            <i class="bi bi-lock me-2 text-primary"></i>
                            HTTPS / TLS (Port 443)
                            @if (Model.HttpsEnabled)
                            {
                                <span class="badge bg-success ms-2">Active</span>
                            }
                            else if (Model.HttpsCertUploaded)
                            {
                                <span class="badge bg-warning text-dark ms-2">Cert uploaded, disabled</span>
                            }
                        </button>
                    </h2>
                    <div id="https-section" class="accordion-collapse collapse @(Model.HttpsEnabled || Model.HttpsCertUploaded ? "show" : "")">
                        <div class="accordion-body">
                            <h6 class="mb-2"><i class="bi bi-magic me-1"></i>Automatic certificate (Let's Encrypt)</h6>
                            <p class="text-muted small mb-3">
                                Inventory Store can obtain and automatically renew a free certificate from
                                Let's Encrypt. Your domain's DNS must point to this server, and ports
                                <strong>80</strong> and <strong>443</strong> must be reachable from the internet.
                                Changes take effect after restarting the service.
                            </p>
                            <form method="post" asp-page-handler="SaveLetsEncrypt">
                                @Html.AntiForgeryToken()
                                <div class="row g-3 mb-3">
                                    <div class="col-12">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="le-enabled"
                                                   name="leEnabled" value="true"
                                                   @(Model.HttpsMode == "letsencrypt" && Model.HttpsEnabled ? "checked" : "") />
                                            <label class="form-check-label" for="le-enabled">Enable automatic HTTPS</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small mb-1">Domain</label>
                                        <input type="text" name="leDomain" class="form-control form-control-sm"
                                               value="@Model.HttpsDomain" placeholder="e.g. inventory.mycompany.com" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small mb-1">Email <span class="text-muted">(renewal notices)</span></label>
                                        <input type="email" name="leEmail" class="form-control form-control-sm"
                                               value="@Model.LeEmail" placeholder="you@example.com" autocomplete="email" />
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="le-tos"
                                                   name="leAcceptTos" value="true" @(Model.LeTosAccepted ? "checked" : "") />
                                            <label class="form-check-label small" for="le-tos">
                                                I accept the
                                                <a href="https://letsencrypt.org/repository/" target="_blank" rel="noopener">Let's Encrypt Terms of Service</a>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-floppy me-1"></i>Save</button>
                            </form>

                            <hr class="my-4" />

                            <h6 class="mb-2"><i class="bi bi-upload me-1"></i>Or upload your own certificate</h6>
                            <p class="text-muted small mb-3">
                                Serve Inventory Store over HTTPS on your own domain using a certificate you provide.
                                Supply a <strong>.pfx</strong> file (certificate + private key bundled together).
                                Changes take effect after restarting the service.
                            </p>
                            <form method="post" asp-page-handler="SaveHttps" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <div class="row g-3 mb-3">
                                    <div class="col-12">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="https-enabled"
                                                   name="httpsEnabled" value="true" @(Model.HttpsEnabled ? "checked" : "") />
                                            <label class="form-check-label" for="https-enabled">Enable HTTPS</label>
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label small mb-1">Domain <span class="text-muted">(for display only)</span></label>
                                        <input type="text" name="httpsDomain" class="form-control form-control-sm"
                                               value="@Model.HttpsDomain" placeholder="e.g. inventory.mycompany.com" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small mb-1">Port</label>
                                        <input type="number" name="httpsPort" class="form-control form-control-sm"
                                               value="@Model.HttpsPort" min="1" max="65535" />
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label small mb-1">
                                            Certificate (.pfx)
                                            @if (Model.HttpsCertUploaded)
                                            {
                                                <span class="text-success ms-1"><i class="bi bi-check-circle-fill"></i> Certificate uploaded</span>
                                            }
                                        </label>
                                        <input type="file" name="certFile" class="form-control form-control-sm" accept=".pfx" />
                                        <div class="form-text">Upload a new .pfx to replace the existing certificate.</div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small mb-1">Certificate Password</label>
                                        <input type="password" name="httpsCertPassword" class="form-control form-control-sm"
                                               placeholder="Leave blank to keep current" autocomplete="new-password" />
                                    </div>
                                </div>
                                <div class="d-flex gap-2 align-items-center flex-wrap">
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        <i class="bi bi-floppy me-1"></i>Save
                                    </button>
                                    @if (Model.HttpsCertUploaded)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearHttpsCert()">
                                            <i class="bi bi-trash me-1"></i>Remove Certificate
                                        </button>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="restartService()">
                                        <i class="bi bi-arrow-clockwise me-1"></i>Restart Service
                                    </button>
                                    <span id="restart-status" class="small text-muted"></span>
                                </div>
                            </form>
                            @if (!Model.HttpsCertUploaded)
                            {
                                <div class="alert alert-info small py-2 mt-3 mb-0">
                                    <strong>How to create a .pfx:</strong>
                                    If you have a PEM cert from Let's Encrypt or another CA, combine it with:
                                    <code>openssl pkcs12 -export -out https.pfx -inkey privkey.pem -in fullchain.pem</code>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button"
                                data-bs-toggle="collapse" data-bs-target="#autostart-section">
                            <i class="bi bi-play-circle me-2"></i>
                            Auto-start
                        </button>
                    </h2>
                    <div id="autostart-section" class="accordion-collapse collapse">
                        <div class="accordion-body">
                            <form method="post" asp-page-handler="SaveTunnelConfig">
                                <select name="autostart" class="form-select form-select-sm mb-2">
                                    <option value="" selected="@as0">Disabled</option>
                                    <option value="quick" selected="@asQ">Quick Tunnel (random URL)</option>
                                    <option value="serveo" selected="@(Model.SavedAutostart == "serveo")">Serveo (recommended)</option>
                                    <option value="localtunnel" selected="@asL">localtunnel (loca.lt)</option>
                                </select>
                                <input type="hidden" name="tunnelToken"     value="@Model.SavedTunnelToken" />
                                <input type="hidden" name="tunnelUrl"      value="@Model.SavedTunnelUrl" />
                                <input type="hidden" name="ltSubdomain"    value="@Model.SavedLtSubdomain" />
                                <input type="hidden" name="serveoSubdomain" value="@Model.SavedServeoSubdomain" />
                                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                            </form>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
}


@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    if (document.getElementById('cats-tbody'))    pgInit('cats-pg',    'cats-tbody',    10);
    if (document.getElementById('tags-tbody'))    pgInit('tags-pg',    'tags-tbody',    10);
    if (document.getElementById('locs-tbody'))    pgInit('locs-pg',    'locs-tbody',    10);
    if (document.getElementById('pubview-tbody')) pgInit('pubview-pg', 'pubview-tbody', 50);
});
</script>
@if (Model.Tab == "modules" && Model.ModuleSection == "sds" && Model.IsModuleEnabled("sds"))
{
<script>
function sdsEsc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c];
    });
}
async function loadSdsTable() {
    var tbody = document.getElementById('sds-table-tbody');
    var err   = document.getElementById('sds-table-error');
    var empty = document.getElementById('sds-table-empty');
    err.classList.add('d-none');
    empty.classList.add('d-none');
    tbody.innerHTML = '';
    try {
        var res = await fetch('/api/sds');
        if (!res.ok) throw new Error();
        var rows = await res.json();
        if (!rows.length) { empty.classList.remove('d-none'); return; }
        tbody.innerHTML = rows.map(function (r) {
            var hazards = r.hazardStatements
                ? sdsEsc(r.hazardStatements).replace(/\n/g, '<br>')
                : '<span class="text-muted">—</span>';
            var link = r.sdsUrl
                ? ' <a href="' + sdsEsc(r.sdsUrl) + '" target="_blank" title="Open in PubChem"><i class="bi bi-box-arrow-up-right"></i></a>'
                : '';
            var fetched = r.fetchedAt ? new Date(r.fetchedAt).toLocaleDateString() : '';
            return '<tr>' +
                '<td>' + sdsEsc(r.itemName) + '</td>' +
                '<td>' + sdsEsc(r.chemicalName) + link + '</td>' +
                '<td>' + sdsEsc(r.casNumber || '—') + '</td>' +
                '<td>' + sdsEsc(r.signalWord || '—') + '</td>' +
                '<td class="small">' + hazards + '</td>' +
                '<td>' + sdsEsc(r.source) + '</td>' +
                '<td class="text-end text-nowrap small text-muted">' + fetched + '</td>' +
                '<td class="text-end"><button class="btn btn-sm btn-outline-danger" onclick="deleteSds(' + r.id + ')" title="Delete"><i class="bi bi-trash"></i></button></td>' +
                '</tr>';
        }).join('');
    } catch {
        err.textContent = 'Could not load safety data sheets.';
        err.classList.remove('d-none');
    }
}
async function deleteSds(id) {
    if (!confirm('Remove this safety data sheet?')) return;
    try {
        var res = await fetch('/api/sds/' + id + '/delete', { method: 'POST' });
        if (res.ok) loadSdsTable();
    } catch {}
}
document.addEventListener('DOMContentLoaded', loadSdsTable);
</script>
}
@if (Model.Tab == "modules" && Model.ModuleSection == "cost" && Model.IsModuleEnabled("cost"))
{
<script>
function modEsc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function money(cur,n){ if(n==null||isNaN(n)) return '-'; return cur + Number(n).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); }
async function loadValuation() {
    var err=document.getElementById('val-error'), empty=document.getElementById('val-empty');
    var sum=document.getElementById('val-summary'), tbody=document.getElementById('val-tbody');
    err.classList.add('d-none'); empty.classList.add('d-none'); tbody.innerHTML=''; sum.innerHTML='';
    try {
        var res = await fetch('/api/cost/valuation');
        if (!res.ok) throw new Error();
        var d = await res.json();
        var cur = d.currency || '$';
        sum.innerHTML =
            '<div class="col-auto"><div class="text-muted small">Total value</div><div class="fs-5 fw-semibold">'+money(cur,d.totalValue)+'</div></div>' +
            '<div class="col-auto"><div class="text-muted small">Book value (after depreciation)</div><div class="fs-5 fw-semibold">'+money(cur,d.totalBookValue)+'</div></div>' +
            '<div class="col-auto"><div class="text-muted small">Items costed</div><div class="fs-5 fw-semibold">'+d.itemsCosted+'</div></div>';
        if (!d.items.length) { empty.classList.remove('d-none'); return; }
        tbody.innerHTML = d.items.map(function(r){
            return '<tr>'+
                '<td>'+modEsc(r.name)+'</td>'+
                '<td>'+modEsc(r.category)+'</td>'+
                '<td class="text-end">'+r.quantity+'</td>'+
                '<td class="text-end">'+money(cur,r.unitCost)+'</td>'+
                '<td class="text-end">'+money(cur,r.lineValue)+'</td>'+
                '<td class="text-end">'+money(cur,r.bookValue)+'</td>'+
                '</tr>';
        }).join('');
    } catch { err.textContent='Could not load valuation.'; err.classList.remove('d-none'); }
}
document.addEventListener('DOMContentLoaded', loadValuation);
</script>
}
@if (Model.Tab == "modules" && Model.ModuleSection == "forecast" && Model.IsModuleEnabled("forecast"))
{
<script>
function fcEsc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
async function loadForecast() {
    var err=document.getElementById('fc-error'), empty=document.getElementById('fc-empty'), tbody=document.getElementById('fc-tbody');
    err.classList.add('d-none'); empty.classList.add('d-none'); tbody.innerHTML='';
    try {
        var res = await fetch('/api/forecast');
        if (!res.ok) throw new Error();
        var rows = await res.json();
        if (!rows.length) { empty.classList.remove('d-none'); return; }
        tbody.innerHTML = rows.map(function(r){
            var days = r.daysRemaining==null ? '∞' : Math.round(r.daysRemaining);
            var runout = r.runOutDate ? new Date(r.runOutDate).toLocaleDateString() : '<span class="text-muted">—</span>';
            var cls = (r.daysRemaining!=null && r.daysRemaining<=14) ? ' class="text-danger fw-semibold"' : '';
            return '<tr'+cls+'>'+
                '<td>'+fcEsc(r.name)+'</td>'+
                '<td class="text-end">'+r.quantity+'</td>'+
                '<td class="text-end">'+r.avgDailyUse.toFixed(2)+'</td>'+
                '<td class="text-end">'+days+'</td>'+
                '<td>'+runout+'</td>'+
                '</tr>';
        }).join('');
    } catch { err.textContent='Could not load forecast.'; err.classList.remove('d-none'); }
}
document.addEventListener('DOMContentLoaded', loadForecast);
</script>
}
@if (Model.Tab == "modules" && Model.ModuleSection == "webhooks" && Model.IsModuleEnabled("webhooks"))
{
<script>
function whEsc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
async function loadWebhooks() {
    var err=document.getElementById('wh-error'), empty=document.getElementById('wh-empty'), tbody=document.getElementById('wh-tbody');
    err.classList.add('d-none'); empty.classList.add('d-none'); tbody.innerHTML='';
    try {
        var res = await fetch('/api/webhooks');
        if (!res.ok) throw new Error();
        var rows = await res.json();
        if (!rows.length) { empty.classList.remove('d-none'); return; }
        tbody.innerHTML = rows.map(function(r){
            var last = r.lastStatus ? whEsc(r.lastStatus) : '<span class="text-muted">never</span>';
            return '<tr>'+
                '<td class="text-break small">'+whEsc(r.url)+'</td>'+
                '<td class="small">'+whEsc(r.events)+'</td>'+
                '<td>'+(r.signed?'<i class="bi bi-shield-check text-success"></i>':'<span class="text-muted">no</span>')+'</td>'+
                '<td class="small">'+last+'</td>'+
                '<td class="text-end text-nowrap">'+
                    '<button class="btn btn-sm btn-outline-secondary me-1" onclick="testWebhook('+r.id+')" title="Send test"><i class="bi bi-send"></i></button>'+
                    '<button class="btn btn-sm btn-outline-danger" onclick="deleteWebhook('+r.id+')" title="Delete"><i class="bi bi-trash"></i></button>'+
                '</td></tr>';
        }).join('');
    } catch { err.textContent='Could not load endpoints.'; err.classList.remove('d-none'); }
}
async function addWebhook() {
    var url=document.getElementById('wh-url').value.trim();
    var secret=document.getElementById('wh-secret').value.trim();
    var status=document.getElementById('wh-add-status');
    var events=Array.from(document.querySelectorAll('.wh-event:checked')).map(function(c){return c.value;});
    if(!url){ status.innerHTML='<span class="text-danger">Enter a URL.</span>'; return; }
    if(!events.length){ status.innerHTML='<span class="text-danger">Pick at least one event.</span>'; return; }
    status.innerHTML='';
    try {
        var res = await fetch('/api/webhooks', { method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({ url:url, secret:secret||null, events:events.join(',') }) });
        if (res.ok) { document.getElementById('wh-url').value=''; document.getElementById('wh-secret').value=''; loadWebhooks(); }
        else status.innerHTML='<span class="text-danger">Add failed.</span>';
    } catch { status.innerHTML='<span class="text-danger">Network error.</span>'; }
}
async function deleteWebhook(id){ if(!confirm('Delete this endpoint?'))return; try{ var r=await fetch('/api/webhooks/'+id+'/delete',{method:'POST'}); if(r.ok)loadWebhooks(); }catch{} }
async function testWebhook(id){ try{ var r=await fetch('/api/webhooks/'+id+'/test',{method:'POST'}); var d=await r.json(); alert(d.ok?('Sent: HTTP '+d.status):('Failed: '+(d.error||('HTTP '+d.status)))); loadWebhooks(); }catch{ alert('Network error.'); } }
document.addEventListener('DOMContentLoaded', loadWebhooks);
</script>
}
@if (Model.Tab == "notifications")
{
<script>
function testNtfy() {
    var btn = document.getElementById('btn-test-ntfy');
    var res = document.getElementById('ntfy-test-result');
    btn.disabled = true;
    res.textContent = 'Sending…';
    fetch('/api/ntfy/test', { method: 'POST', headers: { 'RequestVerificationToken': document.getElementById('af-token').value } })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            res.textContent  = d.ok ? '✓ Sent (HTTP ' + d.code + ')' : '✗ Failed (HTTP ' + d.code + ')';
            res.className    = 'ms-1 small ' + (d.ok ? 'text-success' : 'text-danger');
        })
        .catch(function() { res.textContent = '✗ Network error'; res.className = 'ms-1 small text-danger'; })
        .finally(function() { btn.disabled = false; });
}
function clearToken() {
    if (!confirm('Clear the stored ntfy auth token?')) return;
    var form = document.createElement('form');
    form.method = 'post';
    form.action = '/Settings?handler=ClearNtfyToken';
    var tok = document.createElement('input');
    tok.type = 'hidden'; tok.name = '__RequestVerificationToken';
    tok.value = document.getElementById('af-token').value;
    form.appendChild(tok);
    document.body.appendChild(form);
    form.submit();
}
</script>
}
@if (Model.Tab == "network")
{
<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
<script>
(function () {
    var pollTimer  = null;
    var lastUrl    = null;
    var controls   = document.getElementById('tunnel-controls');
    var ltSub      = controls ? controls.dataset.ltSubdomain    : '';
    var namedToken = controls ? controls.dataset.namedToken     : '';
    var savedToken = controls ? controls.dataset.savedToken     : '';
    var namedUrl   = controls ? controls.dataset.namedUrl       : '';
    var serveoSub  = controls ? controls.dataset.serveoSubdomain: '';

    // ── Public API called by inline onclick attributes ────────────────
    window.startTunnel = function (mode) {
        var apiUrl, body, headers = {};
        if (mode === 'named') {
            apiUrl = '/api/tunnel/start-named';
            body   = JSON.stringify({ token: savedToken, publicUrl: namedUrl });
            headers['Content-Type'] = 'application/json';
        } else if (mode === 'localtunnel') {
            apiUrl = '/api/tunnel/start-localtunnel';
            body   = JSON.stringify({ subdomain: ltSub });
            headers['Content-Type'] = 'application/json';
        } else if (mode === 'serveo') {
            apiUrl = '/api/tunnel/start-serveo';
            body   = JSON.stringify({ subdomain: serveoSub });
            headers['Content-Type'] = 'application/json';
        } else {
            apiUrl = '/api/tunnel/start-quick';
        }
        renderControls('Starting');
        fetch(apiUrl, { method: 'POST', headers: headers, body: body || null, credentials: 'include' })
            .then(function () { startPolling(); });
    };

    window.generateServeoKey = function (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Generating...';
        var status = document.getElementById('key-gen-status');
        fetch('/api/tunnel/generate-serveo-key', { method: 'POST', credentials: 'include' })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.publicKey) {
                    if (status) status.innerHTML = '<i class="bi bi-check-circle-fill text-success me-1"></i>Key generated — reload the page to see it.';
                    setTimeout(function () { location.reload(); }, 1200);
                } else {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-key me-1"></i> Generate SSH Key';
                    if (status) status.textContent = 'Generation failed. Check that OpenSSH Client is installed.';
                }
            })
            .catch(function () {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-key me-1"></i> Generate SSH Key';
                if (status) status.textContent = 'Request failed.';
            });
    };

    window.regenerateServeoKey = function (btn) {
        if (!confirm('This will generate a new SSH key. You will need to remove the old key from your Serveo account and add the new one. Continue?')) return;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
        fetch('/api/tunnel/regenerate-serveo-key', { method: 'POST', credentials: 'include' })
            .then(function (r) { return r.json(); })
            .then(function () { location.reload(); })
            .catch(function () { btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-clockwise"></i>'; });
    };

    window.copyServeoKey = function (btn) {
        var input = document.getElementById('serveo-pubkey');
        if (input) {
            navigator.clipboard.writeText(input.value).then(function () {
                btn.innerHTML = '<i class="bi bi-check"></i> Copied';
                setTimeout(function () { btn.innerHTML = '<i class="bi bi-clipboard"></i>'; }, 2000);
            });
        }
    };

    window.stopTunnel = function () {
        renderControls('Stopping');
        fetch('/api/tunnel/stop', { method: 'POST', credentials: 'include' })
            .then(function () { startPolling(); });
    };

    function startPolling() {
        if (pollTimer) clearInterval(pollTimer);
        pollTimer = setInterval(pollStatus, 1200);
        pollStatus();
    }

    function pollStatus() {
        fetch('/api/tunnel/status', { credentials: 'include' })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                updateUI(data);
                if (data.state === 'Running' || data.state === 'Stopped' || data.state === 'Error') {
                    clearInterval(pollTimer);
                    pollTimer = null;
                }
            });
    }

    function updateUI(data) {
        // Badge
        var badge = document.getElementById('tunnel-badge');
        if (badge) {
            badge.textContent = data.state;
            badge.className   = 'badge ' + (data.state === 'Running' ? 'bg-success' : data.state === 'Error' ? 'bg-danger' : 'bg-secondary');
        }

        // Error message
        var errEl = document.getElementById('tunnel-error');
        if (errEl) {
            errEl.textContent = data.error || '';
            errEl.classList.toggle('d-none', data.state !== 'Error');
        }

        // URL + QR
        var urlSection  = document.getElementById('tunnel-url-section');
        var urlLink     = document.getElementById('tunnel-url-link');
        var qrContainer = document.getElementById('qr-container');
        if (data.state === 'Running' && data.url) {
            if (urlSection) urlSection.classList.remove('d-none');
            if (urlLink)    { urlLink.href = data.url; urlLink.textContent = data.url; }
            if (qrContainer && data.url !== lastUrl && typeof QRCode !== 'undefined') {
                lastUrl = data.url;
                qrContainer.innerHTML = '';
                var canvas = document.createElement('canvas');
                qrContainer.appendChild(canvas);
                QRCode.toCanvas(canvas, data.url, { width: 180, margin: 1 });
            }
        } else {
            if (urlSection) urlSection.classList.add('d-none');
        }

        // Buttons
        renderControls(data.state);
    }

    function renderControls(state) {
        if (!controls) return;
        var html = '';
        if (state === 'Stopped' || state === 'Error') {
            html += '<div class="d-grid gap-2">';
            html += '<button class="btn btn-sm btn-primary" onclick="startTunnel(\'quick\')">'
                  + '<i class="bi bi-lightning me-1"></i> Quick Tunnel '
                  + '<span class="text-white-50 small">random URL</span></button>';
            if (serveoSub) {
                html += '<button class="btn btn-sm btn-success" onclick="startTunnel(\'serveo\')">'
                      + '<i class="bi bi-shield-lock me-1"></i> ' + serveoSub + '.serveousercontent.com</button>';
            }
            if (ltSub) {
                html += '<button class="btn btn-sm btn-outline-success" onclick="startTunnel(\'localtunnel\')">'
                      + '<i class="bi bi-link-45deg me-1"></i> ' + ltSub + '.loca.lt</button>';
            }
            html += '</div>';
        } else if (state === 'Running') {
            html = '<button class="btn btn-sm btn-danger w-100" onclick="stopTunnel()">'
                 + '<i class="bi bi-stop-fill me-1"></i> Stop Tunnel</button>';
        } else {
            html = '<button class="btn btn-sm btn-secondary w-100" disabled>'
                 + '<span class="spinner-border spinner-border-sm me-1"></span>'
                 + state + '…</button>';
        }
        controls.innerHTML = html;
    }

    // On page load: if mid-transition or already running, sync state
    var initialState = '@Model.TunnelState';
    if (initialState === 'Downloading' || initialState === 'Starting') {
        startPolling();
    } else if (initialState === 'Running') {
        @if (Model.TunnelPublicUrl != null) {
            <text>
            if (typeof QRCode !== 'undefined') {
                var c = document.createElement('canvas');
                var qrc = document.getElementById('qr-container');
                if (qrc) { qrc.appendChild(c); QRCode.toCanvas(c, '@Model.TunnelPublicUrl', { width: 180, margin: 1 }); }
            }
            </text>
        }
    }
})();

function clearHttpsCert() {
    if (!confirm('Remove the uploaded certificate? HTTPS will be disabled.')) return;
    var form = document.createElement('form');
    form.method = 'post';
    form.action = '/Settings?handler=ClearHttpsCert';
    var tok = document.createElement('input');
    tok.type = 'hidden'; tok.name = '__RequestVerificationToken';
    tok.value = document.getElementById('af-token').value;
    form.appendChild(tok);
    document.body.appendChild(form);
    form.submit();
}

function restartService() {
    var btn   = document.querySelector('[onclick="restartService()"]');
    var label = document.getElementById('restart-status');
    btn.disabled = true;
    label.textContent = 'Restarting...';
    label.className = 'small text-muted';
    fetch('/api/admin/restart', {
        method: 'POST',
        headers: { 'RequestVerificationToken': document.getElementById('af-token').value }
    })
    .then(function() {
        label.textContent = 'Service stopping - page will reload shortly...';
        setTimeout(function() { location.reload(); }, 4000);
    })
    .catch(function() {
        label.textContent = 'Restart failed.';
        label.className = 'small text-danger';
        btn.disabled = false;
    });
}
</script>
}

<script>

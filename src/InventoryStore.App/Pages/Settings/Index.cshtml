                                            {
                                                <span class="badge rounded-pill" style="background:@(item.CategoryColor ?? "#6c757d");font-weight:500">
                                                    @item.CategoryName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                        <td>@item.AvailableQuantity</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex align-items-center justify-content-between px-3 py-2 border-top small text-muted" id="pubview-pg-bar">
                        <span id="pubview-pg-range"></span>
                        <div class="d-flex align-items-center gap-1">
                            <select class="form-select form-select-sm py-0" style="width:auto" onchange="pgSz('pubview-pg',this.value)">
                                <option value="5">5 / page</option>
                                <option value="10">10 / page</option>
                                <option value="50" selected>50 / page</option>
                                <option value="100">100 / page</option>
                            </select>
                            <button class="btn btn-sm btn-outline-secondary py-0 px-2" id="pubview-pg-prev" onclick="pgGo('pubview-pg',-1)">&#8249;</button>
                            <span class="px-1" id="pubview-pg-lbl"></span>
                            <button class="btn btn-sm btn-outline-secondary py-0 px-2" id="pubview-pg-next" onclick="pgGo('pubview-pg',1)">&#8250;</button>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
}

@if (Model.Tab == "database" && User.IsInRole("Admin"))
{
    <div class="row g-4" style="max-width: 620px;">

        <div class="col-12">
            <div class="card">
                <div class="card-header fw-semibold"><i class="bi bi-download me-2"></i>Backup</div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Downloads a consistent snapshot of the current database as a <code>.db</code> file.
                        The app continues running normally during the backup.
                    </p>
                    <a href="/Settings?handler=DownloadBackup" class="btn btn-primary">
                        <i class="bi bi-download me-1"></i> Download Backup
                    </a>
                </div>

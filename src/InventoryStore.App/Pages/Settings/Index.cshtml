            '<div><span class="fw-semibold">' + escHtml(i.name) + '</span>' +
            (i.sku ? '<span class="text-muted small ms-2">' + escHtml(i.sku) + '</span>' : '') + '</div>' +
            '<button class="btn btn-sm btn-outline-danger" onclick="mgrTagSetItem(' + i.id + ', false)">Remove</button>' +

@page
@model InventoryStore.App.Pages.Management.IndexModel
@{
    ViewData["Title"] = "Management";
    ViewData["ActivePage"] = "Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Management</h1>
</div>

<ul class="nav nav-tabs mb-4" id="mgmtTabs">
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == "users" ? "active" : "")" href="/Management?tab=users">
            <i class="bi bi-people me-1"></i> Users
        </a>
    </li>
</ul>

@if (Model.Tab == "users")
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">User Accounts</h5>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createUserModal">
            <i class="bi bi-person-plus me-1"></i> Add User
        </button>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Last Login</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="users-tbody">
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="fw-semibold">@user.Username</td>
                            <td class="text-muted small">@user.Email</td>
                            <td>
                                <span class="badge @(user.Role == InventoryStore.Domain.Enums.UserRole.Admin ? "bg-danger" : user.Role == InventoryStore.Domain.Enums.UserRole.Manager ? "bg-warning text-dark" : user.Role == InventoryStore.Domain.Enums.UserRole.Staff ? "bg-info text-dark" : "bg-secondary")">
                                    @user.Role
                                </span>
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @(user.LastLoginAt.HasValue ? user.LastLoginAt.Value.ToLocalTime().ToString("MMM d, yyyy") : "Never")
                            </td>
                            <td class="text-end">
                                @if (user.Role != InventoryStore.Domain.Enums.UserRole.Admin)
                                {
                                    <form method="post" asp-page-handler="DeleteUser" class="d-inline">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Delete user @user.Username?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex align-items-center justify-content-between px-3 py-2 border-top small text-muted" id="users-pg-bar">
            <span id="users-pg-range"></span>
            <div class="d-flex align-items-center gap-1">
                <select class="form-select form-select-sm py-0" style="width:auto" onchange="pgSz('users-pg',this.value)">
                    <option value="5">5 / page</option>
                    <option value="10" selected>10 / page</option>
                    <option value="50">50 / page</option>
                    <option value="100">100 / page</option>
                </select>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" id="users-pg-prev" onclick="pgGo('users-pg',-1)">&#8249;</button>
                <span class="px-1" id="users-pg-lbl"></span>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" id="users-pg-next" onclick="pgGo('users-pg',1)">&#8250;</button>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>document.addEventListener('DOMContentLoaded',function(){ pgInit('users-pg','users-tbody',10); });</script>
}

<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="CreateUser">
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(Model.CreateError))
                    {
                        <div class="alert alert-danger">@Model.CreateError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input name="NewUser.Username" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input name="NewUser.Email" class="form-control" type="email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input name="NewUser.Password" class="form-control" type="password" required minlength="8" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <select name="NewUser.Role" class="form-select">
                            <option value="2">Viewer</option>
                            <option value="3">Staff (Terminal)</option>
                            <option value="1">Manager</option>
                            <option value="0">Admin</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create User</button>
                </div>
            </form>
        </div>
    </div>
</div>

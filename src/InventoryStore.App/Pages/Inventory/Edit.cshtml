@page
@model InventoryStore.App.Pages.Inventory.EditModel
@using InventoryStore.Domain.Enums
@{
    ViewData["Title"] = "Edit Item";
    ViewData["ActivePage"] = "Inventory";
}

<div class="d-flex align-items-center mb-4">
    <a href="/Inventory" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
    <h1 class="h3 mb-0">Edit Item</h1>
</div>

<div class="card" style="max-width: 620px;">
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="ItemId" />
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.Name" class="form-label">Name <span class="text-danger">*</span></label>
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">Item Type</label>
                    <div>
                        @if (Model.DisplayItemType == ItemType.Reusable)
                        {
                            <span class="badge bg-info fs-6"><i class="bi bi-arrow-repeat me-1"></i>Reusable</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6"><i class="bi bi-box me-1"></i>Consumable</span>
                        }
                        <p class="text-muted small mt-1 mb-0">Item type cannot be changed after creation.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Quantity" class="form-label">
                        @(Model.DisplayItemType == ItemType.Reusable ? "Total Quantity" : "In Stock") <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Input.Quantity" class="form-control" type="number" min="0" />
                    <span asp-validation-for="Input.Quantity" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.MinimumQuantity" class="form-label">Minimum Quantity <span class="text-muted small">(low-stock alert)</span></label>
                    <input asp-for="Input.MinimumQuantity" class="form-control" type="number" min="0" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.SKU" class="form-label">SKU / Barcode</label>
                    <div class="input-group">
                        <input asp-for="Input.SKU" id="sku-input" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" id="sku-scan-btn" title="Scan barcode">
                            <i class="bi bi-upc-scan"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary"
                                onclick="openUpcLookup('sku-input','Input_Name')"
                                title="Lookup product metadata">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <div id="sku-scanner-area" class="mt-2 d-none">
                        <div id="sku-scanner-viewport" class="scanner-viewport">
                            <video id="sku-scanner-video" autoplay muted playsinline></video>
                        </div>
                        <div class="d-flex gap-2 mt-1">
                            <small class="text-muted flex-grow-1" id="sku-scan-hint">Point the camera at the barcode</small>
                            <button type="button" class="btn btn-sm btn-outline-danger" id="sku-scan-cancel">Cancel</button>
                        </div>
                    </div>
                    <input type="file" id="sku-capture-input" accept="image/*" capture="environment" class="d-none" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Location" class="form-label">Location</label>
                    <input asp-for="Input.Location" class="form-control"
                           list="location-suggestions" autocomplete="off" />
                    <datalist id="location-suggestions">
                        @foreach (var loc in Model.Locations)
                        {
                            <option value="@loc"></option>
                        }
                    </datalist>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Category</label>
                    <div class="d-flex gap-2">
                        <select name="Input.CategoryId" id="category-select" class="form-select">
                            <option value="" selected="@(Model.Input.CategoryId == null)">-- None --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id" selected="@(Model.Input.CategoryId == cat.Id)">@cat.Name</option>
                            }
                        </select>
                        <button type="button" class="btn btn-outline-secondary" id="new-cat-btn" title="Create new category">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                    <div id="new-cat-form" class="mt-2 border rounded p-2 d-none">
                        <div class="mb-2">
                            <label class="form-label small mb-1">Name <span class="text-danger">*</span></label>
                            <input type="text" id="new-cat-name" class="form-control form-control-sm" placeholder="Category name" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small mb-1">Color <span class="text-muted small">(optional)</span></label>
                            <input type="hidden" id="new-cat-color" value="" />
                            <div class="d-flex flex-wrap gap-1" id="new-cat-swatches">
                                <button type="button" class="swatch-btn" data-color="" title="None"
                                        style="width:28px;height:28px;border-radius:4px;background:#f8f9fa;border:2px solid #dee2e6;"></button>
                                @foreach (var c in new[]{"#0d6efd","#198754","#dc3545","#ffc107","#fd7e14","#6f42c1","#d63384","#0dcaf0","#20c997","#6c757d","#212529"})
                                {
                                    <button type="button" class="swatch-btn" data-color="@c" title="@c"
                                            style="width:28px;height:28px;border-radius:4px;background:@c;border:2px solid transparent;"></button>
                                }
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-primary" id="new-cat-save">Create</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="new-cat-cancel">Cancel</button>
                        </div>
                        <div id="new-cat-error" class="text-danger small mt-1 d-none"></div>
                    </div>
                </div>
                @* Expiry is a consumable concern; only show it for consumables (or a
                   reusable that somehow already has one, so it can be cleared). *@
                @if (Model.DisplayItemType != ItemType.Reusable || Model.Input.ExpiryDate.HasValue)
                {
                    <div class="col-md-6">
                        <label asp-for="Input.ExpiryDate" class="form-label">Expiry Date <span class="text-muted small">(optional)</span></label>
                        <input asp-for="Input.ExpiryDate" class="form-control" type="date" />
                    </div>
                }
                <div class="col-12">
                    <label asp-for="Input.ScanWarning" class="form-label">
                        Scan Warning <span class="text-muted small">(shown when this item is scanned)</span>
                    </label>
                    <input asp-for="Input.ScanWarning" class="form-control"
                           placeholder="e.g. Requires PPE, Handle with care, Check expiry date" />
                </div>
                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label">Description</label>
                    <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-12 d-flex gap-2 pt-2">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a href="/Inventory" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@await Html.PartialAsync("_SkuScannerScript")

@section Scripts {
<script src="~/js/barcode-scanner.js" asp-append-version="true"></script>
<script>
initSkuScanner('sku-input', 'sku-scan-btn', 'sku-scan-cancel', 'sku-scanner-area',
               'sku-scanner-viewport', 'sku-scanner-video',
               'sku-capture-input', 'sku-scan-hint');
</script>
<script>
(function () {
    var btn       = document.getElementById('new-cat-btn');
    var form      = document.getElementById('new-cat-form');
    var cancelBtn = document.getElementById('new-cat-cancel');
    var saveBtn   = document.getElementById('new-cat-save');
    var nameInput = document.getElementById('new-cat-name');
    var colorInput= document.getElementById('new-cat-color');
    var swatches  = document.getElementById('new-cat-swatches');
    var errorEl   = document.getElementById('new-cat-error');
    var select    = document.getElementById('category-select');

    swatches.querySelectorAll('.swatch-btn').forEach(function (b) {
        b.addEventListener('click', function () {
            var color = b.dataset.color || '';
            colorInput.value = color;
            swatches.querySelectorAll('.swatch-btn').forEach(function (s) {
                var match = (s.dataset.color || '') === color;
                s.style.border = match ? '2px solid #000' : '2px solid transparent';
                if (s.dataset.color === '') s.style.border = match ? '2px solid #000' : '2px solid #dee2e6';
            });
        });
    });

    btn.addEventListener('click', function () {
        form.classList.toggle('d-none');
        if (!form.classList.contains('d-none')) nameInput.focus();
    });

    cancelBtn.addEventListener('click', function () {
        form.classList.add('d-none');
        nameInput.value = '';
        colorInput.value = '';
        swatches.querySelectorAll('.swatch-btn').forEach(function (s) {
            s.style.border = s.dataset.color === '' ? '2px solid #dee2e6' : '2px solid transparent';
        });
        errorEl.classList.add('d-none');
    });

    nameInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); saveBtn.click(); }
    });

    saveBtn.addEventListener('click', async function () {
        var name = nameInput.value.trim();
        if (!name) {
            errorEl.textContent = 'Name is required.';
            errorEl.classList.remove('d-none');
            return;
        }
        saveBtn.disabled = true;
        errorEl.classList.add('d-none');
        try {
            var token = document.getElementById('af-token').value;
            var res = await fetch('/Inventory/Edit?handler=CreateCategory', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ name: name, color: colorInput.value, __RequestVerificationToken: token }).toString()
            });
            if (res.ok) {
                var cat = await res.json();
                var opt = new Option(cat.name, cat.id, true, true);
                select.appendChild(opt);
                select.value = cat.id;
                form.classList.add('d-none');
                nameInput.value = '';
                colorInput.value = '';
                swatches.querySelectorAll('.swatch-btn').forEach(function (s) {
                    s.style.border = s.dataset.color === '' ? '2px solid #dee2e6' : '2px solid transparent';
                });
            } else {
                errorEl.textContent = await res.text() || 'Failed to create category.';
                errorEl.classList.remove('d-none');
            }
        } catch {
            errorEl.textContent = 'Network error. Please try again.';
            errorEl.classList.remove('d-none');
        } finally {
            saveBtn.disabled = false;
        }
    });
}());
</script>
}

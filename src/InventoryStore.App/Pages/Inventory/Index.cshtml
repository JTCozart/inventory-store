@page
@model InventoryStore.App.Pages.Inventory.IndexModel
@{
    ViewData["Title"] = "Inventory";
    ViewData["ActivePage"] = "Inventory";
    var canWrite = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Inventory</h1>
    @if (canWrite)
    {
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" onclick="openMetadataExplorer()">
                <i class="bi bi-database me-1"></i> Metadata
            </button>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#importModal">
                <i class="bi bi-upload me-1"></i> Import
            </button>
            <button type="button" class="btn btn-primary" onclick="openAddItemModal()">
                <i class="bi bi-plus-lg me-1"></i> Add Item
            </button>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(Model.ImportResult))
{
    var isOk = Model.ImportResult.StartsWith("ok:");
    var isWarn = Model.ImportResult.StartsWith("warn:");
    var msg = Model.ImportResult.Substring(Model.ImportResult.IndexOf(':') + 1);
    <div class="alert @(isOk ? "alert-success" : isWarn ? "alert-warning" : "alert-danger") alert-dismissible fade show">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex gap-2 flex-wrap">
            <input type="search" id="inv-q" name="q" value="@Model.Query" class="form-control"
                   style="max-width: 300px" placeholder="Search by name, SKU, location, category..."
                   oninput="filterInventoryRows(this.value)" />
            @if (Model.Categories.Any())
            {
                <select name="category" class="form-select" style="max-width: 180px"
                        onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoryFilter == cat.Id)">@cat.Name</option>
                    }
                </select>
            }
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-search"></i>
            </button>
            @if (!string.IsNullOrEmpty(Model.Query) || Model.CategoryFilter.HasValue)
            {
                <a href="/Inventory" class="btn btn-outline-secondary"><i class="bi bi-x"></i></a>
            }
        </form>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox display-4"></i>
        <p class="mt-2">No items found. <a href="#" onclick="openAddItemModal();return false;">Add your first item.</a></p>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="sortable">Name</th>
                        <th class="sortable d-none d-md-table-cell">Type</th>
                        <th class="sortable d-none d-md-table-cell">Category</th>
                        <th class="sortable d-none d-lg-table-cell">SKU</th>
                        <th class="sortable d-none d-lg-table-cell">Location</th>
                        <th class="text-end sortable d-none d-lg-table-cell">Qty</th>
                        <th class="text-end sortable">Available</th>
                        <th class="text-end sortable d-none d-lg-table-cell">Min</th>
                        <th class="sortable d-none d-md-table-cell">Expiry</th>
                        <th class="sortable">Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="inv-tbody">
                    @foreach (var item in Model.Items)
                    {
                        <tr class="inventory-row" data-item-id="@item.Id" style="cursor:pointer"
                            data-search="@item.Name @(item.SKU ?? "") @(item.Location ?? "") @(item.CategoryName ?? "")">
                            <td class="fw-semibold">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="cell-truncate" title="@item.Name">@item.Name</span>
                                    @if (Model.HazmatEnabled && Model.ItemPictograms.TryGetValue(item.Id, out var pics))
                                    {
                                        foreach (var p in pics)
                                        {
                                            var img = InventoryStore.App.Modules.GhsPictograms.ImagePath(p);
                                            if (img is not null)
                                            {
                                                <img src="@img" alt="@p" title="@p" width="22" height="22" class="ghs-pictogram" />
                                            }
                                        }
                                    }
                                </div>
                            </td>
                            <td class="d-none d-md-table-cell">
                                @if (item.ItemType == InventoryStore.Domain.Enums.ItemType.Reusable)
                                {
                                    <span class="badge bg-info">Reusable</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Consumable</span>
                                }
                            </td>
                            <td class="text-muted small d-none d-md-table-cell">
                                @if (item.CategoryName is not null)
                                {
                                    <span class="badge bg-light text-dark border">@item.CategoryName</span>
                                }
                                else { <text>-</text> }
                            </td>
                            <td class="text-muted small d-none d-lg-table-cell">@(item.SKU ?? "-")</td>
                            <td class="text-muted small d-none d-lg-table-cell">@(item.Location ?? "-")</td>
                            <td class="text-end d-none d-lg-table-cell">@item.Quantity</td>
                            <td class="text-end">@item.AvailableQuantity</td>
                            <td class="text-end text-muted d-none d-lg-table-cell">@item.MinimumQuantity</td>
                            <td class="text-muted small text-nowrap d-none d-md-table-cell">
                                @{
                                    var today = DateOnly.FromDateTime(DateTime.Today);
                                    if (item.ExpiryDate.HasValue)
                                    {
                                        var daysLeft = item.ExpiryDate.Value.DayNumber - today.DayNumber;
                                        if (daysLeft < 0)
                                        {
                                            <span class="badge bg-danger">Expired</span>
                                        }
                                        else if (daysLeft <= 30)
                                        {
                                            <span class="badge bg-warning text-dark">Exp @item.ExpiryDate.Value.ToString("MMM d")</span>
                                        }
                                        else
                                        {
                                            <text>@item.ExpiryDate.Value.ToString("MMM d, yyyy")</text>
                                        }
                                    }
                                    else { <text>-</text> }
                                }
                            </td>
                            <td>
                                @if (item.IsLowStock)
                                {
                                    <span class="badge bg-warning text-dark">Low Stock</span>
                                }
                                else if (item.LostCount > 0)
                                {
                                    <span class="badge bg-danger">Lost</span>
                                }
                                else if (item.CheckedOutCount > 0)
                                {
                                    <span class="badge bg-info text-dark">Out</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">OK</span>
                                }
                            </td>
                                @if (canWrite)
                            {
                                <td class="text-end" onclick="event.stopPropagation()">
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-item-id="@item.Id" data-item-name="@item.Name"
                                            onclick="confirmDelete(this)"
                                            title="Delete @item.Name"
                                            aria-label="Delete @item.Name">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex align-items-center justify-content-between px-3 py-2 border-top small text-muted" id="inv-pg-bar">
            <span id="inv-pg-range"></span>
            <div class="d-flex align-items-center gap-1">
                <select class="form-select form-select-sm py-0" style="width:auto" onchange="pgSz('inv-pg',this.value)">
                    <option value="5">5 / page</option>
                    <option value="10" selected>10 / page</option>
                    <option value="50">50 / page</option>
                    <option value="100">100 / page</option>
                </select>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" id="inv-pg-prev" onclick="pgGo('inv-pg',-1)">&#8249;</button>
                <span class="px-1" id="inv-pg-lbl"></span>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" id="inv-pg-next" onclick="pgGo('inv-pg',1)">&#8250;</button>
            </div>
        </div>
    </div>
    <div class="text-muted small mt-2 d-flex align-items-center gap-2">
        @if (Model.IsFiltered && Model.Items.Count() != Model.TotalCount)
        {
            <span>Showing <strong>@Model.Items.Count()</strong> of <strong>@Model.TotalCount</strong> items</span>
            <a href="/Inventory" class="badge bg-secondary text-decoration-none">
                <i class="bi bi-x me-1"></i>Clear filters
            </a>
        }
        else
        {
            <span>@Model.Items.Count() item@(Model.Items.Count() == 1 ? "" : "s")</span>
        }
    </div>
}

@if (canWrite)
{
<!-- Import CSV modal -->
<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-upload me-2"></i>Import from CSV</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="ImportCsv" enctype="multipart/form-data">
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        CSV columns (header row required):<br/>
                        <code>Type, Name, Quantity, MinimumQuantity, SKU, Location, Category, Description, ScanWarning</code><br/>
                        Type must be <strong>Consumable</strong> or <strong>Reusable</strong>. Categories are created automatically if they don't exist.
                    </p>
                    <div class="mb-3">
                        <label class="form-label">CSV File <span class="text-danger">*</span></label>
                        <input type="file" name="csvFile" class="form-control" accept=".csv,text/csv" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Item modal -->
<div class="modal fade" id="addItemModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-lg me-2"></i>Add Inventory Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="add-alert" class="alert d-none mb-3" role="alert"></div>
                <div id="add-loading" class="text-center py-4 d-none">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
                <div id="add-form">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Name <span class="text-danger">*</span></label>
                            <input type="text" id="add-name" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Item Type <span class="text-danger">*</span></label>
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <input class="btn-check" type="radio" name="add-item-type" id="add-type-consumable" value="Consumable" checked autocomplete="off" onchange="applyAddItemType()" />
                                    <label class="type-option" for="add-type-consumable">
                                        <i class="bi bi-box"></i>
                                        <div>
                                            <div class="fw-semibold">Consumable</div>
                                            <div class="text-muted small">Stock is depleted when used</div>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-sm-6">
                                    <input class="btn-check" type="radio" name="add-item-type" id="add-type-reusable" value="Reusable" autocomplete="off" onchange="applyAddItemType()" />
                                    <label class="type-option" for="add-type-reusable">
                                        <i class="bi bi-arrow-repeat"></i>
                                        <div>
                                            <div class="fw-semibold">Reusable</div>
                                            <div class="text-muted small">Checked out and returned</div>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" id="add-quantity-label">In Stock <span class="text-danger">*</span></label>
                            <input type="number" id="add-quantity" class="form-control" value="0" min="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Minimum Quantity <span class="text-muted small">(low-stock alert)</span></label>
                            <input type="number" id="add-min-quantity" class="form-control" value="0" min="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">SKU / Barcode</label>
                            <div class="input-group">
                                <input type="text" id="add-sku" class="form-control" placeholder="Scan or type" />
                                <button type="button" class="btn btn-outline-secondary" id="add-sku-scan-btn" title="Scan barcode">
                                    <i class="bi bi-upc-scan"></i>
                                </button>
                            </div>
                            <div id="add-sku-scanner-area" class="mt-2 d-none">
                                <div id="add-sku-scanner-viewport" class="scanner-viewport">
                                    <video id="add-sku-scanner-video" autoplay muted playsinline></video>
                                    <div class="scanner-aim"></div>
                                </div>
                                <div class="d-flex gap-2 mt-1">
                                    <small class="text-muted flex-grow-1" id="add-sku-scan-hint">Align barcode with the red line</small>
                                    <button type="button" class="btn btn-sm btn-outline-danger" id="add-sku-scan-cancel">Cancel</button>
                                </div>
                            </div>
                            <input type="file" id="add-sku-capture-input" accept="image/*" capture="environment" class="d-none" />
                            <div class="mt-1 d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        onclick="openUpcLookup('add-sku','add-name','add-is-matched','add-metadata-source','add-match-badge')">
                                    <i class="bi bi-search me-1"></i>Lookup Product
                                </button>
                                <span id="add-match-badge" class="badge d-none"></span>
                            </div>
                            <input type="hidden" id="add-is-matched" value="false" />
                            <input type="hidden" id="add-metadata-source" value="" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Location</label>
                            <input type="text" id="add-location" class="form-control" placeholder="e.g. Shelf A3, Bin 12"
                                   list="add-location-list" autocomplete="off" />
                            <datalist id="add-location-list"></datalist>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Category</label>
                            <div class="d-flex gap-2">
                                <select id="add-category" class="form-select"></select>
                                <button type="button" class="btn btn-outline-secondary" id="add-new-cat-btn" title="Create new category">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                            <div id="add-new-cat-form" class="mt-2 border rounded p-2 d-none">
                                <div class="mb-2">
                                    <label class="form-label small mb-1">Name <span class="text-danger">*</span></label>
                                    <input type="text" id="add-new-cat-name" class="form-control form-control-sm" placeholder="Category name" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small mb-1">Color <span class="text-muted small">(optional)</span></label>
                                    <input type="hidden" id="add-new-cat-color" value="" />
                                    <div class="d-flex flex-wrap gap-1" id="add-new-cat-swatches"></div>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-primary" id="add-new-cat-save">Create</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="add-new-cat-cancel">Cancel</button>
                                </div>
                                <div id="add-new-cat-error" class="text-danger small mt-1 d-none"></div>
                            </div>
                        </div>
                        <div class="col-md-6" id="add-expiry-col">
                            <label class="form-label">Expiry Date <span class="text-muted small">(optional)</span></label>
                            <input type="date" id="add-expiry" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Scan Warning <span class="text-muted small">(shown when this item is scanned)</span></label>
                            <input type="text" id="add-scan-warning" class="form-control" placeholder="e.g. Requires PPE, Handle with care" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <textarea id="add-description" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-12 d-none" id="add-sds-section">
                            <hr class="my-1" />
                            <label class="form-label">Safety Data Sheet <span class="text-muted small">(optional)</span></label>
                            <div class="input-group">
                                <input type="text" id="add-sds-name" class="form-control" placeholder="Chemical name, e.g. Acetone" />
                                <button type="button" class="btn btn-outline-warning" id="add-sds-lookup-btn" onclick="lookupAddSds()">
                                    <i class="bi bi-eyedropper me-1"></i>Look up SDS
                                </button>
                            </div>
                            <div class="form-text">Searches PubChem; the hazard data is attached to the item when you save.</div>
                            <div id="add-sds-status" class="small mb-1"></div>
                            <div id="add-sds-result"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="add-save-btn" onclick="saveAddItem()">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Metadata explorer modal -->
<div class="modal fade" id="metadataExplorerModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-database me-2"></i>Product Metadata</h5>
                <div class="ms-auto d-flex gap-2 align-items-center">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="loadMetadataExplorer()" title="Reload list">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body">
                <p class="text-muted small">
                    Cached product info fetched from barcode lookups. <strong>Refresh</strong> re-fetches from the source API;
                    <strong>delete</strong> unlinks it from any items and removes it from storage.
                </p>
                <div id="md-explorer-loading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
                <div id="md-explorer-empty" class="text-center py-5 text-muted d-none">
                    <i class="bi bi-database display-6 d-block mb-2 opacity-50"></i>
                    No stored metadata yet. It is created automatically when you look up a barcode.
                </div>
                <div id="md-explorer-error" class="alert alert-danger d-none"></div>
                <div id="md-explorer-table-wrap" class="table-responsive d-none">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:96px"></th>
                                <th style="width:48px"></th>
                                <th>Barcode</th>
                                <th>Source</th>
                                <th>Name</th>
                                <th>Brand</th>
                                <th>Category</th>
                                <th>Size</th>
                                <th>Weight</th>
                                <th class="text-end">Linked</th>
                                <th class="text-nowrap">Fetched</th>
                            </tr>
                        </thead>
                        <tbody id="md-explorer-tbody"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete confirmation modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Delete <strong id="deleteItemName"></strong>? This cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Delete" id="deleteForm">
                    <input type="hidden" name="id" id="deleteItemId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
} @* end canWrite *@

@await Html.PartialAsync("_SkuScannerScript")

@section Scripts {
<script>
initSkuScanner('add-sku', 'add-sku-scan-btn', 'add-sku-scan-cancel', 'add-sku-scanner-area',
               'add-sku-scanner-viewport', 'add-sku-scanner-video',
               'add-sku-capture-input', 'add-sku-scan-hint');
</script>
<script>
(function () {
    var table = document.querySelector('.table');
    if (!table) return;
    var headers = Array.from(table.querySelectorAll('thead th'));
    var sortState = { col: -1, asc: true };

    headers.forEach(function (th, i) {
        if (!th.classList.contains('sortable')) return;
        th.addEventListener('click', function () {
            if (sortState.col === i) { sortState.asc = !sortState.asc; }
            else { sortState.col = i; sortState.asc = true; }
            headers.forEach(function (h) { h.classList.remove('sort-asc', 'sort-desc'); });
            th.classList.add(sortState.asc ? 'sort-asc' : 'sort-desc');
            var tbody = table.querySelector('tbody');
            var rows = Array.from(tbody.querySelectorAll('tr'));
            rows.sort(function (a, b) {
                var aVal = (a.cells[i] ? a.cells[i].textContent.trim() : '');
                var bVal = (b.cells[i] ? b.cells[i].textContent.trim() : '');
                var aNum = parseFloat(aVal), bNum = parseFloat(bVal);
                if (!isNaN(aNum) && !isNaN(bNum)) return sortState.asc ? aNum - bNum : bNum - aNum;
                return sortState.asc ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
            });
            rows.forEach(function (row) { tbody.appendChild(row); });
            if (typeof pgRedraw === 'function') pgRedraw('inv-pg');
        });
    });
})();
document.addEventListener('DOMContentLoaded', function() { pgInit('inv-pg', 'inv-tbody', 10); });

function confirmDelete(btn) {
    document.getElementById('deleteItemId').value = btn.dataset.itemId;
    document.getElementById('deleteItemName').textContent = btn.dataset.itemName;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}
@if (Model.Open.HasValue)
{
    <text>document.addEventListener('DOMContentLoaded', () => openItemModal(@Model.Open.Value));</text>
}
</script>
<script>
// ── Add Item Modal ────────────────────────────────────────────────────────────
var _addItemModal = null;
var _addSdsName = null;   // confirmed chemical name to attach to the new item on save (SDS module)

// Preview an SDS lookup in the Add modal (the item does not exist yet, so itemId=0 = no save).
async function lookupAddSds() {
    var nameField = document.getElementById('add-sds-name');
    var name = (nameField.value || '').trim();
    if (!name) { name = document.getElementById('add-name').value.trim(); nameField.value = name; }
    var status = document.getElementById('add-sds-status');
    var result = document.getElementById('add-sds-result');
    var btn = document.getElementById('add-sds-lookup-btn');
    _addSdsName = null;
    result.innerHTML = '';
    if (!name) { status.innerHTML = '<span class="text-danger">Enter a chemical name first.</span>'; return; }
    btn.disabled = true;
    status.innerHTML = '<span class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Searching PubChem…</span>';
    try {
        var res = await fetch('/api/sds/lookup?itemId=0&name=' + encodeURIComponent(name));
        if (!res.ok) { status.innerHTML = '<span class="text-danger">Lookup failed.</span>'; return; }
        var data = await res.json();
        if (!data.success) {
            var html = '<span class="text-warning">' + escHtml(data.error || 'No data found.') + '</span>';
            if (data.suggestions && data.suggestions.length) {
                html += '<div class="mt-1"><span class="text-muted">Did you mean:</span> ' +
                    data.suggestions.map(function (s) {
                        return '<button type="button" class="btn btn-sm btn-outline-secondary me-1 mb-1" data-name="' + escHtml(s) + '" onclick="addSdsSuggest(this.dataset.name)">' + escHtml(s) + '</button>';
                    }).join('') + '</div>';
            } else {
                html += '<div class="text-muted small mt-1">Try a chemical name rather than a brand or product name.</div>';
            }
            status.innerHTML = html;
            return;
        }
        _addSdsName = name;
        status.innerHTML = '<span class="text-success"><i class="bi bi-check-lg me-1"></i>Found. Will attach when you save.</span>';
        result.innerHTML = (data.sheets || []).map(sdsCardHtml).join('');
    } catch {
        status.innerHTML = '<span class="text-danger">Network error.</span>';
    } finally { btn.disabled = false; }
}

function addSdsSuggest(name) {
    document.getElementById('add-sds-name').value = name;
    lookupAddSds();
}

async function openAddItemModal() {
    if (!_addItemModal) _addItemModal = new bootstrap.Modal(document.getElementById('addItemModal'));
    // Reset form
    document.getElementById('add-name').value = '';
    document.getElementById('add-quantity').value = '0';
    document.getElementById('add-min-quantity').value = '0';
    document.getElementById('add-sku').value = '';
    document.getElementById('add-location').value = '';
    document.getElementById('add-expiry').value = '';
    document.getElementById('add-scan-warning').value = '';
    document.getElementById('add-description').value = '';
    document.getElementById('add-type-consumable').checked = true;
    applyAddItemType();
    document.getElementById('add-alert').classList.add('d-none');

    // SDS ("hazmat") module: show the optional SDS lookup in the Add modal.
    _addSdsName = null;
    var addSdsSection = document.getElementById('add-sds-section');
    if (addSdsSection) {
        var sdsOn = window.modules && window.modules.sds;
        addSdsSection.classList.toggle('d-none', !sdsOn);
        document.getElementById('add-sds-name').value = '';
        document.getElementById('add-sds-status').innerHTML = '';
        document.getElementById('add-sds-result').innerHTML = '';
    }

    // Load categories and locations
    try {
        const res = await fetch('/Inventory?handler=AddItemData');
        if (res.ok) {
            const data = await res.json();
            const sel = document.getElementById('add-category');
            sel.innerHTML = '<option value="">— None —</option>' +
                (data.categories || []).map(c => `<option value="${c.id}">${escHtml(c.name)}</option>`).join('');
            const dl = document.getElementById('add-location-list');
            dl.innerHTML = (data.locations || []).map(l => `<option value="${escHtml(l)}"></option>`).join('');
            initAddCatSwatches(data.categories || []);
        } else {
            const alertEl = document.getElementById('add-alert');
            alertEl.className = 'alert alert-warning mb-3';
            alertEl.textContent = 'Could not load categories. You can still save the item.';
            alertEl.classList.remove('d-none');
        }
    } catch {
        const alertEl = document.getElementById('add-alert');
        alertEl.className = 'alert alert-warning mb-3';
        alertEl.textContent = 'Could not load categories. You can still save the item.';
        alertEl.classList.remove('d-none');
    }

    _addItemModal.show();
    setTimeout(() => document.getElementById('add-name').focus(), 300);
}

// Show only the fields relevant to the chosen item type.
function applyAddItemType() {
    var isReusable = document.getElementById('add-type-reusable').checked;
    document.getElementById('add-quantity-label').innerHTML =
        (isReusable ? 'Total Quantity' : 'In Stock') + ' <span class="text-danger">*</span>';
    document.getElementById('add-expiry-col').classList.toggle('d-none', isReusable);
}

function initAddCatSwatches() {
    const colors = ['','#0d6efd','#198754','#dc3545','#ffc107','#fd7e14','#6f42c1','#d63384','#0dcaf0','#20c997','#6c757d','#212529'];
    const container = document.getElementById('add-new-cat-swatches');
    container.innerHTML = colors.map(c => {
        const bg = c || '#f8f9fa';
        const border = c ? 'transparent' : '#dee2e6';
        return `<button type="button" class="swatch-btn" data-color="${c}"
            style="width:28px;height:28px;border-radius:4px;background:${bg};border:2px solid ${border};"
            onclick="selectAddSwatch(this)"></button>`;
    }).join('');
}

function selectAddSwatch(btn) {
    const color = btn.dataset.color || '';
    document.getElementById('add-new-cat-color').value = color;
    document.querySelectorAll('#add-new-cat-swatches .swatch-btn').forEach(b => {
        const match = (b.dataset.color || '') === color;
        b.style.border = match ? '2px solid #000' : (b.dataset.color === '' ? '2px solid #dee2e6' : '2px solid transparent');
    });
}

(function() {
    document.getElementById('add-new-cat-btn').addEventListener('click', function() {
        var f = document.getElementById('add-new-cat-form');
        f.classList.toggle('d-none');
        if (!f.classList.contains('d-none')) document.getElementById('add-new-cat-name').focus();
    });
    document.getElementById('add-new-cat-cancel').addEventListener('click', function() {
        document.getElementById('add-new-cat-form').classList.add('d-none');
        document.getElementById('add-new-cat-name').value = '';
        document.getElementById('add-new-cat-color').value = '';
        document.getElementById('add-new-cat-error').classList.add('d-none');
    });
    document.getElementById('add-new-cat-name').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); document.getElementById('add-new-cat-save').click(); }
    });
    document.getElementById('add-new-cat-save').addEventListener('click', async function() {
        var name = document.getElementById('add-new-cat-name').value.trim();
        var color = document.getElementById('add-new-cat-color').value;
        var errEl = document.getElementById('add-new-cat-error');
        if (!name) { errEl.textContent = 'Name is required.'; errEl.classList.remove('d-none'); return; }
        this.disabled = true;
        errEl.classList.add('d-none');
        try {
            var token = document.getElementById('af-token').value;
            var res = await fetch('/Inventory?handler=CreateCategory', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ name, color, __RequestVerificationToken: token }).toString()
            });
            if (res.ok) {
                var cat = await res.json();
                var sel = document.getElementById('add-category');
                sel.appendChild(new Option(cat.name, cat.id, true, true));
                sel.value = cat.id;
                document.getElementById('add-new-cat-form').classList.add('d-none');
                document.getElementById('add-new-cat-name').value = '';
                document.getElementById('add-new-cat-color').value = '';
            } else {
                errEl.textContent = await res.text() || 'Failed to create category.';
                errEl.classList.remove('d-none');
            }
        } catch { errEl.textContent = 'Network error.'; errEl.classList.remove('d-none'); }
        finally { this.disabled = false; }
    });
}());

async function saveAddItem() {
    const name = document.getElementById('add-name').value.trim();
    const alertEl = document.getElementById('add-alert');
    if (!name) {
        alertEl.className = 'alert alert-warning mb-3';
        alertEl.textContent = 'Name is required.';
        alertEl.classList.remove('d-none');
        document.getElementById('add-name').focus();
        return;
    }
    const btn = document.getElementById('add-save-btn');
    btn.disabled = true;
    alertEl.classList.add('d-none');
    try {
        var token = document.getElementById('af-token').value;
        var params = {
            name,
            quantity: document.getElementById('add-quantity').value,
            minimumQuantity: document.getElementById('add-min-quantity').value,
            itemType: document.querySelector('input[name="add-item-type"]:checked').value,
            sku: document.getElementById('add-sku').value.trim(),
            location: document.getElementById('add-location').value.trim(),
            categoryId: document.getElementById('add-category').value || '',
            expiryDate: document.getElementById('add-expiry').value,
            scanWarning: document.getElementById('add-scan-warning').value.trim(),
            description: document.getElementById('add-description').value.trim(),
            __RequestVerificationToken: token
        };
        const res = await fetch('/Inventory?handler=CreateItem', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(params).toString()
        });
        const data = await res.json();
        if (data.success) {
            // Attach the previewed SDS data to the freshly created item (SDS module).
            if (window.modules && window.modules.sds && _addSdsName && data.id) {
                try {
                    await fetch('/api/sds/lookup?itemId=' + data.id + '&name=' + encodeURIComponent(_addSdsName));
                } catch {}
            }
            _addItemModal.hide();
            showFlashToast('Item added.');
            location.reload();
        } else {
            alertEl.className = 'alert alert-danger mb-3';
            alertEl.textContent = data.error || 'Failed to save item.';
            alertEl.classList.remove('d-none');
        }
    } catch {
        alertEl.className = 'alert alert-danger mb-3';
        alertEl.textContent = 'Network error. Please try again.';
        alertEl.classList.remove('d-none');
    } finally { btn.disabled = false; }
}

// ── Live row filtering ───────────────────────────────────────────────────────
(function() {
    var _filterTimer;
    window.filterInventoryRows = function(val) {
        clearTimeout(_filterTimer);
        _filterTimer = setTimeout(function() {
            var q = (val || '').toLowerCase().trim();
            pgFilter('inv-pg', q ? function(row) {
                var search = (row.dataset.search || row.textContent).toLowerCase();
                return search.includes(q);
            } : null);
        }, 120);
    };
}());

// ── Metadata explorer ─────────────────────────────────────────────────────────
var _mdExplorerModal = null;
var _mdSourceLabels = { 'openlibrary': 'Open Library', 'upcitemdb': 'UPC Item DB', 'openfoodfacts': 'Open Food Facts' };

function openMetadataExplorer() {
    if (!_mdExplorerModal) _mdExplorerModal = new bootstrap.Modal(document.getElementById('metadataExplorerModal'));
    _mdExplorerModal.show();
    loadMetadataExplorer();
}

async function loadMetadataExplorer() {
    var loading = document.getElementById('md-explorer-loading');
    var empty   = document.getElementById('md-explorer-empty');
    var errEl   = document.getElementById('md-explorer-error');
    var wrap    = document.getElementById('md-explorer-table-wrap');
    loading.classList.remove('d-none');
    empty.classList.add('d-none');
    errEl.classList.add('d-none');
    wrap.classList.add('d-none');
    try {
        var res = await fetch('/api/metadata');
        if (!res.ok) throw new Error('Failed to load');
        var rows = await res.json();
        loading.classList.add('d-none');
        if (!rows.length) { empty.classList.remove('d-none'); return; }
        document.getElementById('md-explorer-tbody').innerHTML = rows.map(mdRowHtml).join('');
        wrap.classList.remove('d-none');
    } catch {
        loading.classList.add('d-none');
        errEl.textContent = 'Could not load metadata.';
        errEl.classList.remove('d-none');
    }
}

function mdRowHtml(r) {
    var label = _mdSourceLabels[r.source] || r.source;
    var img = r.imageUrl
        ? `<img src="${escHtml(r.imageUrl)}" alt="" style="width:36px;height:36px;object-fit:contain;border-radius:4px" onerror="this.style.display='none'">`
        : '<i class="bi bi-image text-muted opacity-50"></i>';
    var fetched = r.fetchedAt ? new Date(r.fetchedAt).toLocaleDateString() : '-';
    return `<tr id="md-row-${r.id}">
        <td class="text-nowrap">
            <button class="btn btn-sm btn-outline-primary" title="Refresh from source" onclick="mdRefresh(this)" data-id="${r.id}"><i class="bi bi-arrow-clockwise"></i></button>
            <button class="btn btn-sm btn-outline-danger" title="Delete" onclick="mdDelete(this)" data-id="${r.id}" data-name="${escHtml(r.name || '')}"><i class="bi bi-trash"></i></button>
        </td>
        <td>${img}</td>
        <td class="text-muted small text-nowrap">${escHtml(r.barcode || '-')}</td>
        <td><span class="badge bg-secondary">${escHtml(label)}</span></td>
        <td class="md-cell-name">${escHtml(r.name || '-')}</td>
        <td class="md-cell-brand small">${escHtml(r.brand || '-')}</td>
        <td class="md-cell-category small">${escHtml(r.category || '-')}</td>
        <td class="md-cell-size small">${escHtml(r.size || '-')}</td>
        <td class="md-cell-weight small">${escHtml(r.weight || '-')}</td>
        <td class="text-end">${r.linkedCount > 0 ? `<span class="badge bg-info text-dark">${r.linkedCount}</span>` : '<span class="text-muted">0</span>'}</td>
        <td class="text-muted small text-nowrap">${escHtml(fetched)}</td>
    </tr>`;
}

async function mdRefresh(btn) {
    var id = btn.dataset.id;
    var icon = btn.querySelector('i');
    btn.disabled = true;
    icon.classList.add('spin');
    try {
        var res = await fetch(`/api/metadata/${id}/refresh`, { method: 'POST' });
        var data = await res.json();
        if (data.success && data.item) {
            var tr = document.getElementById('md-row-' + id);
            if (tr) tr.outerHTML = mdRowHtml(data.item);
            showFlashToast('Metadata refreshed.');
        } else {
            showFlashToast(data.error || 'No data returned from the source.');
            btn.disabled = false;
            icon.classList.remove('spin');
        }
    } catch {
        showFlashToast('Refresh failed.');
        btn.disabled = false;
        icon.classList.remove('spin');
    }
}

// Two-step inline confirm so deletes never need a stacked modal.
function mdDelete(btn) {
    if (btn.dataset.armed !== '1') {
        btn.dataset.armed = '1';
        btn.classList.remove('btn-outline-danger');
        btn.classList.add('btn-danger');
        btn.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Confirm';
        btn._resetTimer = setTimeout(function () { mdDeleteReset(btn); }, 4000);
        return;
    }
    clearTimeout(btn._resetTimer);
    mdDoDelete(btn);
}

function mdDeleteReset(btn) {
    btn.dataset.armed = '';
    btn.classList.add('btn-outline-danger');
    btn.classList.remove('btn-danger');
    btn.innerHTML = '<i class="bi bi-trash"></i>';
}

async function mdDoDelete(btn) {
    var id = btn.dataset.id;
    btn.disabled = true;
    try {
        var res = await fetch(`/api/metadata/${id}/delete`, { method: 'POST' });
        var data = await res.json();
        if (data.success) {
            var tr = document.getElementById('md-row-' + id);
            if (tr) tr.remove();
            var msg = data.unlinked > 0 ? `Deleted. Unlinked from ${data.unlinked} item(s).` : 'Deleted.';
            showFlashToast(msg);
            if (!document.querySelectorAll('#md-explorer-tbody tr').length) {
                document.getElementById('md-explorer-table-wrap').classList.add('d-none');
                document.getElementById('md-explorer-empty').classList.remove('d-none');
            }
        } else {
            showFlashToast(data.error || 'Delete failed.');
            btn.disabled = false;
            mdDeleteReset(btn);
        }
    } catch {
        showFlashToast('Delete failed.');
        btn.disabled = false;
        mdDeleteReset(btn);
    }
}
</script>
}

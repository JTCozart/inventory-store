@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject InventoryStore.App.Services.UpdateInfo UpdateInfo
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Store</title>
    <script>(function(){var t=localStorage.getItem('it-theme');if(t)document.documentElement.setAttribute('data-bs-theme',t);}())</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div id="app-wrapper">
        <header id="topnav">
            <a href="/" class="topnav-brand">
                <i class="bi bi-box-seam"></i>
                <span>Inventory Store</span>
            </a>
            <div id="topnav-links">
                <a href="/" class="topnav-link @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a href="/Inventory" class="topnav-link @(ViewData["ActivePage"]?.ToString() == "Inventory" ? "active" : "")">
                    <i class="bi bi-boxes"></i> Inventory
                </a>
                <a href="/Clients" class="topnav-link @(ViewData["ActivePage"]?.ToString() == "Clients" ? "active" : "")">
                    <i class="bi bi-people"></i> Clients
                </a>
                <a href="/Reports" class="topnav-link @(ViewData["ActivePage"]?.ToString() == "Reports" ? "active" : "")">
                    <i class="bi bi-bar-chart"></i> Reports
                </a>
                <a href="/Settings" class="topnav-link @(ViewData["ActivePage"]?.ToString() == "Settings" ? "active" : "")">
                    <i class="bi bi-sliders"></i> Settings
                </a>
            </div>
            <div class="topnav-sep"></div>
            @if (UpdateInfo.HasUpdate)
            {
                <a href="@UpdateInfo.ReleaseUrl" target="_blank" class="topnav-btn text-decoration-none"
                   style="color:#0dcaf0; font-size:.8rem; display:flex; align-items:center; gap:.3rem;" title="v@(UpdateInfo.LatestVersion) available">
                    <i class="bi bi-arrow-up-circle-fill"></i>
                    <span class="d-none d-lg-inline">v@(UpdateInfo.LatestVersion)</span>
                </a>
            }
            <a href="/UserGuide" class="topnav-btn @(ViewData["ActivePage"]?.ToString() == "UserGuide" ? "active" : "")" title="User Guide" style="text-decoration:none; display:flex; align-items:center;">
                <i class="bi bi-book"></i>
            </a>
            <button id="theme-toggle" class="topnav-btn" onclick="toggleTheme()" title="Toggle theme">
                <i id="theme-icon" class="bi bi-moon"></i>
            </button>
            <div class="topnav-divider"></div>
            <button class="topnav-btn" onclick="quickScan()" title="Quick Scan">
                <i class="bi bi-upc-scan"></i>
            </button>
            <div class="topnav-divider"></div>
            <div class="dropdown">
                <button class="topnav-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="User menu">
                    <i class="bi bi-person-circle"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><span class="dropdown-header">@System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase((User.Identity?.Name ?? "").ToLower())</span></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="/Settings?tab=account"><i class="bi bi-person me-2"></i>My Account</a></li>
                    <li><form method="post" asp-page="/Auth/Logout" class="d-inline w-100">
                        <button type="submit" class="dropdown-item w-100 text-start"><i class="bi bi-box-arrow-left me-2"></i>Logout</button>
                    </form></li>
                </ul>
            </div>
            <button id="topnav-toggle" aria-label="Open menu" onclick="toggleMobileNav()">
                <i class="bi bi-list"></i>
            </button>
        </header>

        <div id="mobile-nav">
            <a href="/" class="@(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a href="/Inventory" class="@(ViewData["ActivePage"]?.ToString() == "Inventory" ? "active" : "")">
                <i class="bi bi-boxes"></i> Inventory
            </a>
            <a href="/Clients" class="@(ViewData["ActivePage"]?.ToString() == "Clients" ? "active" : "")">
                <i class="bi bi-people"></i> Clients
            </a>
            <a href="/Reports" class="@(ViewData["ActivePage"]?.ToString() == "Reports" ? "active" : "")">
                <i class="bi bi-bar-chart"></i> Reports
            </a>
            <a href="/Settings" class="@(ViewData["ActivePage"]?.ToString() == "Settings" ? "active" : "")">
                <i class="bi bi-sliders"></i> Settings
            </a>
            <a href="/UserGuide" class="@(ViewData["ActivePage"]?.ToString() == "UserGuide" ? "active" : "")">
                <i class="bi bi-book"></i> User Guide
            </a>
            <a href="#" onclick="toggleMobileNav(); quickScan(); return false;">
                <i class="bi bi-upc-scan"></i> Quick Scan
            </a>
            <a href="#" onclick="toggleTheme(); return false;">
                <i id="mobile-theme-icon" class="bi bi-moon"></i> Toggle Theme
            </a>
        </div>

        <div id="content-wrapper">
            <main class="flex-grow-1 p-3 p-md-4">
                @RenderBody()
            </main>
            <footer class="py-2 px-4 text-muted small border-top">
                Inventory Store &copy; @DateTime.Now.Year
            </footer>
        </div>
    </div>
}
else
{
    <main class="container-fluid">
        @RenderBody()
    </main>
}

<div id="toast-container" class="position-fixed bottom-0 end-0 p-3" style="z-index:1200"></div>
<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
@if (User.Identity?.IsAuthenticated == true)
{
    var _canWrite = User.IsInRole("Admin") || User.IsInRole("Manager");
    <text>
    <input type="hidden" id="af-token" value="@Antiforgery.GetAndStoreTokens(Context).RequestToken">

    <!-- Global item detail modal -->
    <div class="modal fade" id="itemDetailModal" tabindex="-1" data-can-write="@(_canWrite ? "1" : "0")">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <div>
              <span class="fw-semibold fs-5" id="modal-item-name">Loading...</span>
              <span id="modal-type-badge" class="badge ms-2"></span>
              <span id="modal-stock-badge" class="badge bg-warning text-dark ms-1 d-none">Low Stock</span>
            </div>
            <div class="d-flex gap-2 align-items-center ms-auto">
              <a id="btn-switch-edit" class="btn btn-sm btn-outline-primary d-none" href="#">
                <i class="bi bi-pencil me-1"></i>Edit
              </a>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
          </div>
          <div id="modal-view-body" class="modal-body">
            <div id="modal-alert" class="alert d-none mb-3" role="alert"></div>
            <div id="modal-loading">
              <div class="row g-2 mb-4">
                <div class="col"><div class="skeleton-block" style="height:62px"></div></div>
                <div class="col"><div class="skeleton-block" style="height:62px"></div></div>
                <div class="col"><div class="skeleton-block" style="height:62px"></div></div>
                <div class="col"><div class="skeleton-block" style="height:62px"></div></div>
                <div class="col"><div class="skeleton-block" style="height:62px"></div></div>
              </div>
              <div class="skeleton-block mb-2" style="height:14px;width:55%"></div>
              <div class="skeleton-block mb-4" style="height:14px;width:38%"></div>
              <div class="skeleton-block mb-3" style="height:1px"></div>
              <div class="skeleton-block mb-2" style="height:14px;width:25%"></div>
              <div class="skeleton-block" style="height:56px"></div>
            </div>
            <div id="modal-content" class="d-none">
              <div id="modal-warning-banner" class="alert alert-warning d-none d-flex align-items-start gap-2 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                <div><strong>Warning:</strong> <span id="modal-warning-text"></span></div>
              </div>
              <div class="row g-3 mb-3 align-items-start">
                <div class="col-12 col-md-4 d-none" id="modal-image-col">
                  <img id="modal-item-image" src="" alt="Product image" class="img-fluid rounded border w-100"
                       style="max-height:200px;object-fit:contain;background:var(--bs-tertiary-bg)">
                  <button type="button" class="more-info-btn mt-2" onclick="showMetadataInfo()">
                    <i class="bi bi-info-circle me-1"></i>Product Details
                  </button>
                </div>
                <div class="col-12" id="modal-info-col">
                  <div id="modal-stats" class="d-flex flex-wrap gap-2 mb-3">
                    <div class="stat-cell text-center" id="stat-qty-col"><div class="stat-cell-value" id="modal-stat-qty">-</div><div class="stat-cell-label" id="modal-stat-qty-label">In Stock</div></div>
                    <div class="stat-cell text-center d-none" id="stat-available-col"><div class="stat-cell-value text-success" id="modal-stat-available">-</div><div class="stat-cell-label">Available</div></div>
                    <div class="stat-cell text-center d-none" id="stat-out-col"><div class="stat-cell-value text-warning" id="modal-stat-out">-</div><div class="stat-cell-label">Checked Out</div></div>
                    <div class="stat-cell text-center d-none" id="stat-lost-col"><div class="stat-cell-value text-danger" id="modal-stat-lost">-</div><div class="stat-cell-label">Lost</div></div>
                    <div class="stat-cell text-center" id="stat-min-col"><div class="stat-cell-value text-muted" id="modal-stat-min">-</div><div class="stat-cell-label">Min Qty</div></div>
                  </div>
                  <dl class="row mb-0 small">
                    <dt class="col-4 col-sm-3 text-muted fw-normal">Location</dt><dd class="col-8 col-sm-9 mb-1" id="modal-detail-location">-</dd>
                    <dt class="col-4 col-sm-3 text-muted fw-normal">SKU</dt><dd class="col-8 col-sm-9 mb-1" id="modal-detail-sku">-</dd>
                    <dt class="col-4 col-sm-3 text-muted fw-normal d-none" id="lbl-category">Category</dt><dd class="col-8 col-sm-9 mb-1 d-none" id="modal-detail-category"></dd>
                    <dt class="col-4 col-sm-3 text-muted fw-normal d-none" id="lbl-expiry">Expiry</dt><dd class="col-8 col-sm-9 mb-1 d-none" id="modal-detail-expiry"></dd>
                  </dl>
                </div>
              </div>
              <div id="modal-desc-block" class="mb-3 d-none">
                <div class="text-muted text-uppercase small fw-semibold mb-1">Description</div>
                <div id="modal-detail-desc"></div>
              </div>
              <hr>
              <div id="actions-reusable" class="d-none">
                <h6 class="fw-semibold mb-2">Active Checkouts</h6>
                <div id="active-checkouts-list" class="mb-3"></div>
                <div id="lost-checkouts-section" class="d-none mb-3">
                  <h6 class="fw-semibold mb-2 text-danger"><i class="bi bi-x-circle me-1"></i>Lost Items</h6>
                  <div id="lost-checkouts-list"></div>
                </div>
                @if (_canWrite)
                {
                  <h6 class="fw-semibold mb-2">Check Out</h6>
                  <div class="mb-2">
                    <label class="form-label small mb-1">Client</label>
                    <div class="position-relative">
                      <input type="text" id="co-by" class="form-control form-control-sm" placeholder="Search by name…" oninput="onCoClientInput()" autocomplete="off" />
                      <input type="hidden" id="co-client-id" />
                      <div id="co-client-dd" class="d-none position-absolute w-100 border rounded bg-body shadow-sm"
                           style="top:100%;z-index:1060;max-height:180px;overflow-y:auto;font-size:.875rem"></div>
                      <div id="co-client-err" class="text-danger small d-none mt-1">Please enter a name.</div>
                    </div>
                  </div>
                  <div class="row g-2 mb-1 align-items-end">
                    <div class="col-2"><label class="form-label small mb-1">Qty</label><input type="number" id="co-qty" class="form-control form-control-sm" value="1" min="1"></div>
                    <div class="col"><label class="form-label small mb-1">Notes</label><input type="text" id="co-notes" class="form-control form-control-sm" placeholder="Optional"></div>
                    <div class="col-auto"><button class="btn btn-sm btn-primary" onclick="handleCheckOut()"><i class="bi bi-box-arrow-up-right me-1"></i>Check Out</button></div>
                  </div>
                }
              </div>
              <div id="actions-consumable" class="d-none">
                @if (_canWrite)
                {
                  <h6 class="fw-semibold mb-2">Adjust Stock</h6>
                  <div class="d-flex gap-2 align-items-center flex-wrap">
                    <div class="input-group stock-stepper" style="width:150px">
                      <button class="btn btn-outline-danger" type="button" onclick="handleConsume()" title="Consume (use stock)"><i class="bi bi-dash-lg"></i></button>
                      <input type="number" id="adjust-qty" class="form-control text-center" value="1" min="1">
                      <button class="btn btn-outline-success" type="button" onclick="handleRestock()" title="Restock (add stock)"><i class="bi bi-plus-lg"></i></button>
                    </div>
                    <input type="text" id="adjust-notes" class="form-control" style="max-width:240px" placeholder="Notes (optional)">
                  </div>
                  <div class="form-text">Tap <span class="text-danger fw-semibold">−</span> to consume stock, <span class="text-success fw-semibold">+</span> to add stock.</div>
                }
              </div>
            </div>
          </div>
          <div class="modal-footer d-none" id="modal-view-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
    <script src="~/js/inventory-detail.js"></script>

    <!-- Edit item modal -->
    <div class="modal fade" id="editItemModal" tabindex="-1">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Edit Item</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div id="edit-alert" class="alert d-none mb-3" role="alert"></div>
            <div id="edit-loading" class="text-center py-4">
              <div class="spinner-border text-primary" role="status"></div>
            </div>
            <div id="edit-form" class="d-none">
              <div class="mb-3" id="edit-type-display"></div>
              <h6 class="text-uppercase text-muted small fw-semibold mb-2">Basics</h6>
              <div class="row g-3 mb-2">
                <div class="col-12">
                  <label class="form-label">Name <span class="text-danger">*</span></label>
                  <input type="text" id="edit-name" class="form-control" />
                </div>
                <div class="col-md-6">
                  <label class="form-label" id="edit-quantity-label">Total Quantity</label>
                  <input type="number" id="edit-quantity" class="form-control" min="0" />
                  <div class="form-text d-none" id="edit-quantity-help"></div>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Minimum Quantity <span class="text-muted small">(low-stock alert)</span></label>
                  <input type="number" id="edit-min-quantity" class="form-control" min="0" />
                </div>
              </div>

              <h6 class="text-uppercase text-muted small fw-semibold mb-2 mt-3">Identification</h6>
              <div class="row g-3 mb-2">
                <div class="col-md-6">
                  <label class="form-label">SKU / Barcode</label>
                  <div class="input-group">
                    <input type="text" id="edit-sku" class="form-control" />
                    <button type="button" class="btn btn-outline-secondary" onclick="openUpcLookup('edit-sku','edit-name',null,null,'edit-match-badge','edit-metadata-id')" title="Look up product by barcode">
                      <i class="bi bi-search"></i>
                    </button>
                  </div>
                  <input type="hidden" id="edit-metadata-id" value="" />
                  <span id="edit-match-badge" class="badge bg-success mt-1 d-none"><i class="bi bi-check-lg me-1"></i>Product matched</span>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Location</label>
                  <input type="text" id="edit-location" class="form-control" list="edit-location-list" autocomplete="off" />
                  <datalist id="edit-location-list"></datalist>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Category</label>
                  <div class="d-flex gap-2">
                    <select id="edit-category" class="form-select"></select>
                    <button type="button" class="btn btn-outline-secondary" id="edit-new-cat-btn" title="Create new category">
                      <i class="bi bi-plus-lg"></i>
                    </button>
                  </div>
                  <div id="edit-new-cat-form" class="mt-2 border rounded p-2 d-none">
                    <div class="mb-2">
                      <label class="form-label small mb-1">Name <span class="text-danger">*</span></label>
                      <input type="text" id="edit-new-cat-name" class="form-control form-control-sm" placeholder="Category name" />
                    </div>
                    <div class="mb-2">
                      <label class="form-label small mb-1">Color <span class="text-muted small">(optional)</span></label>
                      <input type="hidden" id="edit-new-cat-color" value="" />
                      <div class="d-flex flex-wrap gap-1" id="edit-new-cat-swatches"></div>
                    </div>
                    <div class="d-flex gap-2">
                      <button type="button" class="btn btn-sm btn-primary" id="edit-new-cat-save">Create</button>
                      <button type="button" class="btn btn-sm btn-outline-secondary" id="edit-new-cat-cancel">Cancel</button>
                    </div>
                    <div id="edit-new-cat-error" class="text-danger small mt-1 d-none"></div>
                  </div>
                </div>
              </div>

              <h6 class="text-uppercase text-muted small fw-semibold mb-2 mt-3">Details</h6>
              <div class="row g-3">
                <div class="col-md-6" id="edit-expiry-col">
                  <label class="form-label">Expiry Date <span class="text-muted small">(optional)</span></label>
                  <input type="date" id="edit-expiry" class="form-control" />
                </div>
                <div class="col-12">
                  <label class="form-label">Scan Warning</label>
                  <input type="text" id="edit-scan-warning" class="form-control" placeholder="e.g. Requires PPE, Handle with care" />
                </div>
                <div class="col-12">
                  <label class="form-label">Description</label>
                  <textarea id="edit-description" class="form-control" rows="3"></textarea>
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" id="edit-save-btn" onclick="saveEditItem()">Save</button>
          </div>
        </div>
      </div>
    </div>

    <!-- UPC Product Lookup Modal -->
    <div class="modal fade" id="upcLookupModal" tabindex="-1" style="z-index: 1070">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title"><i class="bi bi-search me-2"></i>Product Lookup</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div id="upc-lookup-spinner" class="text-center py-4 d-none">
              <div class="spinner-border text-primary" role="status"></div>
              <div class="mt-2 text-muted small">Searching product databases...</div>
            </div>
            <div id="upc-lookup-empty" class="text-center py-4 text-muted d-none">
              <i class="bi bi-search fs-2 opacity-25 d-block mb-2"></i>
              No products found for this barcode.
            </div>
            <div id="upc-lookup-results"></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          </div>
        </div>
      </div>
    </div>
    <script>
    var _upcLookupConfig = null;
    var _upcResults = [];
    var _upcSourceLabels = { 'openlibrary': 'Open Library', 'upcitemdb': 'UPC Item DB', 'openfoodfacts': 'Open Food Facts' };

    function openUpcLookup(skuInputId, nameInputId, matchedInputId, sourceInputId, badgeId, metadataIdInputId) {
        var sku = (document.getElementById(skuInputId)?.value || '').trim();
        if (!sku) {
            var t = document.createElement('div');
            t.className = 'position-fixed bottom-0 end-0 p-3';
            t.style.zIndex = '9999';
            t.innerHTML = '<div class="toast show align-items-center text-bg-warning border-0"><div class="d-flex"><div class="toast-body">Please enter or scan a barcode first.</div><button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="this.closest(\'.position-fixed\').remove()"></button></div></div>';
            document.body.appendChild(t);
            setTimeout(function() { t.remove(); }, 3000);
            return;
        }
        _upcLookupConfig = { skuInputId: skuInputId, nameInputId: nameInputId, matchedInputId: matchedInputId || null, sourceInputId: sourceInputId || null, badgeId: badgeId || null, metadataIdInputId: metadataIdInputId || null };
        _upcResults = [];

        var spinner  = document.getElementById('upc-lookup-spinner');
        var empty    = document.getElementById('upc-lookup-empty');
        var resultsEl = document.getElementById('upc-lookup-results');
        spinner.classList.remove('d-none');
        empty.classList.add('d-none');
        resultsEl.innerHTML = '';

        bootstrap.Modal.getOrCreateInstance(document.getElementById('upcLookupModal')).show();

        fetch('/api/barcode-lookup?barcode=' + encodeURIComponent(sku))
            .then(function(r) { return r.json(); })
            .then(function(data) {
                spinner.classList.add('d-none');
                _upcResults = data || [];
                if (!_upcResults.length) { empty.classList.remove('d-none'); return; }
                resultsEl.innerHTML = _upcResults.map(function(r, i) {
                    var label = _upcSourceLabels[r.source] || r.source;
                    var imgHtml = r.imageUrl
                        ? '<img src="' + _upcEsc(r.imageUrl) + '" class="upc-result-img" alt="" onerror="this.style.display=\'none\'">'
                        : '<div class="upc-result-img-placeholder"><i class="bi bi-image opacity-25" style="font-size:2rem"></i></div>';
                    var desc = r.description ? r.description.substring(0, 200) + (r.description.length > 200 ? '...' : '') : '';
                    return '<div class="card mb-2"><div class="card-body d-flex gap-3 align-items-start p-3">' +
                        imgHtml +
                        '<div class="flex-grow-1 min-w-0">' +
                        '<div class="d-flex align-items-center gap-2 mb-1 flex-wrap">' +
                        '<strong>' + _upcEsc(r.name) + '</strong>' +
                        '<span class="badge bg-secondary">' + _upcEsc(label) + '</span>' +
                        '</div>' +
                        (r.brand ? '<div class="text-muted small">Brand: ' + _upcEsc(r.brand) + '</div>' : '') +
                        (r.category ? '<div class="text-muted small">Category: ' + _upcEsc(r.category) + '</div>' : '') +
                        (r.size ? '<div class="text-muted small">Size: ' + _upcEsc(r.size) + '</div>' : '') +
                        (r.weight ? '<div class="text-muted small">Weight: ' + _upcEsc(r.weight) + '</div>' : '') +
                        (desc ? '<div class="text-muted small mt-1" style="max-height:60px;overflow:hidden">' + _upcEsc(desc) + '</div>' : '') +
                        '</div>' +
                        '<button type="button" class="btn btn-sm btn-primary flex-shrink-0 align-self-center" onclick="applyUpcMatch(' + i + ')">Use This</button>' +
                        '</div></div>';
                }).join('');
            })
            .catch(function() {
                spinner.classList.add('d-none');
                resultsEl.innerHTML = '<div class="alert alert-danger">Lookup failed. Please try again.</div>';
            });
    }

    function applyUpcMatch(idx) {
        var r = _upcResults[idx];
        if (!r || !_upcLookupConfig) return;
        var c = _upcLookupConfig;

        var nameEl = document.getElementById(c.nameInputId);
        if (nameEl) nameEl.value = r.name;

        // Record the chosen product so it can be linked to the item on save,
        // and surface a confirmation badge.
        if (c.metadataIdInputId) {
            var midEl = document.getElementById(c.metadataIdInputId);
            if (midEl) midEl.value = r.id || '';
        }
        if (c.badgeId) {
            var badgeEl = document.getElementById(c.badgeId);
            if (badgeEl) badgeEl.classList.remove('d-none');
        }

        bootstrap.Modal.getInstance(document.getElementById('upcLookupModal'))?.hide();

        // If called from quick-add form lookup
        if (c.nameInputId === 'scanner-lookup-name') {
            var qaName = document.getElementById('qa-name');
            var qaMetadataId = document.getElementById('qa-metadata-id');

            if (qaName && qaName.value === '') {
                // Quick-add form is open and name is empty - populate it
                qaName.value = r.name;
                if (qaMetadataId) qaMetadataId.value = r.id || '';
            } else if (!qaName || qaName.value === '') {
                // Scanner flow - show quick-add form
                if (qaName) qaName.value = r.name;
                if (qaMetadataId) qaMetadataId.value = r.id || '';
                showQuickAddForm();
            }
        }
    }

    function _upcEsc(s) {
        if (!s) return '';
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    </script>

    <!-- Global scanner modal -->
    <div class="modal fade" id="scannerModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-scrollable" style="max-width:480px">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title fs-6"><i class="bi bi-upc-scan me-2"></i>Scan Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" onclick="closeModal()"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="btn-group btn-group-sm w-100 mb-1" role="group">
                            <input type="radio" class="btn-check" name="modal-search-type" id="modal-search-sku" value="sku" checked>
                            <label class="btn btn-outline-secondary" for="modal-search-sku"><i class="bi bi-upc me-1"></i>SKU / Barcode</label>
                            <input type="radio" class="btn-check" name="modal-search-type" id="modal-search-name" value="name">
                            <label class="btn btn-outline-secondary" for="modal-search-name"><i class="bi bi-fonts me-1"></i>Name</label>
                        </div>
                        <div class="input-group input-group-sm">
                            <input type="text" id="modal-manual-sku" class="form-control" placeholder="Type or scan…" />
                            <button class="btn btn-outline-secondary" onclick="doManualSearch()"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                    <div id="scanner-idle" class="text-center text-muted py-2 mb-2">
                        <i class="bi bi-upc-scan fs-1 d-block mb-1 opacity-25"></i>
                        <span class="small" id="scanner-idle-label">Click Start to activate camera</span>
                        <div class="mt-2">
                            <button id="scanBtn" class="btn btn-sm btn-primary" type="button">
                                <i class="bi bi-camera me-1"></i> Start Camera
                            </button>
                        </div>
                    </div>

                    <div id="scanner-active" class="d-none mb-2">
                        <div id="scanner-viewport" class="scanner-viewport">
                            <video id="scanner-video" autoplay muted playsinline></video>
                            <div class="scanner-aim"></div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <span class="text-muted small">Align barcode with the red line</span>
                            <button id="scanStopBtn" class="btn btn-sm btn-danger" type="button">
                                <i class="bi bi-stop-circle me-1"></i> Stop
                            </button>
                        </div>
                    </div>

                    <div id="scanner-processing" class="d-none text-center py-3">
                        <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                        <span class="small text-muted">Reading barcode…</span>
                    </div>

                    <div id="scanner-error" class="d-none">
                        <p class="text-danger small mb-2" id="scanner-error-msg"></p>
                    </div>

                    <input type="file" id="capture-input" accept="image/*" capture="environment" class="d-none" />

                    <div id="scanner-result" class="d-none">
                        <div class="d-flex align-items-start justify-content-between mb-2">
                            <div>
                                <div><span id="item-name" class="fw-bold"></span> <span id="item-stock-badge" class="badge d-none"></span></div>
                                <div id="item-meta" class="small text-muted"></div>
                            </div>
                            <a id="item-edit-link" href="#" class="btn btn-sm btn-outline-secondary ms-2">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </div>

                        <div id="scanner-action-alert" class="d-none alert py-2 px-3 mb-2" role="alert"></div>

                        <div id="scan-warning" class="d-none alert alert-warning py-2 px-3 mb-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            <span id="scan-warning-text"></span>
                        </div>

                        <!-- Compact 2-column layout mirroring the item view modal: image left, stats right -->
                        <div class="row g-2 mb-3 align-items-center">
                            <div id="item-image-container" class="col-auto d-none text-center">
                                <img id="item-image" src="" alt="Product image" class="rounded border" style="max-width:84px;max-height:84px;object-fit:contain;background:var(--bs-tertiary-bg)">
                                <button type="button" class="more-info-btn mt-1" style="font-size:.7rem;padding:.15rem .4rem" onclick="showMetadataInfo()"><i class="bi bi-info-circle me-1"></i>Details</button>
                            </div>
                            <div class="col">
                                <div id="item-stats"></div>
                            </div>
                        </div>

                        <div id="reusable-actions" class="d-none">
                            <div class="mb-2">
                                <label class="form-label small mb-1">Client</label>
                                <div class="position-relative">
                                    <input id="checkout-client-input" type="text" class="form-control form-control-sm"
                                           placeholder="Search by name…" oninput="onClientInput()" autocomplete="off" />
                                    <input type="hidden" id="checkout-client-id" />
                                    <div id="checkout-client-dd" class="d-none position-absolute w-100 border rounded bg-body shadow-sm"
                                         style="top:100%;z-index:1060;max-height:180px;overflow-y:auto;font-size:.875rem"></div>
                                    <div id="checkout-client-err" class="text-danger small d-none mt-1">Please enter a name.</div>
                                </div>
                            </div>
                            <div class="row g-1 mb-2">
                                <div class="col-5"><input id="action-qty" type="number" class="form-control form-control-sm" value="1" min="1" /></div>
                                <div class="col-7"><input id="action-notes" type="text" class="form-control form-control-sm" placeholder="Notes (optional)" /></div>
                            </div>
                            <div class="d-grid gap-1">
                                <button id="btn-checkout" class="btn btn-sm btn-success" onclick="doCheckout()"><i class="bi bi-box-arrow-up-right me-1"></i> Check Out</button>
                            </div>
                            <div id="active-checkouts" class="mt-3 d-none">
                                <div class="small fw-semibold mb-1">Currently Out</div>
                                <div id="checkout-list"></div>
                            </div>
                        </div>

                        <div id="consumable-actions" class="d-none">
                            <h6 class="fw-semibold mb-2">Adjust Stock</h6>
                            <div class="d-flex gap-2 align-items-center flex-wrap">
                                <div class="input-group stock-stepper" style="width:140px">
                                    <button id="btn-consume" class="btn btn-outline-danger" type="button" onclick="doConsume()" title="Consume (use stock)"><i class="bi bi-dash-lg"></i></button>
                                    <input id="consume-qty" type="number" class="form-control text-center" value="1" min="1" />
                                    <button id="btn-restock" class="btn btn-outline-success" type="button" onclick="doRestock()" title="Restock (add stock)"><i class="bi bi-plus-lg"></i></button>
                                </div>
                                <input id="consume-notes" type="text" class="form-control" style="max-width:180px" placeholder="Notes (optional)" />
                            </div>
                            <div class="form-text">Tap <span class="text-danger fw-semibold">−</span> to consume, <span class="text-success fw-semibold">+</span> to add stock.</div>
                        </div>

                        <div id="search-results-picker" class="d-none mt-2">
                            <div class="small fw-semibold mb-2 text-muted">Multiple items found — select one:</div>
                            <div id="search-results-list"></div>
                            <button class="btn btn-sm btn-outline-primary w-100 mt-1 scanner-manage-only d-none" onclick="showQuickAddForm()"><i class="bi bi-plus-lg me-1"></i> Add New Item Instead</button>
                        </div>

                        <div id="not-found" class="d-none text-center py-2">
                            <div class="text-muted small mb-2">No item found.</div>
                            <button class="btn btn-sm btn-outline-primary mt-2" onclick="showQuickAddForm()"><i class="bi bi-plus-lg me-1"></i> Add Item</button>
                        </div>
                        <div id="scanner-lookup-matched" style="display:none"></div>
                        <input type="hidden" id="scanner-lookup-name" />
                        <input type="hidden" id="scanner-lookup-source" />

                        <div id="quick-add-form" class="d-none mt-2">
                            <div class="border rounded p-2 bg-body-secondary">
                                <div class="small fw-semibold mb-2">New Item</div>
                                <div class="mb-2">
                                    <input id="qa-name" type="text" class="form-control form-control-sm" placeholder="Item name (required)" />
                                    <div id="qa-name-error" class="text-danger small d-none mt-1">Name is required.</div>
                                </div>
                                <div class="mb-2">
                                    <div class="d-flex gap-1">
                                        <input id="qa-sku" type="text" class="form-control form-control-sm" placeholder="SKU (optional)" />
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="lookupQaBarcode()" title="Lookup barcode"><i class="bi bi-search"></i></button>
                                    </div>
                                </div>
                                <input type="hidden" id="qa-metadata-source" />
                                <input type="hidden" id="qa-metadata-matched" />
                                <input type="hidden" id="qa-metadata-id" />
                                <div class="row g-1 mb-1">
                                    <div class="col-6">
                                        <select id="qa-type" class="form-select form-select-sm">
                                            <option value="1">Reusable</option>
                                            <option value="0">Consumable</option>
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <input id="qa-qty" type="number" class="form-control form-control-sm" value="1" min="1" placeholder="Qty" />
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <input id="qa-location" type="text" class="form-control form-control-sm" placeholder="Location (optional)" />
                                </div>
                                <button id="btn-quick-add" class="btn btn-sm btn-primary w-100" onclick="doQuickAdd()">
                                    <i class="bi bi-plus-lg me-1"></i> Add &amp; Continue
                                </button>
                            </div>
                        </div>

                        <button class="btn btn-sm btn-outline-secondary mt-3 w-100" onclick="resetScanner()">
                            <i class="bi bi-arrow-left me-1"></i> Scan Another Item
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Metadata Info Modal -->
    <div class="modal fade" id="metadataInfoModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content overflow-hidden">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title"><i class="bi bi-box-seam me-2 text-primary"></i>Product Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="metadata-hero text-center mb-3">
                        <i id="metadata-info-placeholder" class="bi bi-image metadata-hero-placeholder"></i>
                        <img id="metadata-info-image" src="" alt="Product image" class="metadata-hero-img" style="display:none"
                             onload="this.style.display='block';var p=document.getElementById('metadata-info-placeholder');if(p)p.style.display='none';"
                             onerror="this.style.display='none';var p=document.getElementById('metadata-info-placeholder');if(p)p.style.display='block';">
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <div class="metadata-field">
                                <div class="metadata-field-label"><i class="bi bi-tag me-1"></i>Brand</div>
                                <div class="metadata-field-value" id="metadata-info-brand"></div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="metadata-field">
                                <div class="metadata-field-label"><i class="bi bi-collection me-1"></i>Category</div>
                                <div class="metadata-field-value" id="metadata-info-category"></div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="metadata-field">
                                <div class="metadata-field-label"><i class="bi bi-card-text me-1"></i>Description</div>
                                <div class="metadata-field-value" id="metadata-info-description" style="max-height:200px;overflow-y:auto"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script>window.canManage = @(_canWrite ? "true" : "false");</script>
    <script src="https://cdn.jsdelivr.net/npm/@@zxing/library@@0.21.3/umd/index.min.js"></script>
    <script src="~/js/scanner.js"></script>
    </text>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

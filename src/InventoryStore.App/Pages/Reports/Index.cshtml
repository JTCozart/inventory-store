            <div class="col-6"><div class="card text-center p-2 p-sm-3"><div class="fs-4 fw-bold text-warning">@Model.IncompleteKits.Items.Sum(k => k.Shortfalls.Count)</div><div class="text-muted small">Items Short</div></div></div>

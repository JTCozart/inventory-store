@page
@model InventoryStore.App.Pages.Reports.IndexModel
@using InventoryStore.Domain.Enums
@{
    ViewData["Title"] = "Reports";
    ViewData["ActivePage"] = "Reports";
    var genTime   = DateTime.UtcNow;
    var tStock    = Model.Tab == "stock"     ? "active" : string.Empty;
    var tCheckout = Model.Tab == "checkout"  ? "active" : string.Empty;
    var tLost     = Model.Tab == "lost"      ? "active" : string.Empty;
    var tInventory= Model.Tab == "inventory" ? "active" : string.Empty;
    var tKits     = Model.Tab == "kits"      ? "active" : string.Empty;
    var tExpiry   = Model.Tab == "expiry"    ? "active" : string.Empty;
    var tBarcodes = Model.Tab == "barcodes"  ? "active" : string.Empty;
    var tActivity = Model.Tab == "activity"  ? "active" : string.Empty;
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <h1 class="h3 mb-0">Reports</h1>
    <div class="d-flex gap-2">
        <a href="/Reports?handler=ExportCsv" class="btn btn-sm btn-outline-success">
            <i class="bi bi-download me-1"></i> Export CSV
        </a>
        <button class="btn btn-sm btn-outline-secondary" onclick="printReport()">
            <i class="bi bi-printer me-1"></i> Print
        </button>
    </div>
</div>

<select class="form-select page-sidenav-select no-print" onchange="location.href=this.value">
    <option value="/Reports?tab=stock"     selected="@(Model.Tab=="stock")">Stock Levels</option>
    <option value="/Reports?tab=checkout"  selected="@(Model.Tab=="checkout")">Checked Out</option>
    <option value="/Reports?tab=lost"      selected="@(Model.Tab=="lost")">Lost Items</option>
    <option value="/Reports?tab=inventory" selected="@(Model.Tab=="inventory")">Take Inventory</option>
    @if (Model.KitsEnabled)
    {
        <option value="/Reports?tab=kits" selected="@(Model.Tab=="kits")">Incomplete Kits</option>
    }
    <option value="/Reports?tab=expiry"    selected="@(Model.Tab=="expiry")">Expiry</option>
    <option value="/Reports?tab=barcodes"  selected="@(Model.Tab=="barcodes")">Barcode Sheet</option>
    <option value="/Reports?tab=activity"  selected="@(Model.Tab=="activity")">Activity Log</option>
    @if (Model.CostEnabled)
    {
        <option value="/Reports?tab=valuation" selected="@(Model.Tab=="valuation")">Valuation</option>
    }
    @if (Model.ForecastEnabled)
    {
        <option value="/Reports?tab=forecast" selected="@(Model.Tab=="forecast")">Forecast</option>
    }
    @if (Model.MaintenanceEnabled)
    {
        <option value="/Reports?tab=maintenance" selected="@(Model.Tab=="maintenance")">Maintenance Due</option>
    }
</select>

<div class="page-layout">
<nav class="page-sidenav no-print">
    <a href="/Reports?tab=stock"     class="nav-link @tStock">    <i class="bi bi-bar-chart"></i> Stock Levels</a>
    <a href="/Reports?tab=checkout"  class="nav-link @tCheckout"> <i class="bi bi-box-arrow-up-right"></i> Checked Out</a>
    <a href="/Reports?tab=lost"      class="nav-link @tLost">     <i class="bi bi-x-circle"></i> Lost Items</a>
    <a href="/Reports?tab=inventory" class="nav-link @tInventory"><i class="bi bi-clipboard-check"></i> Take Inventory</a>
    @if (Model.KitsEnabled)
    {
        <a href="/Reports?tab=kits" class="nav-link @tKits"><i class="bi bi-box-seam"></i> Incomplete Kits</a>
    }
    <a href="/Reports?tab=expiry"    class="nav-link @tExpiry">   <i class="bi bi-calendar-x"></i> Expiry</a>
    <a href="/Reports?tab=barcodes"  class="nav-link @tBarcodes"> <i class="bi bi-upc"></i> Barcode Sheet</a>
    <a href="/Reports?tab=activity"  class="nav-link @tActivity"> <i class="bi bi-clock-history"></i> Activity Log</a>
    @if (Model.CostEnabled)
    {
        <a href="/Reports?tab=valuation" class="nav-link @(Model.Tab == "valuation" ? "active" : "")"><i class="bi bi-cash-coin"></i> Valuation</a>
    }
    @if (Model.ForecastEnabled)
    {
        <a href="/Reports?tab=forecast" class="nav-link @(Model.Tab == "forecast" ? "active" : "")"><i class="bi bi-graph-down-arrow"></i> Forecast</a>
    }
    @if (Model.MaintenanceEnabled)
    {
        <a href="/Reports?tab=maintenance" class="nav-link @(Model.Tab == "maintenance" ? "active" : "")"><i class="bi bi-tools"></i> Maintenance Due</a>
    }
</nav>
<div class="page-content">

@if (Model.Tab == "maintenance" && Model.MaintenanceReport is not null)
{
    var mr = Model.MaintenanceReport;
    var todayD = DateOnly.FromDateTime(DateTime.Today);
    <div class="print-title d-none">Maintenance Due Report - <utc-time value="@mr.GeneratedAt" fmt="date" /></div>
    <div class="row g-2 g-sm-3 mb-4 no-print">
        <div class="col-4"><div class="card text-center p-2 p-sm-3"><div class="fs-4 fw-bold text-danger">@mr.OverdueCount</div><div class="text-muted small">Overdue</div></div></div>
        <div class="col-4"><div class="card text-center p-2 p-sm-3"><div class="fs-4 fw-bold text-warning">@mr.DueSoonCount</div><div class="text-muted small">Due Soon</div></div></div>
        <div class="col-4"><div class="card text-center p-2 p-sm-3"><div class="fs-4 fw-bold text-info">@mr.OutCount</div><div class="text-muted small">Out for Maintenance</div></div></div>
    </div>

    @if (!mr.Items.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-tools display-4"></i>
            <p class="mt-2">No items have a maintenance schedule or are out for service.</p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th class="d-none d-lg-table-cell">SKU</th>
                            <th class="d-none d-md-table-cell">Location</th>
                            <th class="d-none d-md-table-cell">Last Maintained</th>
                            <th>Next Due</th>
                            <th>Status</th>
                            <th class="d-none d-lg-table-cell">Vendor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in mr.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@row.Name</td>
                                <td class="text-muted small d-none d-lg-table-cell">@(row.SKU ?? "-")</td>
                                <td class="text-muted small d-none d-md-table-cell">@(row.Location ?? "-")</td>
                                <td class="text-muted small d-none d-md-table-cell">@(row.LastMaintainedDate?.ToString("MMM d, yyyy") ?? "Never")</td>
                                <td class="small">@(row.NextDueDate?.ToString("MMM d, yyyy") ?? "Not scheduled")</td>
                                <td>
                                    @if (row.IsOut)
                                    {
                                        <span class="badge bg-info text-dark">Out for maintenance</span>
                                    }
                                    else if (row.IsOverdue)
                                    {
                                        <span class="badge bg-danger">Overdue</span>
                                    }
                                    else if (row.IsDueSoon)
                                    {
                                        <span class="badge bg-warning text-dark">Due soon</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">OK</span>
                                    }
                                </td>
                                <td class="text-muted small d-none d-lg-table-cell">@(row.VendorName ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="text-muted small mt-2">@mr.Items.Count item@(mr.Items.Count == 1 ? "" : "s")</div>
    }
}

@if (Model.Tab == "stock" && Model.StockReport is not null)
{
    <div class="print-title d-none">Stock Levels Report - <utc-time value="@Model.StockReport.GeneratedAt" fmt="date" /></div>
    <div class="row g-2 g-sm-3 mb-4 no-print">
        <div class="col-4"><div class="card text-center p-2 p-sm-3"><div class="fs-4 fs-sm-1 fw-bold text-primary">@Model.StockReport.TotalItems</div><div class="text-muted small">Total Items</div></div></div>
        <div class="col-4"><div class="card text-center p-2 p-sm-3"><div class="fs-4 fw-bold text-success">@Model.StockReport.TotalQuantity</div><div class="text-muted small">In Stock</div></div></div>
        <div class="col-4"><div class="card text-center p-2 p-sm-3"><div class="fs-4 fw-bold text-warning">@Model.StockReport.LowStockCount</div><div class="text-muted small">Low Stock</div></div></div>
    </div>

    <div class="row g-2 mb-3 no-print">
        <div class="col-12 col-sm-auto flex-sm-grow-1">
            <input type="search" id="f-stock-q" class="form-control form-control-sm w-100"
                   placeholder="Search name, SKU, location...">
        </div>
        <div class="col-6 col-sm-auto">
            <select id="f-stock-type" class="form-select form-select-sm w-100">
                <option value="">All Types</option>
                <option value="Reusable">Reusable</option>
                <option value="Consumable">Consumable</option>
            </select>
        </div>
        <div class="col-6 col-sm-auto d-flex align-items-center">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="f-stock-low">
                <label class="form-check-label small" for="f-stock-low">Low Stock Only</label>
            </div>
        </div>
        <div class="col-12 col-sm-auto ms-sm-auto">
            <span class="text-muted small" id="f-stock-count"></span>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-sm mb-0" id="stock-table">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th class="d-none d-md-table-cell">Type</th>
                        <th class="d-none d-lg-table-cell">SKU</th>
                        <th class="d-none d-md-table-cell">Location</th>
                        <th class="text-end d-none d-lg-table-cell">Qty</th>
                        <th class="text-end">Available</th>
                        <th class="text-end d-none d-lg-table-cell">Out</th>
                        <th class="text-end d-none d-lg-table-cell">Lost</th>
                        <th class="d-none d-md-table-cell">Expiry</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="stock-tbody">
                    @foreach (var item in Model.StockReport.AllItems)
                    {
                        <tr class="@(item.IsLowStock ? "table-warning" : string.Empty)"
                            data-type="@item.ItemType"
                            data-low="@item.IsLowStock.ToString().ToLower()"
                            data-search="@item.Name @(item.SKU ?? "") @(item.Location ?? "")">
                            <td class="fw-semibold">@item.Name</td>
                            <td class="d-none d-md-table-cell"><span class="badge @(item.ItemType == ItemType.Reusable ? "bg-info" : "bg-secondary")">@item.ItemType</span></td>
                            <td class="text-muted small d-none d-lg-table-cell">@(item.SKU ?? "-")</td>
                            <td class="text-muted small d-none d-md-table-cell">@(item.Location ?? "-")</td>
                            <td class="text-end d-none d-lg-table-cell">@item.Quantity</td>
                            <td class="text-end fw-semibold @(item.IsLowStock ? "text-danger" : "text-success")">@item.AvailableQuantity</td>
                            <td class="text-end text-warning d-none d-lg-table-cell">@(item.CheckedOutCount > 0 ? item.CheckedOutCount.ToString() : "-")</td>
                            <td class="text-end text-danger d-none d-lg-table-cell">@(item.LostCount > 0 ? item.LostCount.ToString() : "-")</td>
                            <td class="small text-nowrap d-none d-md-table-cell">
                                @{
                                    var rToday = DateOnly.FromDateTime(DateTime.Today);
                                    if (item.ExpiryDate.HasValue)
                                    {
                                        var rDays = item.ExpiryDate.Value.DayNumber - rToday.DayNumber;
                                        if (rDays < 0) { <span class="badge bg-danger">Expired</span> }
                                        else if (rDays <= 30) { <span class="badge bg-warning text-dark">@item.ExpiryDate.Value.ToString("MMM d")</span> }
                                        else { <text>@item.ExpiryDate.Value.ToString("MMM d, yyyy")</text> }
                                    }
                                    else { <span class="text-muted">-</span> }
                                }
                            </td>
                            <td><span class="@(item.IsLowStock ? "badge bg-warning text-dark" : "badge bg-success")">@(item.IsLowStock ? "Low Stock" : "OK")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex align-items-center justify-content-between px-3 py-2 border-top small text-muted no-print" id="stock-pg-bar">
            <span id="stock-pg-range"></span>
            <div class="d-flex align-items-center gap-1">
                <select class="form-select form-select-sm py-0" style="width:auto" onchange="pgSz('stock-pg',this.value)">
                    <option value="5">5 / page</option>
                    <option value="10">10 / page</option>
                    <option value="50" selected>50 / page</option>
                    <option value="100">100 / page</option>
                </select>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" id="stock-pg-prev" onclick="pgGo('stock-pg',-1)">&#8249;</button>
                <span class="px-1" id="stock-pg-lbl"></span>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" id="stock-pg-next" onclick="pgGo('stock-pg',1)">&#8250;</button>
            </div>
        </div>
    </div>
}

@if (Model.Tab == "checkout" && Model.CheckedOut is not null)
{
    <div class="print-title d-none">Checked Out Items - <utc-time value="@Model.CheckedOut.GeneratedAt" fmt="date" /></div>
    <div class="alert @(Model.CheckedOut.TotalCheckedOut == 0 ? "alert-success" : "alert-warning") mb-4">
        @if (Model.CheckedOut.TotalCheckedOut == 0)
        {
            <text><i class="bi bi-check-circle me-1"></i> <strong>All clear</strong>: no items currently checked out.</text>
        }
        else
        {
            <text><i class="bi bi-exclamation-triangle me-1"></i> <strong>@Model.CheckedOut.TotalCheckedOut items</strong> currently checked out across @Model.CheckedOut.Items.Count() records.</text>
        }
    </div>
    @if (Model.CheckedOut.Items.Any())
    {
        <div class="row g-2 mb-3 no-print">
            <div class="col-12 col-sm-auto flex-sm-grow-1">
                <input type="search" id="f-co-q" class="form-control form-control-sm w-100"
                       placeholder="Search item or person...">
            </div>
            <div class="col-6 col-sm-auto d-flex align-items-center">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="f-co-overdue">
                    <label class="form-check-label small" for="f-co-overdue">Overdue Only (&gt;7 days)</label>
                </div>
            </div>
            <div class="col-6 col-sm-auto ms-sm-auto">
                <span class="text-muted small" id="f-co-count"></span>
            </div>
        </div>
        <div class="card">
            <div class="table-responsive">
                <table class="table table-sm mb-0" id="checkout-table">
                    <thead class="table-light">
                        <tr>
                            <th>Item</th>
                            <th class="d-none d-md-table-cell">Location</th>
                            <th class="d-none d-lg-table-cell">SKU</th>
                            <th>Checked Out By</th>
                            <th class="d-none d-md-table-cell">Client</th>
                            <th class="text-end d-none d-sm-table-cell">Qty</th>
                            <th class="d-none d-md-table-cell">Date Out</th>
                            <th class="text-end">Days Out</th>
                        </tr>
                    </thead>
                    <tbody id="rco-tbody">
                        @foreach (var row in Model.CheckedOut.Items)
                        {
                            <tr class="@(row.DaysOut > 7 ? "table-warning" : string.Empty)"
                                data-overdue="@((row.DaysOut > 7).ToString().ToLower())"
                                data-search="@row.ItemName @row.CheckedOutBy @(row.ClientName ?? "") @(row.ItemLocation ?? "") @(row.SKU ?? "")">
                                <td class="fw-semibold">@row.ItemName</td>
                                <td class="text-muted small d-none d-md-table-cell">@(row.ItemLocation ?? "-")</td>
                                <td class="text-muted small d-none d-lg-table-cell">@(row.SKU ?? "-")</td>
                                <td>@row.CheckedOutBy</td>
                                <td class="text-muted small d-none d-md-table-cell">@(row.ClientName ?? "—")</td>
                                <td class="text-end d-none d-sm-table-cell">@row.Quantity</td>
                                <td class="small d-none d-md-table-cell"><utc-time value="@row.CheckedOutAt" fmt="date" /></td>
                                <td class="@(row.DaysOut > 7 ? "text-end text-warning fw-bold" : "text-end")">@row.DaysOut</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-top small text-muted no-print" id="rco-pg-bar">
                <span id="rco-pg-range"></span>
                <div class="d-flex align-items-center gap-1">
                    <select class="form-select form-select-sm py-0" style="width:auto" onchange="pgSz('rco-pg',this.value)">
                        <option value="5">5 / page</option>
                        <option value="10">10 / page</option>
                        <option value="50" selected>50 / page</option>
                        <option value="100">100 / page</option>
                    </select>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" id="rco-pg-prev" onclick="pgGo('rco-pg',-1)">&#8249;</button>
                    <span class="px-1" id="rco-pg-lbl"></span>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" id="rco-pg-next" onclick="pgGo('rco-pg',1)">&#8250;</button>
                </div>
            </div>
        </div>
    }
}

@if (Model.Tab == "lost" && Model.LostItems is not null)
{
    <div class="print-title d-none">Lost Items Report - <utc-time value="@Model.LostItems.GeneratedAt" fmt="date" /></div>
    <div class="alert @(Model.LostItems.TotalLost == 0 ? "alert-success" : "alert-danger") mb-4">
        @if (Model.LostItems.TotalLost == 0)
        {
            <text><i class="bi bi-check-circle me-1"></i> <strong>No lost items recorded.</strong></text>
        }
        else
        {
            <text><i class="bi bi-x-circle me-1"></i> <strong>@Model.LostItems.TotalLost items</strong> marked as lost.</text>
        }
    </div>
    @if (Model.LostItems.Items.Any())
    {
        <div class="row g-2 mb-3 no-print">
            <div class="col-12 col-sm-auto flex-sm-grow-1">
                <input type="search" id="f-lost-q" class="form-control form-control-sm w-100"
                       placeholder="Search item or person...">
            </div>
            <div class="col-12 col-sm-auto ms-sm-auto">
                <span class="text-muted small" id="f-lost-count"></span>
            </div>
        </div>
        <div class="card">
            <div class="table-responsive">
                <table class="table table-sm mb-0" id="lost-table">
                    <thead class="table-light">
                        <tr><th>Item</th><th>Location</th><th>Last With</th><th class="d-none d-md-table-cell">Client</th><th class="text-end">Qty</th><th>Date Lost</th></tr>
                    </thead>
                    <tbody id="rlost-tbody">
                        @foreach (var row in Model.LostItems.Items)
                        {
                            <tr data-search="@row.ItemName @row.LastCheckedOutBy @(row.ClientName ?? "") @(row.ItemLocation ?? "")">
                                <td class="fw-semibold">@row.ItemName</td>
                                <td class="text-muted small">@(row.ItemLocation ?? "-")</td>
                                <td>@row.LastCheckedOutBy</td>
                                <td class="text-muted small d-none d-md-table-cell">@(row.ClientName ?? "—")</td>
                                <td class="text-end text-danger fw-bold">@row.Quantity</td>
                                <td class="small"><utc-time value="@row.LostAt" fmt="date" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-top small text-muted no-print" id="rlost-pg-bar">
                <span id="rlost-pg-range"></span>
                <div class="d-flex align-items-center gap-1">
                    <select class="form-select form-select-sm py-0" style="width:auto" onchange="pgSz('rlost-pg',this.value)">
                        <option value="5">5 / page</option>
                        <option value="10">10 / page</option>
                        <option value="50" selected>50 / page</option>
                        <option value="100">100 / page</option>
                    </select>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" id="rlost-pg-prev" onclick="pgGo('rlost-pg',-1)">&#8249;</button>
                    <span class="px-1" id="rlost-pg-lbl"></span>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" id="rlost-pg-next" onclick="pgGo('rlost-pg',1)">&#8250;</button>
                </div>
            </div>
        </div>
    }
}

@if (Model.Tab == "inventory" && Model.TakeInventory is not null)
{
    var invLocations = Model.TakeInventory.Items
        .Select(i => i.Location).Where(l => !string.IsNullOrEmpty(l))
        .Distinct().OrderBy(l => l).ToList();

    <div class="print-title">Take Inventory - <utc-time value="@Model.TakeInventory.GeneratedAt" fmt="datetime" /></div>
    <p class="text-muted small no-print">Print this page and walk the warehouse to confirm quantities.</p>

    <div class="row g-2 mb-3 no-print">
        <div class="col-12 col-sm-auto flex-sm-grow-1">
            <input type="search" id="f-inv-q" class="form-control form-control-sm w-100"
                   placeholder="Search name or SKU...">
        </div>
        <div class="col-6 col-sm-auto">
            <select id="f-inv-type" class="form-select form-select-sm w-100">
                <option value="">All Types</option>
                <option value="Reusable">Reusable</option>
                <option value="Consumable">Consumable</option>
            </select>
        </div>
        @if (invLocations.Any())
        {
            <div class="col-6 col-sm-auto">
                <select id="f-inv-location" class="form-select form-select-sm w-100">
                    <option value="">All Locations</option>
                    @foreach (var loc in invLocations)
                    {
                        <option value="@loc">@loc</option>
                    }
                </select>
            </div>
        }
        <div class="col-12 col-sm-auto ms-sm-auto">
            <span class="text-muted small" id="f-inv-count"></span>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-sm mb-0 take-inventory-table" id="inventory-table">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th class="d-none d-md-table-cell">SKU</th>
                        <th class="d-none d-md-table-cell">Location</th>
                        <th class="d-none d-md-table-cell">Type</th>
                        <th class="text-end d-none d-sm-table-cell">Expected</th>
                        <th class="text-end">Available</th>
                        <th class="text-end d-none d-lg-table-cell">Out</th>
                        <th class="text-end d-none d-lg-table-cell">Lost</th>
                        <th class="d-none d-print-table-cell" style="width:120px">Actual Count</th>
                        <th class="d-none d-print-table-cell" style="width:160px">Notes</th>
                    </tr>
                </thead>
                <tbody id="rinv-tbody">
                    @foreach (var row in Model.TakeInventory.Items)
                    {
                        <tr data-type="@row.ItemType"

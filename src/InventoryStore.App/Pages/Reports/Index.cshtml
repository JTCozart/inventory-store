@section Scripts {
<script>
function printReport() {
    if (typeof pgPrintAll === 'function') pgPrintAll();
    window.addEventListener('afterprint', function _restore() {
        window.removeEventListener('afterprint', _restore);
        if (typeof pgRestoreAll === 'function') pgRestoreAll();
    });
    window.print();
}
</script>
@if (Model.Tab == "valuation" && Model.CostEnabled)
{
<script>
function modEsc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function money(cur,n){ if(n==null||isNaN(n)) return '-'; return cur + Number(n).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); }
(async function(){
    var err=document.getElementById('val-error'), empty=document.getElementById('val-empty');
    var sum=document.getElementById('val-summary'), tbody=document.getElementById('val-tbody');
    try {
        var res=await fetch('/api/cost/valuation'); if(!res.ok) throw new Error();
        var d=await res.json(); var cur=d.currency||'$';
        sum.innerHTML='<div class="col-auto"><div class="text-muted small">Total value</div><div class="fs-5 fw-semibold">'+money(cur,d.totalValue)+'</div></div>'+
            '<div class="col-auto"><div class="text-muted small">Book value</div><div class="fs-5 fw-semibold">'+money(cur,d.totalBookValue)+'</div></div>'+
            '<div class="col-auto"><div class="text-muted small">Items costed</div><div class="fs-5 fw-semibold">'+d.itemsCosted+'</div></div>';
        if(!d.items.length){ empty.classList.remove('d-none'); return; }
        tbody.innerHTML=d.items.map(function(r){return '<tr><td>'+modEsc(r.name)+'</td><td>'+modEsc(r.category)+'</td><td class="text-end">'+r.quantity+'</td><td class="text-end">'+money(cur,r.unitCost)+'</td><td class="text-end">'+money(cur,r.lineValue)+'</td><td class="text-end">'+money(cur,r.bookValue)+'</td></tr>';}).join('');
    } catch { err.textContent='Could not load valuation.'; err.classList.remove('d-none'); }
})();
</script>
}
@if (Model.Tab == "forecast" && Model.ForecastEnabled)
{
<script>
function fcEsc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
(async function(){
    var err=document.getElementById('fc-error'), empty=document.getElementById('fc-empty'), tbody=document.getElementById('fc-tbody');
    try {
        var res=await fetch('/api/forecast'); if(!res.ok) throw new Error();
        var rows=await res.json();
        if(!rows.length){ empty.classList.remove('d-none'); return; }
        tbody.innerHTML=rows.map(function(r){
            var days=r.daysRemaining==null?'∞':Math.round(r.daysRemaining);
            var runout=r.runOutDate?new Date(r.runOutDate).toLocaleDateString():'<span class="text-muted">—</span>';
            var cls=(r.daysRemaining!=null&&r.daysRemaining<=14)?' class="text-danger fw-semibold"':'';
            return '<tr'+cls+'><td>'+fcEsc(r.name)+'</td><td class="text-end">'+r.quantity+'</td><td class="text-end">'+r.avgDailyUse.toFixed(2)+'</td><td class="text-end">'+days+'</td><td>'+runout+'</td></tr>';
        }).join('');
    } catch { err.textContent='Could not load forecast.'; err.classList.remove('d-none'); }
})();
</script>
}
<script>
(function () {
    function debounce(fn, ms) {
        var t;
        return function () { clearTimeout(t); t = setTimeout(fn, ms); };
    }

    var _tab = (new URLSearchParams(window.location.search).get('tab') || 'stock');
    var _storeKey = 'report-filters-' + _tab;

    function saveFilters() {
        try {
            var s = {};
            ['f-stock-q','f-co-q','f-lost-q','f-inv-q','f-bc-q','f-act-q'].forEach(function(id) {
                var el = document.getElementById(id); if (el) s[id] = el.value;
            });
            ['f-stock-type','f-inv-type','f-inv-location','f-bc-location','f-act-action'].forEach(function(id) {
                var el = document.getElementById(id); if (el) s[id] = el.value;
            });
            ['f-stock-low','f-co-overdue'].forEach(function(id) {
                var el = document.getElementById(id); if (el) s[id] = el.checked;
            });
            sessionStorage.setItem(_storeKey, JSON.stringify(s));
        } catch {}
    }

    function restoreFilters() {
        try {
            var saved = sessionStorage.getItem(_storeKey);
            if (!saved) return;
            var s = JSON.parse(saved);
            Object.keys(s).forEach(function(id) {
                var el = document.getElementById(id);
                if (!el) return;
                if (typeof s[id] === 'boolean') el.checked = s[id];
                else el.value = s[id];
            });
        } catch {}
    }

    // Init pagers before filters so pgFilter finds them when filters apply on load.
    [['stock-pg','stock-tbody'],['rco-pg','rco-tbody'],['rlost-pg','rlost-tbody'],
     ['rinv-pg','rinv-tbody'],['rexp-pg','rexp-tbody'],['rexpiring-pg','rexpiring-tbody'],
     ['ract-pg','ract-tbody']].forEach(function(pair){
        if(document.getElementById(pair[1])) pgInit(pair[0],pair[1],50);
    });

    restoreFilters();

    // Map table element IDs → their pager IDs
    var _tablePagerIds = {
        'stock-table':    'stock-pg',
        'checkout-table': 'rco-pg',
        'lost-table':     'rlost-pg',
        'inventory-table':'rinv-pg',
        'activity-table': 'ract-pg'
    };

    function filterTable(tableId, countId, getFilters) {
        var pgId = _tablePagerIds[tableId];
        var hasPager = pgId && typeof window.pgFilter === 'function' && document.getElementById(pgId + '-bar');
        var rows = document.querySelectorAll('#' + tableId + ' tbody tr');
        var visible = 0;
        if (hasPager) {
            window.pgFilter(pgId, getFilters);
            visible = Array.from(rows).filter(getFilters).length;
        } else {
            rows.forEach(function (row) {
                var show = getFilters(row);
                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });
        }
        var countEl = document.getElementById(countId);
        if (countEl) {
            countEl.textContent = visible === rows.length
                ? rows.length + ' items'
                : visible + ' of ' + rows.length + ' items';
        }
    }

    function matches(row, q) {
        if (!q) return true;
        return (row.dataset.search || row.textContent).toLowerCase().includes(q);
    }

    // ---- Stock ----
    var stockQ    = document.getElementById('f-stock-q');
    var stockType = document.getElementById('f-stock-type');
    var stockLow  = document.getElementById('f-stock-low');
    if (stockQ || stockType || stockLow) {
        function applyStock() {
            var q   = (stockQ?.value || '').toLowerCase().trim();
            var typ = (stockType?.value || '').toLowerCase();
            var low = stockLow?.checked || false;
            filterTable('stock-table', 'f-stock-count', function (row) {
                return matches(row, q)
                    && (!typ || (row.dataset.type || '').toLowerCase() === typ)
                    && (!low || row.dataset.low === 'true');
            });
        }
        function applyStockAndSave() { applyStock(); saveFilters(); }
        stockQ?.addEventListener('input', debounce(applyStockAndSave, 150));
        stockType?.addEventListener('change', applyStockAndSave);
        stockLow?.addEventListener('change', applyStockAndSave);
        applyStock();
    }

    // ---- Checkout ----
    var coQ       = document.getElementById('f-co-q');
    var coOverdue = document.getElementById('f-co-overdue');
    if (coQ || coOverdue) {
        function applyCheckout() {
            var q   = (coQ?.value || '').toLowerCase().trim();
            var ov  = coOverdue?.checked || false;
            filterTable('checkout-table', 'f-co-count', function (row) {
                return matches(row, q)
                    && (!ov || row.dataset.overdue === 'true');
            });
        }
        function applyCheckoutAndSave() { applyCheckout(); saveFilters(); }
        coQ?.addEventListener('input', debounce(applyCheckoutAndSave, 150));
        coOverdue?.addEventListener('change', applyCheckoutAndSave);
        applyCheckout();
    }

    // ---- Lost ----
    var lostQ = document.getElementById('f-lost-q');
    if (lostQ) {
        function applyLost() {
            var q = lostQ.value.toLowerCase().trim();
            filterTable('lost-table', 'f-lost-count', function (row) { return matches(row, q); });
        }
        lostQ.addEventListener('input', debounce(function() { applyLost(); saveFilters(); }, 150));
        applyLost();
    }

    // ---- Inventory (Take) ----
    var invQ    = document.getElementById('f-inv-q');
    var invType = document.getElementById('f-inv-type');
    var invLoc  = document.getElementById('f-inv-location');
    if (invQ || invType || invLoc) {
        function applyInventory() {
            var q   = (invQ?.value || '').toLowerCase().trim();
            var typ = (invType?.value || '').toLowerCase();
            var loc = invLoc?.value || '';
            filterTable('inventory-table', 'f-inv-count', function (row) {
                return matches(row, q)
                    && (!typ || (row.dataset.type || '').toLowerCase() === typ)
                    && (!loc || row.dataset.location === loc);
            });
        }
        function applyInventoryAndSave() { applyInventory(); saveFilters(); }
        invQ?.addEventListener('input', debounce(applyInventoryAndSave, 150));
        invType?.addEventListener('change', applyInventoryAndSave);
        invLoc?.addEventListener('change', applyInventoryAndSave);
        applyInventory();
    }

    // ---- Barcodes ----
    var bcQ   = document.getElementById('f-bc-q');
    var bcLoc = document.getElementById('f-bc-location');
    if (bcQ || bcLoc) {
        function applyBarcodes() {
            var q   = (bcQ?.value || '').toLowerCase().trim();
            var loc = bcLoc?.value || '';
            var cards = document.querySelectorAll('#barcode-grid .barcode-card');
            var visible = 0;
            cards.forEach(function (card) {
                var name = (card.dataset.name || '').toLowerCase();
                var sku  = (card.dataset.skuVal || '').toLowerCase();
                var show = (!q || name.includes(q) || sku.includes(q))
                        && (!loc || card.dataset.location === loc);
                card.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            var countEl = document.getElementById('f-bc-count');
            if (countEl) countEl.textContent = visible + ' of ' + cards.length + ' items';
        }
        bcQ?.addEventListener('input', debounce(function() { applyBarcodes(); saveFilters(); }, 150));
        bcLoc?.addEventListener('change', function() { applyBarcodes(); saveFilters(); });
        applyBarcodes();
    }

    // ---- Activity ----
    var actQ      = document.getElementById('f-act-q');
    var actAction = document.getElementById('f-act-action');
    if (actQ || actAction) {
        function applyActivity() {
            var q   = (actQ?.value || '').toLowerCase().trim();
            var act = actAction?.value || '';
            filterTable('activity-table', 'f-act-count', function (row) {
                return matches(row, q)
                    && (!act || row.dataset.action === act);
            });
        }
        function applyActivityAndSave() { applyActivity(); saveFilters(); }
        actQ?.addEventListener('input', debounce(applyActivityAndSave, 150));
        actAction?.addEventListener('change', applyActivityAndSave);
        applyActivity();
    }

})();
</script>
}

</div>
</div>

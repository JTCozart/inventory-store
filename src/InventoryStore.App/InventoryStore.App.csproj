<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Linux builds (RID linux-*) run headless under systemd; Windows builds host
         the WinForms tray companion. Plain `dotnet build`/`dotnet run` with no RID
         defaults to the Windows configuration. -->
    <IsLinuxBuild Condition="$(RuntimeIdentifier.StartsWith('linux'))">true</IsLinuxBuild>

    <TargetFramework Condition="'$(IsLinuxBuild)' == 'true'">net9.0</TargetFramework>
    <TargetFramework Condition="'$(IsLinuxBuild)' != 'true'">net9.0-windows</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <UseWindowsForms Condition="'$(IsLinuxBuild)' != 'true'">true</UseWindowsForms>
    <OutputType Condition="'$(IsLinuxBuild)' == 'true'">Exe</OutputType>
    <OutputType Condition="'$(IsLinuxBuild)' != 'true'">WinExe</OutputType>
    <DefineConstants Condition="'$(IsLinuxBuild)' == 'true'">$(DefineConstants);LINUX</DefineConstants>

    <RootNamespace>InventoryStore.App</RootNamespace>
    <AssemblyName>InventoryStore.App</AssemblyName>
    <ApplicationIcon Condition="Exists('..\..\assets\icon.ico')">..\..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The tray companion is WinForms-based; exclude it from the Linux build. -->
  <ItemGroup Condition="'$(IsLinuxBuild)' == 'true'">
    <Compile Remove="Tray\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsLinuxBuild)' == 'true'">
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsLinuxBuild)' != 'true'">
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.9" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LettuceEncrypt" Version="1.3.2" />
    <PackageReference Include="log4net" Version="3.3.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="log4net.config" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventoryStore.Infrastructure\InventoryStore.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Ships the user guide inside the app itself (embedded, not fetched over the network) so
       the AI assistant's help lookup works offline and always matches the installed version. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\user-guide.html" LogicalName="InventoryStore.App.Ai.user-guide.html" />
  </ItemGroup>

</Project>
